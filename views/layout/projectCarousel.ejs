<div class="dashboard-card project-section mb-4">

    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

            <div>

                <h4 class="fw-bold mb-1">

                    <i class="bi bi-folder2-open text-primary me-2"></i>

                    My Projects

                </h4>

                <p class="text-muted mb-0">

                    Manage and track your active projects

                </p>

            </div>

            <div class="d-flex gap-2">

              

                        <a href="/projects" class="btn btn-outline-secondary rounded-pill">
                            View All
                        </a>

            </div>

        </div>

        <!-- Carousel -->

        <div class="position-relative">

            <div id="projectsScroll" class="d-flex gap-4 overflow-auto flex-nowrap project-scroll px-5">

                <% if(projects.length===0){ %>

                    <div class="text-center text-muted w-100 py-5">

                        <i class="bi bi-folder-x display-5 d-block mb-3"></i>

                        No projects yet.

                    </div>

                    <% } else { %>

                        <% projects.forEach((project,index)=>{ %>

                            <a href="/projects/<%= project.project_id %>" class="text-decoration-none">

                                <div class="project-card
                            <%= index % 3 === 0
                                ? 'purple-gradient'
                                : index % 3 === 1
                                ? 'teal-gradient'
                                : 'orange-gradient' %>">

                                    <!-- Action Buttons -->

                                    

                                            <div class="card-body">

                                                <!-- Title -->

                                                <div class="mb-3">

                                                    <h5 class="fw-bold mb-2 text-white">

                                                        <%= project.project_name %>

                                                    </h5>

                                                    <p class="small text-white-50 mb-0">

                                                        <%= project.description || "No description available." %>

                                                    </p>

                                                </div>

                                                <!-- Progress -->

                                                <div class="mb-2 d-flex justify-content-between text-white-50">

                                                    <small>Progress</small>

                                                    <small>

                                                        <%= project.progress %>%

                                                    </small>

                                                </div>

                                                <div class="progress project-progress mb-4">

                                                    <div class="progress-bar
                                        <%= project.progress < 30
                                            ? 'bg-danger'
                                            : project.progress < 70
                                            ? 'bg-warning'
                                            : 'bg-success' %>" style="width:<%= project.progress %>%">

                                                    </div>

                                                </div>

                                                <!-- Footer -->

                                                <div class="project-footer">

                                                    <div class="d-flex justify-content-between mb-2">

                                                        <span class="badge rounded-pill
                                            <%= project.status === 'Completed'
                                                ? 'bg-success'
                                                : project.status === 'In Progress'
                                                ? 'bg-primary'
                                                : project.status === 'On Hold'
                                                ? 'bg-warning text-dark'
                                                : project.status === 'Archived'
                                                ? 'bg-dark'
                                                : 'bg-light text-dark' %>">

                                                            <%= project.status %>

                                                        </span>

                                                        <small class="text-white-50">

                                                            <i class="bi bi-calendar-event"></i>

                                                            <%= project.deadline ? new
                                                                Date(project.deadline).toLocaleDateString()
                                                                : "No Deadline" %>

                                                        </small>

                                                    </div>

                                                    <small class="text-white-50">

                                                        <i class="bi bi-person-circle"></i>

                                                        <%= project.full_name %>

                                                    </small>

                                                </div>

                                            </div>

                                </div>

                            </a>

                            

                                <% }) %>

                                    <% } %>

            </div>

            <!-- Left -->

            <button class="project-scroll-btn project-scroll-left" id="scrollLeft">

                <i class="bi bi-chevron-left"></i>

            </button>

            <!-- Right -->

            <button class="project-scroll-btn project-scroll-right" id="scrollRight">

                <i class="bi bi-chevron-right"></i>

            </button>

        </div>

    </div>

</div>