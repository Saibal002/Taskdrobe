<div class="admin-glass-panel p-4 d-flex flex-column h-100">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0 text-primary">
            <i class="bi bi-calendar-event me-2"></i>Upcoming Meetings
        </h6>
        <a href="/meetings" class="text-decoration-none small fw-semibold">View schedule <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    
    <div class="flex-grow-1 d-flex flex-column gap-2 mt-1 justify-content-center">
        <% if (typeof workspaceMeetings !== 'undefined' && workspaceMeetings && workspaceMeetings.length > 0) { %>
            <% workspaceMeetings.slice(0, 3).forEach(meeting => { 
                const start = new Date(meeting.start_time);
                const end = new Date(meeting.end_time);
            %>
                <div class="p-3 rounded-3 border d-flex flex-wrap align-items-center justify-content-between gap-3" style="background: rgba(0,0,0,0.015);">
                    
                    <!-- Left: Date & Title -->
                    <div class="d-flex align-items-center gap-3" style="min-width: 200px;">
                        <div class="text-center px-2 border-end" style="min-width: 65px;">
                            <div class="fw-bold text-primary small"><%= start.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div>
                            <div class="small fw-semibold" style="font-size: 0.75rem;"><%= start.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                        </div>
                        <div class="overflow-hidden">
                            <strong class="d-block small text-truncate"><%= meeting.title %></strong>
                            <span class="text-secondary small text-truncate d-block" style="font-size: 0.75rem;">
                                <i class="bi bi-person me-1"></i>By <%= meeting.organizer_name %>
                            </span>
                        </div>
                    </div>

                    <!-- Middle (Fills the red line): Description / Agenda -->
                    <div class="flex-grow-1 d-none d-md-block px-3 border-start border-end text-secondary small text-truncate" style="max-width: 380px;">
                        <span class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Agenda</span>
                        <span class="text-truncate d-block"><%= meeting.description || 'General team sync & updates' %></span>
                    </div>

                    <!-- Right: Team Badge, Time Slot & Action -->
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <% if (meeting.team_name) { %>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                <i class="fas fa-users me-1"></i><%= meeting.team_name %>
                            </span>
                        <% } %>

                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 d-none d-xl-inline-block">
                            <i class="bi bi-clock me-1"></i><%= start.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %> - <%= end.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                        </span>

                        <% if (meeting.meeting_link) { %>
                            <a href="<%= meeting.meeting_link %>" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 shadow-none" title="Join Call">
                                <i class="fas fa-video me-1"></i>Join
                            </a>
                        <% } else { %>
                            <a href="/meetings" class="btn btn-sm btn-outline-primary border rounded-pill px-3 shadow-none text-secondary">
                                Details
                            </a>
                        <% } %>
                    </div>

                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center text-muted small py-3 my-auto d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-calendar-check fs-3 d-block mb-2 opacity-25"></i>
                No upcoming meetings.
            </div>
        <% } %>
    </div>
</div>