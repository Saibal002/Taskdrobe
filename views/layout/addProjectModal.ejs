<!-- views/layout/addProjectModal.ejs -->
<div class="modal fade" id="addProjectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content rounded-3 shadow">
      <div class="modal-header">
        <h5 class="modal-title">Add New Project</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <form action="/projects" method="POST">
        <div class="modal-body">
          <!-- Project Name -->
          <div class="mb-3">
            <label class="form-label">Project Name</label>
            <input type="text" class="form-control" name="projectName" required>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" name="description" rows="3"></textarea>
          </div>

          <!-- Deadline -->
          <div class="mb-3">
            <label class="form-label">Deadline</label>
            <input type="date" class="form-control" name="deadline">
          </div>

          <!-- Status -->
          <div class="mb-3">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
              <option value="Not Started" selected>Not Started</option>
              <option value="In Progress">In Progress</option>
              <option value="Completed">Completed</option>
              <option value="On Hold">On Hold</option>
            </select>
          </div>

          <!-- Progress -->
          <div class="mb-3">
            <label class="form-label">Progress (%)</label>
            <input type="number" class="form-control" name="progress" min="0" max="100" value="0">
          </div>

          <!-- Assign Team Members (AJAX Loaded) -->
          <div class="mb-3">
            <label class="form-label">Assign Team Members</label>
            <select class="form-select manager-subordinate-select" name="employees[]" multiple>
                <!-- Loaded via AJAX -->
            </select>
            <div class="form-text">Hold CTRL (or CMD) to select multiple.</div>
          </div>

          <!-- Tasks -->
          <div class="mb-3">
            <label class="form-label">Tasks</label>
            <div id="taskListAdd">
              <input type="text" class="form-control mb-2" name="tasks[]" placeholder="Enter task">
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTaskField('taskListAdd')">+ Add Task</button>
          </div>
        </div>

        <div class="modal-footer">
          <button type="submit" class="btn btn-success">Add Project</button>
        </div>
      </form>
    </div>
  </div>
</div>