
<!-- =========================================================
     EMPLOYEE TOP NAVBAR
     Manager-inspired design with employee-specific functionality
========================================================= -->

<nav class="employee-topbar fixed-top">

    <div class="employee-topbar-inner">

        <!-- =====================================================
             LEFT: BRAND + MOBILE SIDEBAR TOGGLE
        ====================================================== -->

        <div class="employee-topbar-left">

            <!-- Mobile Sidebar Toggle -->
            <button
                type="button"
                class="employee-menu-toggle d-lg-none"
                data-bs-toggle="collapse"
                data-bs-target="#sidebarCollapse"
                aria-label="Toggle sidebar"
                title="Menu">

                <i class="fas fa-bars"></i>

            </button>


            <!-- Brand -->
            <a href="/" class="employee-brand text-decoration-none">

                <img
                    src="/images/logo.png"
                    alt="TaskDrobe Logo"
                    class="employee-brand-logo">

                <div class="employee-brand-text">
                    <span class="employee-brand-name">TASKDROBE</span>
                </div>

            </a>


            <!-- Desktop Greeting -->
            <div class="employee-header-greeting d-none d-xl-flex">

                <div class="employee-header-label">
                    EMPLOYEE WORKSPACE
                </div>

                <div class="employee-header-title">
                    Welcome back, <%= user.full_name %>
                    <span class="employee-wave">👋</span>
                </div>

            </div>

        </div>


        <!-- =====================================================
             RIGHT: SEARCH + NOTIFICATIONS + THEME + PROFILE + LOGOUT
        ====================================================== -->

        <div class="employee-topbar-actions">


            <!-- =================================================
                 GLOBAL SEARCH
            ================================================== -->

            <div class="employee-search-wrapper">

                <div class="employee-search">

                    <i class="fas fa-search employee-search-icon"></i>

                    <input
                        type="text"
                        id="globalSearch"
                        placeholder="Search projects or tasks..."
                        autocomplete="off"
                        aria-label="Search projects or tasks">

                    <kbd>⌘ K</kbd>

                    <button
                        type="button"
                        id="clearSearch"
                        class="employee-search-clear d-none"
                        aria-label="Clear search"
                        title="Clear search">

                        <i class="fas fa-times"></i>

                    </button>

                </div>


                <!-- Search Results -->
                <div
                    id="searchResults"
                    class="employee-search-results d-none">

                    <!-- Results inserted by dashboard.js -->

                </div>

            </div>


            <!-- =================================================
                 NOTIFICATIONS
            ================================================== -->

            <div class="employee-notification-wrapper">

                <button
                    type="button"
                    id="systemBellIcon"
                    class="employee-icon-button"
                    title="Notifications"
                    aria-label="Notifications">

                    <i class="fas fa-bell"></i>

                    <span
                        id="systemBellBadge"
                        class="employee-notification-badge d-none">

                        <span id="systemBellCount">0</span>

                        <span class="visually-hidden">
                            unread notifications
                        </span>

                    </span>

                </button>


                <!-- Notification Dropdown -->
                <div
                    id="systemNotificationDropdown"
                    class="employee-notification-dropdown d-none">

                    <!-- Header -->
                    <div class="employee-notification-header">

                        <div>

                            <div class="employee-notification-title">
                                Notifications
                            </div>

                            <div
                                id="notificationSubtitle"
                                class="employee-notification-subtitle">

                                You're all caught up

                            </div>

                        </div>


                        <button
                            type="button"
                            id="markAllNotificationsRead"
                            class="employee-mark-all d-none">

                            Mark all read

                        </button>

                    </div>


                    <!-- Notification List -->
                    <div
                        id="systemNotificationList"
                        class="employee-notification-list">

                        <div
                            id="notificationLoading"
                            class="employee-notification-empty">

                            <i class="fas fa-spinner fa-spin"></i>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 THEME TOGGLE
            ================================================== -->

            <button
                type="button"
                id="themeToggle"
                class="employee-icon-button"
                title="Toggle Theme"
                aria-label="Toggle Theme">

                <i class="fas fa-moon"></i>

            </button>


            <!-- =================================================
                 PROFILE
            ================================================== -->

            <a
                href="/<%= user.role_name %>/profile"
                class="employee-profile-button text-decoration-none"
                title="My Profile">

                <span class="employee-profile-avatar">

                    <%= user.full_name
                        ? user.full_name
                            .split(" ")
                            .map(name => name.charAt(0))
                            .join("")
                            .substring(0, 2)
                            .toUpperCase()
                        : "U"
                    %>

                </span>


                <span class="employee-profile-info d-none d-lg-flex">

                    <span class="employee-profile-name">
                        <%= user.full_name %>
                    </span>

                    <span class="employee-profile-role">
                        Employee
                    </span>

                </span>


                <i class="fas fa-chevron-down employee-profile-chevron d-none d-lg-block"></i>

            </a>


            <!-- =================================================
                 LOGOUT
            ================================================== -->

            <a
                href="/auth/logout"
                class="employee-logout-button"
                title="Logout"
                aria-label="Logout">

                <i class="fas fa-sign-out-alt"></i>

                <span class="d-none d-xl-inline">
                    Logout
                </span>

            </a>

        </div>

    </div>

</nav>


<!-- =========================================================
     EMPLOYEE NAVBAR STYLES
     Scoped specifically to the employee navbar.
========================================================= -->




<!-- =========================================================
     EXISTING EMPLOYEE NOTIFICATION FUNCTIONALITY
     Preserved from the original navbar.
========================================================= -->

<script>

$(document).ready(function () {

    const currentUserId =
        "<%= locals.user ? user.user_id : '' %>";


    if (!currentUserId) {
        return;
    }


    /* =========================================================
       SYSTEM NOTIFICATION SOCKET
    ========================================================= */

    const notificationSocket =
        io("/notifications");


    notificationSocket.on("connect", function () {

        console.log(
            "🔔 System notification socket connected:",
            notificationSocket.id
        );


        notificationSocket.emit(
            "joinNotificationRoom",
            currentUserId
        );

    });


    /* =========================================================
       NEW NOTIFICATION
    ========================================================= */

    notificationSocket.on(
        "newSystemNotification",
        function (notification) {

            console.log(
                "🔔 New system notification:",
                notification
            );


            loadSystemNotifications();

        }
    );


    /* =========================================================
       NOTIFICATION COUNT
    ========================================================= */

    notificationSocket.on(
        "notificationCountUpdated",
        function (count) {

            updateNotificationBadge(count);

        }
    );


    /* =========================================================
       UPDATE BADGE
    ========================================================= */

    function updateNotificationBadge(count) {

        count = parseInt(count, 10) || 0;


        const $badge =
            $("#systemBellBadge");


        const $count =
            $("#systemBellCount");


        if (count > 0) {

            $count.text(count);

            $badge.removeClass("d-none");

            $("#notificationSubtitle").text(
                `${count} unread notification${count === 1 ? "" : "s"}`
            );

        } else {

            $count.text("0");

            $badge.addClass("d-none");

            $("#notificationSubtitle")
                .text("You're all caught up");

        }

    }


    /* =========================================================
       LOAD NOTIFICATIONS
    ========================================================= */

    function loadSystemNotifications() {

        $.ajax({

            url: "/api/notifications",

            type: "GET",

            success: function (res) {

                if (!res.success) {
                    return;
                }


                renderSystemNotifications(
                    res.notifications
                );

            },

            error: function () {

                $("#systemNotificationList").html(`

                    <div class="employee-notification-empty">

                        <i class="fas fa-exclamation-circle"></i>

                        <div>
                            Unable to load notifications.
                        </div>

                    </div>

                `);

            }

        });

    }


    /* =========================================================
       RENDER NOTIFICATIONS
    ========================================================= */

    function renderSystemNotifications(
        notifications
    ) {

        const $list =
            $("#systemNotificationList");


        $list.empty();


        if (
            !notifications ||
            notifications.length === 0
        ) {

            $list.html(`

                <div class="employee-notification-empty">

                    <i class="fas fa-bell-slash fa-2x opacity-50"></i>

                    <div class="fw-semibold">
                        You're all caught up!
                    </div>

                    <small>
                        No system notifications.
                    </small>

                </div>

            `);


            $("#markAllNotificationsRead")
                .addClass("d-none");


            return;
        }


        let unreadCount = 0;


        notifications.forEach(function (
            notification
        ) {

            if (!notification.is_read) {
                unreadCount++;
            }


            const isUnread =
                !notification.is_read;


            const icon =
                getNotificationIcon(
                    notification.type
                );


            const time =
                formatNotificationTime(
                    notification.created_at
                );


            $list.append(`

                <div
                    class="notification-item
                    ${isUnread ? "bg-light" : ""}"
                    data-id="${notification.notification_id}"
                    data-type="${notification.type}"
                    data-reference-id="${notification.reference_id || ""}">

                    <div class="d-flex gap-3">

                        <div
                            class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center
                            ${isUnread
                                ? "bg-danger text-white"
                                : "bg-light text-muted"}"
                            style="
                                width: 38px;
                                height: 38px;
                            ">

                            <i class="${icon}"></i>

                        </div>


                        <div class="flex-grow-1 min-w-0">

                            <div
                                class="d-flex justify-content-between gap-2">

                                <div
                                    class="small
                                    ${isUnread
                                        ? "fw-bold text-dark"
                                        : "text-dark"}">

                                    ${escapeHtml(
                                        notification.content
                                    )}

                                </div>


                                ${
                                    isUnread
                                        ? `
                                            <span
                                                class="rounded-circle bg-danger flex-shrink-0"
                                                style="
                                                    width: 7px;
                                                    height: 7px;
                                                    margin-top: 5px;
                                                ">
                                            </span>
                                        `
                                        : ""
                                }

                            </div>


                            <div
                                class="small text-muted mt-1">

                                ${escapeHtml(
                                    notification.sender_name || "System"
                                )}

                                ·

                                ${time}

                            </div>

                        </div>

                    </div>

                </div>

            `);

        });


        if (unreadCount > 0) {

            $("#markAllNotificationsRead")
                .removeClass("d-none");

        } else {

            $("#markAllNotificationsRead")
                .addClass("d-none");

        }


        updateNotificationBadge(
            unreadCount
        );

    }


    /* =========================================================
       NOTIFICATION ICON
    ========================================================= */

    function getNotificationIcon(type) {

        switch (type) {

            case "task_assigned":
                return "fas fa-tasks";

            case "task_status":
                return "fas fa-flag";

            case "task_comment":
                return "fas fa-comments";

            case "project_created":
                return "fas fa-folder-plus";

            case "project_updated":
                return "fas fa-folder";

            case "project_member":
                return "fas fa-user-plus";

            default:
                return "fas fa-bell";

        }

    }


    /* =========================================================
       NOTIFICATION TIME
    ========================================================= */

    function formatNotificationTime(
        dateInput
    ) {

        if (!dateInput) {
            return "";
        }


        const date =
            new Date(dateInput);


        return date.toLocaleString(
            [],
            {
                month: "short",
                day: "numeric",
                hour: "numeric",
                minute: "2-digit"
            }
        );

    }


    /* =========================================================
       ESCAPE HTML
    ========================================================= */

    // function escapeHtml(value) {

    //     return String(value ?? "")
    //         .replace(/&/g, "&amp;")
    //         .replace(/</g, "&lt;")
    //         .replace(/>/g, "&gt;")
    //         .replace(/"/g, "&quot;")
    //         .replace(/'/g, "&#039;");

    // }


    /* =========================================================
       BELL CLICK
    ========================================================= */

    $("#systemBellIcon").on(
        "click",
        function (e) {

            e.stopPropagation();


            const $dropdown =
                $("#systemNotificationDropdown");


            $dropdown.toggleClass("d-none");


            if (!$dropdown.hasClass("d-none")) {

                loadSystemNotifications();

            }

        }
    );


    /* =========================================================
       CLICK OUTSIDE NOTIFICATION
    ========================================================= */

    $(document).on(
        "click",
        function (e) {

            if (
                !$(e.target).closest(
                    "#systemBellIcon, #systemNotificationDropdown"
                ).length
            ) {

                $("#systemNotificationDropdown")
                    .addClass("d-none");

            }

        }
    );


    /* =========================================================
       INDIVIDUAL NOTIFICATION
    ========================================================= */

    $(document).on(
        "click",
        ".notification-item",
        function () {

            const $item =
                $(this);


            const notificationId =
                $item.attr("data-id");


            const type =
                $item.attr("data-type");


            const referenceId =
                $item.attr("data-reference-id");


            $.ajax({

                url:
                    `/api/notifications/${notificationId}/read`,

                type: "PATCH",

                success: function (res) {

                    if (!res.success) {
                        return;
                    }


                    $item.removeClass("bg-light");


                    /*
                     * Remove only the unread indicator
                     * instead of accidentally removing
                     * the notification icon styling.
                     */

                    $item
                        .find(".rounded-circle.bg-danger")
                        .last()
                        .remove();


                    updateNotificationBadge(
                        res.unreadCount
                    );


                    navigateFromNotification(
                        type,
                        referenceId
                    );

                }

            });

        }
    );


    /* =========================================================
       MARK ALL READ
    ========================================================= */

    $("#markAllNotificationsRead").on(
        "click",
        function (e) {

            e.stopPropagation();


            $.ajax({

                url:
                    "/api/notifications/read-all",

                type: "PATCH",

                success: function (res) {

                    if (!res.success) {
                        return;
                    }


                    updateNotificationBadge(0);


                    loadSystemNotifications();

                }

            });

        }
    );


    /* =========================================================
       NOTIFICATION NAVIGATION
    ========================================================= */

    function navigateFromNotification(
        type,
        referenceId
    ) {

        if (!referenceId) {
            return;
        }


        switch (type) {

            case "task_assigned":

            case "task_status":

            case "task_comment":

                window.location.href =
                    `/tasks/${referenceId}/insight`;

                break;


            default:
                break;

        }

    }


    /* =========================================================
       INITIAL LOAD
    ========================================================= */

    loadSystemNotifications();

});

</script>

