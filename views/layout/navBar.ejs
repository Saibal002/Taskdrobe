       RESPONSIVE
    ========================================================= */

    @media (max-width: 1200px) {

        .employee-header-greeting {

            display: none !important;

        }

        .employee-search-wrapper {

            width: min(300px, 32vw);

        }

    }


    @media (max-width: 991px) {

        .employee-topbar-inner {

            padding: 0 18px;

            gap: 12px;

        }


        .employee-topbar-left {

            gap: 10px;

        }


        .employee-search-wrapper {

            display: none;

        }


        .employee-profile-button {

            padding-right: 7px;

        }

    }


    @media (max-width: 700px) {

        .employee-topbar-inner {

            padding: 0 12px;

        }


        .employee-brand-name {

            display: none;

        }


        .employee-topbar-actions {

            gap: 7px;

        }


        .employee-notification-dropdown {

            position: fixed;

            top: 78px;

            right: 12px;

            left: 12px;

            width: auto;

            max-width: none;

        }

    }


    @media (max-width: 480px) {

        .employee-profile-button {

            border: 0;

            background: transparent;

            padding: 0;

        }


        .employee-logout-button {

            width: 42px;

            padding: 0;

        }


        .employee-menu-toggle,
        .employee-icon-button,
        .employee-profile-button,
        .employee-logout-button {

            height: 40px;

            min-height: 40px;

        }


        .employee-profile-avatar {

            width: 32px;

            height: 32px;

        }

    }

</style>


<!-- =========================================================
     EXISTING EMPLOYEE NOTIFICATION FUNCTIONALITY
     Preserved from the original navbar.
========================================================= -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>

$(document).ready(function () {

    const currentUserId =
        "<%= locals.user ? user.user_id : '' %>";


    if (!currentUserId) {
        return;
    }


    /* =========================================================
       SYSTEM NOTIFICATION SOCKET
    ========================================================= */

    const notificationSocket =
        io("/notifications");


    notificationSocket.on("connect", function () {

        console.log(
            "🔔 System notification socket connected:",
            notificationSocket.id
        );


        notificationSocket.emit(
            "joinNotificationRoom",
            currentUserId
        );

    });


    /* =========================================================
       NEW NOTIFICATION
    ========================================================= */

    notificationSocket.on(
        "newSystemNotification",
        function (notification) {

            console.log(
                "🔔 New system notification:",
                notification
            );


            loadSystemNotifications();

        }
    );


    /* =========================================================
       NOTIFICATION COUNT
    ========================================================= */

    notificationSocket.on(
        "notificationCountUpdated",
        function (count) {

            updateNotificationBadge(count);

        }
    );


    /* =========================================================
       UPDATE BADGE
    ========================================================= */

    function updateNotificationBadge(count) {

        count = parseInt(count, 10) || 0;


        const $badge =
            $("#systemBellBadge");


        const $count =
            $("#systemBellCount");


        if (count > 0) {

            $count.text(count);

            $badge.removeClass("d-none");

            $("#notificationSubtitle").text(
                `${count} unread notification${count === 1 ? "" : "s"}`
            );

        } else {

            $count.text("0");

            $badge.addClass("d-none");

            $("#notificationSubtitle")
                .text("You're all caught up");

        }

    }


    /* =========================================================
       LOAD NOTIFICATIONS
    ========================================================= */

    function loadSystemNotifications() {

        $.ajax({

            url: "/api/notifications",

            type: "GET",

            success: function (res) {

                if (!res.success) {
                    return;
                }


                renderSystemNotifications(
                    res.notifications
                );

            },

            error: function () {

                $("#systemNotificationList").html(`

                    <div class="employee-notification-empty">

                        <i class="fas fa-exclamation-circle"></i>

                        <div>
                            Unable to load notifications.
                        </div>

                    </div>

                `);

            }

        });

    }


    /* =========================================================
       RENDER NOTIFICATIONS
    ========================================================= */

    function renderSystemNotifications(
        notifications
    ) {

        const $list =
            $("#systemNotificationList");


        $list.empty();


        if (
            !notifications ||
            notifications.length === 0
        ) {

            $list.html(`

                <div class="employee-notification-empty">

                    <i class="fas fa-bell-slash fa-2x opacity-50"></i>

                    <div class="fw-semibold">
                        You're all caught up!
                    </div>

                    <small>
                        No system notifications.
                    </small>

                </div>

            `);


            $("#markAllNotificationsRead")
                .addClass("d-none");


            return;
        }


        let unreadCount = 0;


        notifications.forEach(function (
            notification
        ) {

            if (!notification.is_read) {
                unreadCount++;
            }


            const isUnread =
                !notification.is_read;


            const icon =
                getNotificationIcon(
                    notification.type
                );


            const time =
                formatNotificationTime(
                    notification.created_at
                );


            $list.append(`

                <div
                    class="notification-item
                    ${isUnread ? "bg-light" : ""}"
                    data-id="${notification.notification_id}"
                    data-type="${notification.type}"
                    data-reference-id="${notification.reference_id || ""}">

                    <div class="d-flex gap-3">

                        <div
                            class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center
                            ${isUnread
                                ? "bg-danger text-white"
                                : "bg-light text-muted"}"
                            style="
                                width: 38px;
                                height: 38px;
                            ">

                            <i class="${icon}"></i>

                        </div>


                        <div class="flex-grow-1 min-w-0">

                            <div
                                class="d-flex justify-content-between gap-2">

                                <div
                                    class="small
                                    ${isUnread
                                        ? "fw-bold text-dark"
                                        : "text-dark"}">

                                    ${escapeHtml(
                                        notification.content
                                    )}

                                </div>


                                ${
                                    isUnread
                                        ? `
                                            <span
                                                class="rounded-circle bg-danger flex-shrink-0"
                                                style="
                                                    width: 7px;
                                                    height: 7px;
                                                    margin-top: 5px;
                                                ">
                                            </span>
                                        `
                                        : ""
                                }

                            </div>


                            <div
                                class="small text-muted mt-1">

                                ${escapeHtml(
                                    notification.sender_name || "System"
                                )}

                                ·

                                ${time}

                            </div>

                        </div>

                    </div>

                </div>

            `);

        });


        if (unreadCount > 0) {

            $("#markAllNotificationsRead")
                .removeClass("d-none");

        } else {

            $("#markAllNotificationsRead")
                .addClass("d-none");

        }


        updateNotificationBadge(
            unreadCount
        );

    }


    /* =========================================================
       NOTIFICATION ICON
    ========================================================= */

    function getNotificationIcon(type) {

        switch (type) {

            case "task_assigned":
                return "fas fa-tasks";

            case "task_status":
                return "fas fa-flag";

            case "task_comment":
                return "fas fa-comments";

            case "project_created":
                return "fas fa-folder-plus";

            case "project_updated":
                return "fas fa-folder";

            case "project_member":
                return "fas fa-user-plus";

            default:
                return "fas fa-bell";

        }

    }


    /* =========================================================
       NOTIFICATION TIME
    ========================================================= */

    function formatNotificationTime(
        dateInput
    ) {

        if (!dateInput) {
            return "";
        }


        const date =
            new Date(dateInput);


        return date.toLocaleString(
            [],
            {
                month: "short",
                day: "numeric",
                hour: "numeric",
                minute: "2-digit"
            }
        );

    }


    /* =========================================================
       ESCAPE HTML
    ========================================================= */

    function escapeHtml(value) {

        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    /* =========================================================
       BELL CLICK
    ========================================================= */

    $("#systemBellIcon").on(
        "click",
        function (e) {

            e.stopPropagation();


            const $dropdown =
                $("#systemNotificationDropdown");


            $dropdown.toggleClass("d-none");


            if (!$dropdown.hasClass("d-none")) {

                loadSystemNotifications();

            }

        }
    );


    /* =========================================================
       CLICK OUTSIDE NOTIFICATION
    ========================================================= */

    $(document).on(
        "click",
        function (e) {

            if (
                !$(e.target).closest(
                    "#systemBellIcon, #systemNotificationDropdown"
                ).length
            ) {

                $("#systemNotificationDropdown")
                    .addClass("d-none");

            }

        }
    );


    /* =========================================================
       INDIVIDUAL NOTIFICATION
    ========================================================= */

    $(document).on(
        "click",
        ".notification-item",
        function () {

            const $item =
                $(this);


            const notificationId =
                $item.attr("data-id");


            const type =
                $item.attr("data-type");


            const referenceId =
                $item.attr("data-reference-id");


            $.ajax({

                url:
                    `/api/notifications/${notificationId}/read`,

                type: "PATCH",

                success: function (res) {

                    if (!res.success) {
                        return;
                    }


                    $item.removeClass("bg-light");


                    /*
                     * Remove only the unread indicator
                     * instead of accidentally removing
                     * the notification icon styling.
                     */

                    $item
                        .find(".rounded-circle.bg-danger")
                        .last()
                        .remove();


                    updateNotificationBadge(
                        res.unreadCount
                    );


                    navigateFromNotification(
                        type,
                        referenceId
                    );

                }

            });

        }
    );


    /* =========================================================
       MARK ALL READ
    ========================================================= */

    $("#markAllNotificationsRead").on(
        "click",
        function (e) {

            e.stopPropagation();


            $.ajax({

                url:
                    "/api/notifications/read-all",

                type: "PATCH",

                success: function (res) {

                    if (!res.success) {
                        return;
                    }


                    updateNotificationBadge(0);


                    loadSystemNotifications();

                }

            });

        }
    );


    /* =========================================================
       NOTIFICATION NAVIGATION
    ========================================================= */

    function navigateFromNotification(
        type,
        referenceId
    ) {

        if (!referenceId) {
            return;
        }


        switch (type) {

            case "task_assigned":

            case "task_status":

            case "task_comment":

                window.location.href =
                    `/tasks/${referenceId}/insight`;

                break;


            default:
                break;

        }

    }


    /* =========================================================
       INITIAL LOAD
    ========================================================= */

    loadSystemNotifications();

});

</script>
