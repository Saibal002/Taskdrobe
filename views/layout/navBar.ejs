<% const role = (user && user.role_name) || "employee"; %>
<% const isManager = role === "manager"; %>
<% const isAdmin = role === "admin"; %>
<% const homeUrl = isAdmin ? "/admin/dashboard" : isManager ? "/manager/dashboard" : "/dashboard"; %>

<%- include("sideBar", { user: user, page: page || "" }) %>

<style>
    /* Force navbar inner container to split Left (Logo/Menu) and Right (Actions) */
    .app-navbar .app-navbar-inner {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        width: 100% !important;
        gap: 1rem;
    }

    /* Pin Logo & Mobile Hamburger to the far left */
    .app-navbar .app-navbar-left {
        display: flex !important;
        align-items: center !important;
        gap: 0.85rem;
        margin-right: auto !important;
        flex-shrink: 0;
    }

    /* Keep right-side controls anchored to the right */
    .app-navbar .app-navbar-actions {
        display: flex;
        align-items: center;
        margin-left: auto;
        min-width: 0;
    }

    /* Brand Wrapper */
    .app-navbar-brand {
        position: relative;
        isolation: isolate;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        padding: 0.25rem 0.6rem;
        border-radius: 12px;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .app-navbar-brand:hover {
        transform: translateY(-1px);
    }

    /* Logo Sizing */
    .app-navbar-brand-logo {
        position: relative;
        z-index: 2;
        height: 48px;
        width: auto;
        max-width: 195px;
        object-fit: contain;
        display: block;
        transition: filter 0.25s ease;
    }

    /* Subtle Tight Nebula Backlight (Hidden in Light Mode) */
    .app-navbar-brand::before {
        content: "";
        position: absolute;
        inset: 2px -2px;
        z-index: 0;
        border-radius: 999px;
        background: radial-gradient(
            ellipse at 50% 55%,
            rgba(148, 163, 255, 0.22) 0%,
            rgba(99, 102, 241, 0.12) 50%,
            transparent 80%
        );
        filter: blur(9px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    /* Activate Subtle Backlight in Dark Mode */
    [data-theme="dark"] .app-navbar-brand::before,
    [data-bs-theme="dark"] .app-navbar-brand::before,
    body.dark-mode .app-navbar-brand::before,
    body.dark .app-navbar-brand::before,
    html.dark .app-navbar-brand::before {
        opacity: 1;
    }

    /* Soft crisp edge so dark 'ask' letters stay readable without harsh glow */
    [data-theme="dark"] .app-navbar-brand-logo,
    [data-bs-theme="dark"] .app-navbar-brand-logo,
    body.dark-mode .app-navbar-brand-logo,
    body.dark .app-navbar-brand-logo,
    html.dark .app-navbar-brand-logo {
        filter: drop-shadow(0 0 6px rgba(199, 210, 254, 0.28));
    }

    /* Tablet Responsiveness */
    @media (max-width: 991.98px) {
        .app-navbar-brand-logo {
            height: 42px;
            max-width: 165px;
        }
    }

    /* Mobile Responsiveness */
    @media (max-width: 575.98px) {
        .app-navbar .app-navbar-inner {
            gap: 0.5rem;
        }

        .app-navbar .app-navbar-left {
            gap: 0.4rem;
        }

        .app-navbar-brand {
            padding: 0.15rem 0.35rem;
        }

        .app-navbar-brand-logo {
            height: 34px;
            max-width: 130px;
        }
    }
</style>

<header class="app-navbar" data-navbar-role="<%= role %>" data-navbar-page="<%= page || '' %>">
    <div class="app-navbar-inner">

        <!-- LEFT: Mobile Menu Toggle + Brand Logo -->
        <div class="app-navbar-left">
            <button type="button" id="appSidebarToggle" class="app-navbar-menu" aria-label="Toggle navigation" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>

            <a href="<%= homeUrl %>" class="app-navbar-brand" aria-label="TaskDrobe Home">
                <img
                    src="/images/logo.png"
                    onerror="this.onerror=null;this.src='/images/logo.png.png';"
                    alt="TaskDrobe Logo"
                    class="app-navbar-brand-logo"
                >
            </a>
        </div>

        <!-- RIGHT: Controls -->
        <div class="app-navbar-actions">
            
            <!-- Search -->
            <div class="app-navbar-search-wrapper">
                <div class="app-navbar-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="globalSearch" placeholder="Search projects or tasks..." autocomplete="off" aria-label="Search projects or tasks">
                    <button type="button" id="clearSearch" class="app-navbar-search-clear d-none" aria-label="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <kbd>⌘ K</kbd>
                </div>
                <div id="searchResults" class="app-navbar-search-results d-none"></div>
            </div>

            <!-- Notifications -->
            <div class="app-navbar-notification-wrapper">
                <button type="button" id="notificationButton" class="app-navbar-icon" data-user-id="<%= user.user_id %>" aria-label="Notifications" aria-expanded="false">
                    <i class="bi bi-bell"></i>
                    <span id="notificationBadge" class="app-navbar-badge d-none">0</span>
                </button>

                <div id="notificationDropdown" class="app-navbar-dropdown d-none">
                    <div class="app-navbar-dropdown-header">
                        <div>
                            <strong>Notifications</strong>
                            <small id="notificationSubtitle">You're all caught up</small>
                        </div>
                        <button type="button" id="markAllNotifications" class="app-navbar-mark-all d-none">Mark all read</button>
                    </div>
                    <div id="notificationList" class="app-navbar-notification-list">
                        <div class="app-navbar-empty">
                            <i class="bi bi-bell-slash"></i>
                            <span>No notifications</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Schedule Quick Link -->
            <a href="<%= isAdmin ? '/admin/meetings' : '/meetings' %>" class="app-navbar-icon text-decoration-none <%= typeof page !== 'undefined' && page === 'meetings' ? 'active' : '' %>" aria-label="Schedule" title="Schedule">
                <i class="bi bi-calendar-event"></i>
            </a>

            <!-- Theme Toggle -->
            <button type="button" id="themeToggle" class="app-navbar-icon" aria-label="Toggle theme">
                <i class="bi bi-moon"></i>
            </button>

            <!-- Profile -->
            <a href="/<%= role %>/profile" class="app-navbar-profile text-decoration-none" title="My Profile">
                <span class="app-navbar-avatar">
                    <%= (user.full_name || "U").split(/\s+/).map(name => name.charAt(0)).join("").substring(0, 2).toUpperCase() %>
                </span>
                <span class="app-navbar-profile-info d-none d-lg-flex">
                    <strong><%= user.full_name %></strong>
                </span>
            </a>

            <!-- Logout -->
            <a href="/auth/logout" class="app-navbar-logout" aria-label="Logout" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </a>

        </div>
    </div>
</header>