<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom fixed-top custom-header">
    <div class="container-fluid px-3">
        <!-- Logo -->
        <div class="navbar-brand d-flex align-items-center">
            <img src="/images/logo.png" alt="TaskDrobe Logo" width="40" height="40" class="me-2">
            <span class="fw-bold fs-5">TASKDROBE</span>
        </div>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Header Navigation -->
        <div class="d-flex align-items-center ms-auto">
            <div class="d-none d-md-flex align-items-center me-3">
                <!-- System Alerts Bell -->
                <div class="nav-icon me-2 position-relative">

                    <button type="button" id="systemBellIcon"
                        class="btn btn-link text-dark p-0 border-0 shadow-none position-relative" title="Notifications"
                        style="line-height: 1;">

                        <i class="fas fa-bell"></i>

                        <span
                            class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                            id="systemBellBadge" style="font-size: 0.6rem; min-width: 16px;">

                            <span id="systemBellCount">0</span>

                            <span class="visually-hidden">
                                unread notifications
                            </span>

                        </span>

                    </button>


                    <!-- ===================================================== -->
                    <!-- SYSTEM NOTIFICATION DROPDOWN -->
                    <!-- ===================================================== -->

                    <div id="systemNotificationDropdown"
                        class="card shadow-lg border-0 rounded-4 d-none position-absolute" style="
            width: 380px;
            max-width: 90vw;
            right: 0;
            top: 42px;
            z-index: 2000;
        ">

                        <!-- Header -->

                        <div class="card-header bg-white border-bottom p-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <h6 class="mb-0 fw-bold">
                                        Notifications
                                    </h6>

                                    <small class="text-muted" id="notificationSubtitle">
                                        You're all caught up
                                    </small>

                                </div>

                                <button type="button" id="markAllNotificationsRead"
                                    class="btn btn-sm btn-link text-decoration-none d-none">

                                    Mark all read

                                </button>

                            </div>

                        </div>


                        <!-- Notification List -->

                        <div id="systemNotificationList" style="
                max-height: 420px;
                overflow-y: auto;
            ">

                            <div id="notificationLoading" class="text-center p-4 text-muted">

                                <i class="fas fa-spinner fa-spin"></i>

                            </div>

                        </div>

                    </div>

                </div>
                <div class="nav-icon me-2"><i class="fas fa-bookmark"></i></div>
                <div class="nav-icon me-3"><i class="fas fa-calendar"></i></div>

                <!-- Search Box -->
                <!-- Global Search -->

                <div class="search-wrapper me-3">

                    <div class="search-box">

                        <i class="fas fa-search text-muted"></i>

                        <input type="text" id="globalSearch" class="form-control border-0 bg-transparent ms-2"
                            placeholder="Search projects or tasks..." autocomplete="off">

                        <button type="button" id="clearSearch" class="search-clear-btn d-none" aria-label="Clear search"
                            title="Clear search">

                            <i class="fas fa-times"></i>

                        </button>

                    </div>

                    <!-- Search Results -->

                    <div id="searchResults" class="search-results d-none">

                        <!-- Results will be inserted by JavaScript -->

                    </div>

                </div>
                <!-- Theme Switcher -->
                <button id="themeToggle" class="btn btn-sm btn-outline-secondary rounded-circle" title="Toggle Theme">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="d-flex">
                <div class="nav-icon me-2"><i class="fas fa-expand"></i></div>
                <!-- Corrected Profile Link -->
                <div class="nav-icon me-2">
                    <a href="/<%= user.role_name %>/profile" class="text-dark" title="My Profile">
                        <i class="fas fa-user"></i>
                    </a>
                </div>
                <div class="nav-icon me-2"><i class="fas fa-cog"></i></div>
                <div class="nav-icon"><i class="fas fa-th"></i></div>
                <div class="me-2">
                    <a href="/auth/logout" class="logout-icon">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>

            </div>
        </div>
    </div>
</nav>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
$(document).ready(function () {

    const currentUserId =
        "<%= locals.user ? user.user_id : '' %>";

    if (!currentUserId) {
        return;
    }


    // =========================================================
    // SYSTEM NOTIFICATION SOCKET
    //
    // IMPORTANT:
    // This is NOT the global chat socket.
    // =========================================================

    const notificationSocket =
        io("/notifications");


    // =========================================================
    // CONNECT
    // =========================================================

    notificationSocket.on("connect", function () {

        console.log(
            "🔔 System notification socket connected:",
            notificationSocket.id
        );

        notificationSocket.emit(
            "joinNotificationRoom",
            currentUserId
        );
    });


    // =========================================================
    // NEW SYSTEM NOTIFICATION
    // =========================================================

    notificationSocket.on(
        "newSystemNotification",
        function (notification) {

            console.log(
                "🔔 New system notification:",
                notification
            );

            loadSystemNotifications();
        }
    );


    // =========================================================
    // UNREAD COUNT
    // =========================================================

    notificationSocket.on(
        "notificationCountUpdated",
        function (count) {

            updateNotificationBadge(count);
        }
    );


    // =========================================================
    // BADGE
    // =========================================================

    function updateNotificationBadge(count) {

        count = parseInt(count, 10) || 0;

        const $badge =
            $("#systemBellBadge");

        const $count =
            $("#systemBellCount");

        if (count > 0) {

            $count.text(count);

            $badge.removeClass("d-none");

            $("#notificationSubtitle")
                .text(
                    `${count} unread notification${count === 1 ? "" : "s"}`
                );

        } else {

            $count.text("0");

            $badge.addClass("d-none");

            $("#notificationSubtitle")
                .text("You're all caught up");

        }
    }


    // =========================================================
    // LOAD NOTIFICATIONS
    // =========================================================

    function loadSystemNotifications() {

        $.ajax({

            url: "/api/notifications",

            type: "GET",

            success: function (res) {

                if (!res.success) {
                    return;
                }

                renderSystemNotifications(
                    res.notifications
                );

            },

            error: function () {

                $("#systemNotificationList").html(`
                    <div class="text-center text-muted p-4">
                        <i class="fas fa-exclamation-circle mb-2"></i>
                        <div class="small">
                            Unable to load notifications.
                        </div>
                    </div>
                `);
            }
        });
    }


    // =========================================================
    // RENDER NOTIFICATIONS
    // =========================================================

    function renderSystemNotifications(
        notifications
    ) {

        const $list =
            $("#systemNotificationList");

        $list.empty();


        if (
            !notifications ||
            notifications.length === 0
        ) {

            $list.html(`
                <div class="text-center text-muted p-5">

                    <i
                        class="fas fa-bell-slash fa-2x mb-3 opacity-50">
                    </i>

                    <div class="fw-semibold">
                        You're all caught up!
                    </div>

                    <small>
                        No system notifications.
                    </small>

                </div>
            `);

            $("#markAllNotificationsRead")
                .addClass("d-none");

            return;
        }


        let unreadCount = 0;


        notifications.forEach(function (
            notification
        ) {

            if (!notification.is_read) {
                unreadCount++;
            }


            const isUnread =
                !notification.is_read;


            const icon =
                getNotificationIcon(
                    notification.type
                );


            const time =
                formatNotificationTime(
                    notification.created_at
                );


            $list.append(`

                <div
                    class="notification-item p-3 border-bottom cursor-pointer
                    ${isUnread ? "bg-light" : ""}"
                    data-id="${notification.notification_id}"
                    data-type="${notification.type}"
                    data-reference-id="${notification.reference_id || ""}">

                    <div class="d-flex gap-3">

                        <div
                            class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center
                            ${isUnread ? "bg-danger text-white" : "bg-light text-muted"}"
                            style="
                                width: 38px;
                                height: 38px;
                            ">

                            <i class="${icon}"></i>

                        </div>


                        <div class="flex-grow-1 min-w-0">

                            <div class="d-flex justify-content-between gap-2">

                                <div
                                    class="small
                                    ${isUnread ? "fw-bold text-dark" : "text-dark"}">

                                    ${escapeHtml(
                                        notification.content
                                    )}

                                </div>

                                ${isUnread
                                    ? `
                                    <span
                                        class="rounded-circle bg-danger flex-shrink-0"
                                        style="
                                            width: 7px;
                                            height: 7px;
                                            margin-top: 5px;
                                        ">
                                    </span>
                                    `
                                    : ""
                                }

                            </div>


                            <div
                                class="small text-muted mt-1">

                                ${escapeHtml(
                                    notification.sender_name || "System"
                                )}

                                ·

                                ${time}

                            </div>

                        </div>

                    </div>

                </div>

            `);
        });


        if (unreadCount > 0) {

            $("#markAllNotificationsRead")
                .removeClass("d-none");

        } else {

            $("#markAllNotificationsRead")
                .addClass("d-none");
        }


        updateNotificationBadge(
            unreadCount
        );
    }


    // =========================================================
    // NOTIFICATION ICON
    // =========================================================

    function getNotificationIcon(type) {

        switch (type) {

            case "task_assigned":
                return "fas fa-tasks";

            case "task_status":
                return "fas fa-flag";

            case "task_comment":
                return "fas fa-comments";

            case "project_created":
                return "fas fa-folder-plus";

            case "project_updated":
                return "fas fa-folder";

            case "project_member":
                return "fas fa-user-plus";

            default:
                return "fas fa-bell";
        }
    }


    // =========================================================
    // TIME
    // =========================================================

    function formatNotificationTime(
        dateInput
    ) {

        if (!dateInput) {
            return "";
        }

        const date =
            new Date(dateInput);

        return date.toLocaleString(
            [],
            {
                month: "short",
                day: "numeric",
                hour: "numeric",
                minute: "2-digit"
            }
        );
    }


    // =========================================================
    // ESCAPE HTML
    // =========================================================

    function escapeHtml(value) {

        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    // =========================================================
    // BELL CLICK
    // =========================================================

    $("#systemBellIcon").on(
        "click",
        function (e) {

            e.stopPropagation();

            const $dropdown =
                $("#systemNotificationDropdown");

            $dropdown.toggleClass("d-none");

            if (!$dropdown.hasClass("d-none")) {

                loadSystemNotifications();
            }
        }
    );


    // =========================================================
    // CLICK OUTSIDE
    // =========================================================

    $(document).on(
        "click",
        function (e) {

            if (
                !$(e.target).closest(
                    "#systemBellIcon, #systemNotificationDropdown"
                ).length
            ) {

                $("#systemNotificationDropdown")
                    .addClass("d-none");
            }
        }
    );


    // =========================================================
    // CLICK INDIVIDUAL NOTIFICATION
    // =========================================================

    $(document).on(
        "click",
        ".notification-item",
        function () {

            const $item =
                $(this);

            const notificationId =
                $item.attr("data-id");

            const type =
                $item.attr("data-type");

            const referenceId =
                $item.attr("data-reference-id");


            $.ajax({

                url:
                    `/api/notifications/${notificationId}/read`,

                type: "PATCH",

                success: function (res) {

                    if (!res.success) {
                        return;
                    }


                    // Remove unread styling.
                    $item.removeClass("bg-light");


                    // Remove unread dot.
                    $item.find(".bg-danger")
                        .last()
                        .remove();


                    updateNotificationBadge(
                        res.unreadCount
                    );


                    /*
                     * Navigation can be added here once
                     * each notification type has a defined
                     * destination.
                     */

                    navigateFromNotification(
                        type,
                        referenceId
                    );
                }
            });
        }
    );


    // =========================================================
    // MARK ALL READ
    // =========================================================

    $("#markAllNotificationsRead").on(
        "click",
        function (e) {

            e.stopPropagation();

            $.ajax({

                url:
                    "/api/notifications/read-all",

                type: "PATCH",

                success: function (res) {

                    if (!res.success) {
                        return;
                    }

                    updateNotificationBadge(0);

                    loadSystemNotifications();
                }
            });
        }
    );


    // =========================================================
    // NAVIGATION
    // =========================================================

    function navigateFromNotification(
        type,
        referenceId
    ) {

        if (!referenceId) {
            return;
        }


        switch (type) {

            case "task_assigned":
            case "task_status":
            case "task_comment":

                window.location.href =
                    `/tasks/${referenceId}/insight`;

                break;


            default:
                break;
        }
    }


    // =========================================================
    // INITIAL LOAD
    // =========================================================

    loadSystemNotifications();

});
</script>