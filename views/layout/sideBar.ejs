<% const currentPage = typeof page !== "undefined" ? page : ""; %>

<aside id="appSidebar" class="app-sidebar" data-sidebar-role="<%= user && user.role_name === 'manager' ? 'manager' : 'employee' %>">

    <div class="app-sidebar-brand">
        <a href="/" class="app-sidebar-brand-link">
            <img src="/images/logo.png" alt="TaskDrobe Logo" class="app-sidebar-brand-logo">
            <span class="app-sidebar-brand-name">TaskDrobe</span>
        </a>
        <button type="button" id="appSidebarClose" class="app-sidebar-close" aria-label="Close navigation">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="app-sidebar-content">
        <div class="app-sidebar-group">
            <div class="app-sidebar-label">Workspace</div>

            <a href="<%= user && user.role_name === 'manager' ? '/manager/dashboard' : '/dashboard' %>"
               class="app-sidebar-item <%= currentPage === 'dashboard' ? 'active' : '' %>" title="Dashboard">
                <i class="bi bi-grid-1x2 app-sidebar-icon"></i>
                <span>Dashboard</span>
            </a>

            <a href="/projects" class="app-sidebar-item <%= currentPage === 'projects' || currentPage === 'project' ? 'active' : '' %>" title="Projects">
                <i class="bi bi-folder2-open app-sidebar-icon"></i>
                <span>Projects</span>
            </a>

            <a href="/tasks" class="app-sidebar-item <%= currentPage === 'tasks' ? 'active' : '' %>" title="Tasks">
                <i class="bi bi-check2-square app-sidebar-icon"></i>
                <span>Tasks</span>
            </a>
        </div>

        <% if (user && user.role_name === 'manager') { %>
            <div class="app-sidebar-group">
                <div class="app-sidebar-label">Management</div>

                <a href="/teams" class="app-sidebar-item <%= currentPage === 'teams' ? 'active' : '' %>" title="Teams">
                    <i class="bi bi-people app-sidebar-icon"></i>
                    <span>Teams</span>
                </a>

                <a href="#" class="app-sidebar-item app-sidebar-disabled" aria-disabled="true" tabindex="-1" title="Reports (Coming Soon)">
                    <i class="bi bi-bar-chart app-sidebar-icon"></i>
                    <span>Reports</span>
                    <span class="app-sidebar-coming-soon">Soon</span>
                </a>
            </div>
        <% } %>
    </div>

    <div class="app-sidebar-bottom">
        <a href="/<%= user.role_name %>/profile" class="app-sidebar-item <%= currentPage === 'profile' ? 'active' : '' %>" title="Profile">
            <i class="bi bi-person-circle app-sidebar-icon"></i>
            <span>Profile</span>
        </a>
        <a href="/auth/logout" class="app-sidebar-item app-sidebar-logout" title="Logout">
            <i class="bi bi-box-arrow-right app-sidebar-icon"></i>
            <span>Logout</span>
        </a>
    </div>

    <div id="appSidebarBackdrop" class="app-sidebar-backdrop" aria-hidden="true"></div>
</aside>