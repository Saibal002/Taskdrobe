<% const currentPage = typeof page !== "undefined" ? page : ""; %>
<% const role = (user && user.role_name) || "employee"; %>
<% const isManager = role === "manager"; %>
<% const isAdmin = role === "admin"; %>

<aside id="appSidebar" class="app-sidebar" data-sidebar-role="<%= role %>">

    <div class="app-sidebar-brand">
        
         
            <span class="app-sidebar-brand-name">TaskDrobe</span>
        
        <button type="button" id="appSidebarClose" class="app-sidebar-close" aria-label="Close navigation">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="app-sidebar-content">
        <div class="app-sidebar-group">
            <div class="app-sidebar-label">Workspace</div>

            <a href="<%= isAdmin ? '/admin/dashboard' : (isManager ? '/manager/dashboard' : '/dashboard') %>"
               class="app-sidebar-item <%= currentPage === 'dashboard' ? 'active' : '' %>" title="Dashboard">
                <i class="bi bi-grid-1x2 app-sidebar-icon"></i>
                <span>Dashboard</span>
            </a>

            <a href="/projects" class="app-sidebar-item <%= currentPage === 'projects' || currentPage === 'project' ? 'active' : '' %>" title="Projects">
                <i class="bi bi-folder2-open app-sidebar-icon"></i>
                <span>Projects</span>
            </a>

            <a href="/tasks" class="app-sidebar-item <%= currentPage === 'tasks' ? 'active' : '' %>" title="Tasks">
                <i class="bi bi-check2-square app-sidebar-icon"></i>
                <span>Tasks</span>
            </a>

            <a href="/meetings" class="app-sidebar-item <%= currentPage === 'meetings' ? 'active' : '' %>" title="Schedule">
                <i class="bi bi-calendar-event app-sidebar-icon"></i>
                <span>Schedule</span>
            </a>
        </div>

        <% if (isManager) { %>
            <div class="app-sidebar-group">
                <div class="app-sidebar-label">Management</div>
                <a href="/teams" class="app-sidebar-item <%= currentPage === 'teams' ? 'active' : '' %>" title="Teams">
                    <i class="bi bi-people app-sidebar-icon"></i>
                    <span>Teams</span>
                </a>
            </div>
        <% } %>

        <% if (isAdmin) { %>
            <div class="app-sidebar-group">
                <div class="app-sidebar-label">System</div>
                <a href="/admin/users" class="app-sidebar-item <%= currentPage === 'users' ? 'active' : '' %>" title="Users">
                    <i class="bi bi-people app-sidebar-icon"></i>
                    <span>Users</span>
                </a>
                <a href="/admin/teams-view" class="app-sidebar-item <%= currentPage === 'teams' ? 'active' : '' %>" title="Global Teams">
                    <i class="bi bi-microsoft-teams app-sidebar-icon"></i>
                    <span>Teams</span>
                </a>
                <a href="/admin/meetings" class="app-sidebar-item <%= currentPage === 'admin_meetings' ? 'active' : '' %>" title="All Meetings">
                    <i class="bi bi-calendar2-week app-sidebar-icon"></i>
                    <span>All Meetings</span>
                </a>
                <a href="/admin/activities" class="app-sidebar-item <%= currentPage === 'activities' ? 'active' : '' %>" title="Audit Logs">
                    <i class="bi bi-clock-history app-sidebar-icon"></i>
                    <span>Audit Logs</span>
                </a>
            </div>
        <% } %>
    </div>

    <div class="app-sidebar-bottom">
        <a href="/<%= role %>/profile" class="app-sidebar-item <%= currentPage === 'profile' ? 'active' : '' %>" title="Profile">
            <i class="bi bi-person-circle app-sidebar-icon"></i>
            <span>Profile</span>
        </a>
        <a href="/auth/logout" class="app-sidebar-item app-sidebar-logout" title="Logout">
            <i class="bi bi-box-arrow-right app-sidebar-icon"></i>
            <span>Logout</span>
        </a>
    </div>

    <div id="appSidebarBackdrop" class="app-sidebar-backdrop" aria-hidden="true"></div>
</aside>