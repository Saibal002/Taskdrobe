<!-- Statistics Section -->
<div class="dashboard-card dashboard-section">

    <div class="card-header bg-white border-0">

        <h5 class="mb-0 fw-bold">
            Dashboard Statistics
        </h5>

    </div>

    <div class="card-body">

        <div class="row g-3">

    <!-- Total Projects -->
    <div class="col-md-6 col-lg-4">

        <div class="dashboard-card stats-card">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted text-uppercase fw-semibold">
                        Total Projects
                    </small>

                    <h2 class="fw-bold mb-0">
                        <%= stats.totalProjects %>
                    </h2>

                </div>

                <div class="stats-icon bg-primary-subtle text-primary">

                    <i class="bi bi-folder2-open fs-3"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Active Projects -->
    <div class="col-md-6 col-lg-4">

        <div class="dashboard-card stats-card">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted text-uppercase fw-semibold">
                        Active Projects
                    </small>

                    <h2 class="fw-bold text-primary mb-0">
                        <%= stats.activeProjects %>
                    </h2>

                </div>

                <div class="stats-icon bg-primary-subtle text-primary">

                    <i class="bi bi-play-circle fs-3"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Total Tasks -->
    <div class="col-md-6 col-lg-4">

        <div class="dashboard-card stats-card">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted text-uppercase fw-semibold">
                        Total Tasks
                    </small>

                    <h2 class="fw-bold mb-0">
                        <%= stats.totalTasks %>
                    </h2>

                </div>

                <div class="stats-icon bg-info-subtle text-info">

                    <i class="bi bi-list-check fs-3"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Completed -->
    <div class="col-md-6 col-lg-4">

        <div class="dashboard-card stats-card">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted text-uppercase fw-semibold">
                        Completed
                    </small>

                    <h2 class="fw-bold text-success mb-0">
                        <%= stats.completedTasks %>
                    </h2>

                </div>

                <div class="stats-icon bg-success-subtle text-success">

                    <i class="bi bi-check-circle-fill fs-3"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Pending -->
    <div class="col-md-6 col-lg-4">

        <div class="dashboard-card stats-card">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted text-uppercase fw-semibold">
                        Pending
                    </small>

                    <h2 class="fw-bold text-warning mb-0">
                        <%= stats.pendingTasks %>
                    </h2>

                </div>

                <div class="stats-icon bg-warning-subtle text-warning">

                    <i class="bi bi-hourglass-split fs-3"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Overdue -->
    <div class="col-md-6 col-lg-4">

        <div class="dashboard-card stats-card">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted text-uppercase fw-semibold">
                        Overdue
                    </small>

                    <h2 class="fw-bold text-danger mb-0">
                        <%= stats.overdueTasks %>
                    </h2>

                </div>

                <div class="stats-icon bg-danger-subtle text-danger">

                    <i class="bi bi-exclamation-circle-fill fs-3"></i>

                </div>

            </div>

        </div>

    </div>

</div>

        <hr>

        <h6 class="fw-bold mb-2">

            Overall Completion

        </h6>

        <div class="progress" style="height: 12px;">

            <div class="progress-bar bg-success" role="progressbar" style="width: <%= stats.completionRate %>%">

            </div>

        </div>
        <hr class="my-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <h5 class="fw-bold mb-3">

                    Task Status
                    

                </h5>
                

                <div class="mx-auto" style="height:250px; max-width:320px;">

                    <canvas id="taskChart" data-completed="<%= stats.completedTasks %>"
                        data-pending="<%= stats.pendingTasks %>" data-overdue="<%= stats.overdueTasks %>"></canvas>

                </div>

            </div>

        </div>

        <small class="text-muted">

            <%= stats.completionRate %>% Completed

        </small>

    </div>

</div>