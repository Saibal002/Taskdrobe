<!-- Statistics Section -->
<div class="card border-0 shadow-sm mt-4">

    <div class="card-header bg-white border-0">

        <h5 class="mb-0 fw-bold">
            Dashboard Statistics
        </h5>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <!-- Total Projects -->
            <div class="col-md-6">

                <div class="card border-0 bg-light">

                    <div class="card-body">

                        <small class="text-muted">
                            Total Projects
                        </small>

                        <h3 class="fw-bold">
                            <%= stats.totalProjects %>
                        </h3>

                    </div>

                </div>

            </div>

            <!-- Active Projects -->
            <div class="col-md-6">

                <div class="card border-0 bg-light">

                    <div class="card-body">

                        <small class="text-muted">
                            Active Projects
                        </small>

                        <h3 class="fw-bold text-primary">
                            <%= stats.activeProjects %>
                        </h3>

                    </div>

                </div>

            </div>

            <!-- Total Tasks -->
            <div class="col-md-6">

                <div class="card border-0 bg-light">

                    <div class="card-body">

                        <small class="text-muted">
                            Total Tasks
                        </small>

                        <h3 class="fw-bold">
                            <%= stats.totalTasks %>
                        </h3>

                    </div>

                </div>

            </div>

            <!-- Completed Tasks -->
            <div class="col-md-6">

                <div class="card border-0 bg-light">

                    <div class="card-body">

                        <small class="text-muted">
                            Completed Tasks
                        </small>

                        <h3 class="fw-bold text-success">
                            <%= stats.completedTasks %>
                        </h3>

                    </div>

                </div>

            </div>

            <!-- Pending Tasks -->
            <div class="col-md-6">

                <div class="card border-0 bg-light">

                    <div class="card-body">

                        <small class="text-muted">
                            Pending Tasks
                        </small>

                        <h3 class="fw-bold text-warning">
                            <%= stats.pendingTasks %>
                        </h3>

                    </div>

                </div>

            </div>

            <!-- Overdue -->
            <div class="col-md-6">

                <div class="card border-0 bg-light">

                    <div class="card-body">

                        <small class="text-muted">
                            Overdue Tasks
                        </small>

                        <h3 class="fw-bold text-danger">
                            <%= stats.overdueTasks %>
                        </h3>

                    </div>

                </div>

            </div>

        </div>

        <hr>

        <h6 class="fw-bold mb-2">

            Overall Completion

        </h6>

        <div class="progress" style="height: 12px;">

            <div class="progress-bar bg-success" role="progressbar" style="width: <%= stats.completionRate %>%">

            </div>

        </div>
        <hr class="my-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <h5 class="fw-bold mb-3">

                    Task Status
                    

                </h5>
                <p class="text-muted small mb-4">

    Current task distribution

</p>

                <div class="mx-auto" style="height:250px; max-width:320px;">

                    <canvas id="taskChart" data-completed="<%= stats.completedTasks %>"
                        data-pending="<%= stats.pendingTasks %>" data-overdue="<%= stats.overdueTasks %>"></canvas>

                </div>

            </div>

        </div>

        <small class="text-muted">

            <%= stats.completionRate %>% Completed

        </small>

    </div>

</div>