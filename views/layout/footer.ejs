  </main>
  <footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">&copy; <%= new Date().getFullYear() %> MyApp. All rights reserved.</p>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- SweetAlert2 JS -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Custom Alerts JS -->
  <script src="/js/alerts.js"></script>

  <% if (success) { %>
<script>

Swal.fire({

    toast: true,
    position: "top-end",
    icon: "success",
    title: "<%= success %>",
    showConfirmButton: false,
    timer: 2500,
    timerProgressBar: true

});

</script>
<% } %>

<% if (error) { %>
<script>

Swal.fire({

    toast: true,
    position: "top-end",
    icon: "error",
    title: "<%= error %>",
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true

});

</script>
<% } %>
</body>
</html>