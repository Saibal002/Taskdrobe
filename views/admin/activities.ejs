<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body class="admin-dashboard-page app-sidebar-layout">

    <%- include("../layout/navBar", { user: user, page: "activities" }) %>
    <script src="/js/navBar.js"></script>

    <main class="app-page-main admin-main">
        <div class="admin-page-shell fade-in">
            
            <!-- Header -->
            <div class="admin-hero mb-4" style="padding: 2rem; border-radius: 20px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <div class="admin-hero-content">
                    <div class="admin-hero-badge bg-white bg-opacity-10 text-white mb-2 border border-light border-opacity-25">Security & Compliance</div>
                    <h1 class="text-white fw-bold mb-1">System Audit Logs</h1>
                    <p class="text-white opacity-75 mb-0">Immutable record of platform operations, mutations, and deletions.</p>
                </div>
            </div>

            <!-- =====================================================
                 FILTER TOOLBAR
            ===================================================== -->
            <% if (activities && activities.length > 0) { %>
                <div class="task-toolbar d-flex flex-wrap align-items-center gap-3 mb-4 p-3 rounded-4 shadow-sm bg-white border border-light">
                    <div class="input-group flex-grow-1" style="min-width: 200px;">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" id="logSearch" class="form-control border-start-0 bg-light" placeholder="Search by name, action, or entity...">
                    </div>
                    
                    <select id="roleFilter" class="form-select bg-light flex-grow-0 w-auto shadow-sm">
                        <option value="all">All Roles</option>
                        <option value="admin">Admin</option>
                        <option value="manager">Manager</option>
                        <option value="employee">Employee</option>
                    </select>

                    <div class="input-group flex-grow-0 w-auto shadow-sm">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-calendar"></i></span>
                        <input type="date" id="dateFilter" class="form-control border-start-0 bg-light" title="Filter by Date">
                    </div>

                    <button id="clearFilters" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                        <i class="fas fa-times"></i> Clear
                    </button>
                </div>
            <% } %>

            <!-- =====================================================
                 ACTIVITY TABLE
            ===================================================== -->
            <div class="admin-glass-panel border-0 shadow-sm rounded-4 overflow-hidden bg-white p-0" id="logsTableWrapper">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 custom-slick-table table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-muted small text-uppercase py-3 ps-4">Timestamp</th>
                                <th class="text-muted small text-uppercase py-3">Actor</th>
                                <th class="text-muted small text-uppercase py-3">Action</th>
                                <th class="text-muted small text-uppercase py-3">Target Entity</th>
                                <th class="text-muted small text-uppercase py-3 pe-4">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (activities && activities.length > 0) { %>
                                <% activities.forEach(log => { 
                                    let badgeColor = 'secondary';
                                    const action = String(log.action).toUpperCase();
                                    if (action === 'CREATE') badgeColor = 'success';
                                    if (action === 'UPDATE') badgeColor = 'primary';
                                    if (action === 'DELETE') badgeColor = 'danger';
                                    if (action === 'TOGGLE' || action === 'ASSIGN') badgeColor = 'warning text-dark';
                                    
                                    const dateObj = new Date(log.created_at);
                                    const dateStr = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                                    const timeStr = dateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                                    
                                    // Format YYYY-MM-DD for the HTML Date input comparison
                                    const isoDate = dateObj.toISOString().split('T')[0];
                                %>
                                    <tr class="log-row" 
                                        data-role="<%= log.role_name ? log.role_name.toLowerCase() : '' %>" 
                                        data-date="<%= isoDate %>"
                                        data-search="<%= (log.user_name + ' ' + log.action + ' ' + log.entity_type + ' ' + log.description).toLowerCase() %>">
                                        
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark"><%= dateStr %></div>
                                            <div class="small text-muted"><%= timeStr %></div>
                                        </td>
                                        
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <% if (log.profile_image) { %>
                                                    <img src="<%= log.profile_image %>" class="rounded-circle" width="32" height="32" style="object-fit: cover;">
                                                <% } else { %>
                                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center fw-bold text-secondary" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                        <%= log.user_name ? log.user_name.charAt(0).toUpperCase() : '?' %>
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <div class="fw-semibold text-dark"><%= log.user_name || 'Unknown User' %></div>
                                                    <div class="small text-muted text-capitalize"><%= log.role_name || 'User' %></div>
                                                </div>
                                            </div>
                                        </td>
                                        
                                        <td>
                                            <span class="badge bg-<%= badgeColor %> bg-opacity-10 text-<%= badgeColor.split(' ')[0] %> border border-<%= badgeColor.split(' ')[0] %> px-2 py-1 rounded-pill">
                                                <%= action %>
                                            </span>
                                        </td>
                                        
                                        <td>
                                            <div class="fw-medium text-dark"><%= log.entity_type %></div>
                                            <div class="small text-muted font-monospace">ID: <%= log.entity_id || 'N/A' %></div>
                                        </td>
                                        
                                        <td class="pe-4 text-secondary">
                                            <%= log.description %>
                                        </td>
                                    </tr>
                                <% }) %>
                                
                                <!-- Empty state for when filters hide all rows -->
                                <tr id="noLogsRow" class="d-none">
                                    <td colspan="5" class="text-center py-5">
                                        <i class="fas fa-filter fa-3x text-muted opacity-25 mb-3"></i>
                                        <h5 class="fw-bold text-secondary">No matching activity found</h5>
                                        <p class="text-muted">Try clearing or adjusting your search filters.</p>
                                    </td>
                                </tr>
                                
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <i class="fas fa-shield-halved fa-3x text-muted opacity-25 mb-3"></i>
                                        <h5 class="fw-bold text-secondary">No recorded activity</h5>
                                        <p class="text-muted">System logs will appear here once users begin interacting with the platform.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- =========================================================
         INSTANT FILTER SCRIPT
    ========================================================= -->
    <script>
        $(document).ready(function() {
            function filterLogs() {
                const searchTerm = $("#logSearch").val().toLowerCase();
                const roleFilter = $("#roleFilter").val().toLowerCase();
                const dateFilter = $("#dateFilter").val(); 
                let visibleCount = 0;

                $(".log-row").each(function() {
                    const $row = $(this);
                    const rowSearch = $row.attr("data-search");
                    const rowRole = $row.attr("data-role");
                    const rowDate = $row.attr("data-date");

                    const matchesSearch = rowSearch.includes(searchTerm);
                    const matchesRole = roleFilter === "all" || rowRole === roleFilter;
                    const matchesDate = !dateFilter || rowDate === dateFilter;

                    if (matchesSearch && matchesRole && matchesDate) {
                        $row.show();
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });

                if (visibleCount === 0) {
                    $("#noLogsRow").removeClass("d-none");
                } else {
                    $("#noLogsRow").addClass("d-none");
                }
            }

            $("#logSearch").on("input", filterLogs);
            $("#roleFilter, #dateFilter").on("change", filterLogs);
            
            $("#clearFilters").on("click", function() {
                $("#logSearch").val("");
                $("#roleFilter").val("all");
                $("#dateFilter").val("");
                filterLogs();
            });
        });
    </script>
    
    <%- include("../layout/footer") %>
</body>
</html>