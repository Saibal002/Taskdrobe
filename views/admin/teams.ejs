<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Global styles -->
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/manager_dashboard.css" rel="stylesheet">
</head>

<body class="admin-dashboard-page app-sidebar-layout">

    <%- include("../layout/navBar", { user: user, page: "teams" }) %>
    <script src="/js/navbar.js"></script>

    <main class="app-page-main admin-main">
        <div class="admin-page-shell fade-in">

            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <div class="admin-section-icon blue mb-3"><i class="fas fa-network-wired"></i></div>
                    <h2 class="fw-bold mb-1 text-primary">Global Teams</h2>
                    <p class="text-secondary mb-0">System-wide directory of all workspace groups.</p>
                </div>
            </div>

            <div class="admin-glass-panel">
                <div class="row g-4" id="fullTeamGrid">
                    <div class="col-12 text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Loading all teams...</p>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/adminTeamsAjax.js"></script>

</body>
</html>