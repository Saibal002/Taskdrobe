<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body class="admin-dashboard-page app-sidebar-layout">

    <!-- Unified Navbar (Handles Sidebar & Notifications) -->
    <%- include("../layout/navBar", { user: user, page: "dashboard" }) %>
    <script src="/js/navbar.js"></script>

    <!-- Main Content Area -->
    <main class="app-page-main admin-main">
        <div class="admin-page-shell fade-in">
            
            <!-- Admin Hero -->
            <div class="admin-hero mb-5">
                <div class="admin-hero-content">
                    <div class="admin-hero-badge">Administration</div>
                    <h1>System Overview</h1>
                    <p>Welcome back, <%= user.full_name %>. Here is the real-time operational status across TaskDrobe.</p>
                </div>
            </div>

            <!-- Platform Engagement Grid -->
            <div class="admin-section-header">
                <div class="admin-section-icon blue"><i class="fas fa-users"></i></div>
                <h4>Platform Engagement</h4>
            </div>
            
            <div class="admin-stat-grid mb-5">
                <div class="admin-stat-card blue">
                    <div class="admin-stat-content">
                        <span class="admin-stat-label">Total Users</span>
                        <strong class="admin-stat-value"><%= userStats.totalUsers %></strong>
                    </div>
                    <div class="admin-stat-bg-icon"><i class="fas fa-users"></i></div>
                </div>
                <div class="admin-stat-card purple">
                    <div class="admin-stat-content">
                        <span class="admin-stat-label">Active Users</span>
                        <strong class="admin-stat-value"><%= userStats.activeUsers %></strong>
                    </div>
                    <div class="admin-stat-bg-icon"><i class="fas fa-user-check"></i></div>
                </div>
                <div class="admin-stat-card dark">
                    <div class="admin-stat-content">
                        <span class="admin-stat-label">Inactive Users</span>
                        <strong class="admin-stat-value"><%= userStats.inactiveUsers %></strong>
                    </div>
                    <div class="admin-stat-bg-icon"><i class="fas fa-user-minus"></i></div>
                </div>
            </div>

            <!-- Project & Task Operations Grid -->
            <div class="admin-section-header">
                <div class="admin-section-icon green"><i class="fas fa-layer-group"></i></div>
                <h4>Operations & Productivity</h4>
            </div>
            
            <div class="admin-ops-grid mb-5">
                <!-- Project Breakdown -->
                <div class="admin-glass-panel h-100">
                    <h6 class="admin-panel-title">Project Status</h6>
                    <div class="admin-list-group">
                        <div class="admin-list-item">
                            <div class="admin-list-left">
                                <div class="admin-list-icon blue"><i class="fas fa-folder-open"></i></div>
                                <span>Total Projects</span>
                            </div>
                            <strong class="admin-list-value blue"><%= stats.totalProjects %></strong>
                        </div>
                        
                        <div class="admin-list-item">
                            <div class="admin-list-left">
                                <div class="admin-list-icon green"><i class="fas fa-spinner"></i></div>
                                <span>Active Projects</span>
                            </div>
                            <strong class="admin-list-value green"><%= stats.activeProjects %></strong>
                        </div>
                        
                        <div class="admin-list-item">
                            <div class="admin-list-left">
                                <div class="admin-list-icon dark"><i class="fas fa-check-double"></i></div>
                                <span>Completed Projects</span>
                            </div>
                            <strong class="admin-list-value dark"><%= stats.completedProjects %></strong>
                        </div>
                    </div>
                </div>

                <!-- Task KPI Block -->
                <div class="admin-tasks-grid h-100">
                    <div class="admin-stat-card green">
                        <div class="admin-stat-content">
                            <span class="admin-stat-label">Tasks Completed</span>
                            <strong class="admin-stat-value"><%= stats.completedTasks %></strong>
                            <span class="admin-stat-meta">Out of <%= stats.totalTasks %> total tasks</span>
                        </div>
                        <div class="admin-stat-bg-icon"><i class="fas fa-check-circle"></i></div>
                    </div>
                    
                    <div class="admin-stat-card orange">
                        <div class="admin-stat-content">
                            <span class="admin-stat-label">Tasks Pending</span>
                            <strong class="admin-stat-value"><%= stats.pendingTasks %></strong>
                        </div>
                        <div class="admin-stat-bg-icon"><i class="fas fa-clock"></i></div>
                    </div>
                    
                    <div class="admin-stat-card red span-full">
                        <div class="admin-stat-content split">
                            <div>
                                <span class="admin-stat-label">Critical / Overdue</span>
                                <strong class="admin-stat-value"><%= stats.overdueTasks %></strong>
                            </div>
                            <div class="admin-stat-divider">
                                <span class="admin-stat-label">Global Completion</span>
                                <strong class="admin-stat-value"><%= stats.completionRate %>%</strong>
                            </div>
                        </div>
                        <div class="admin-stat-bg-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    </div>
                </div>
            </div>

            <!-- Analytics / Charts -->
            <div class="admin-glass-panel">
                <div class="admin-panel-header">
                    <div>
                        <h5 class="admin-panel-heading"><i class="fas fa-chart-pie me-2 text-primary"></i>System Analytics</h5>
                        <p class="admin-panel-subtext">Visual distribution of tasks and project timelines</p>
                    </div>
                </div>
                
                <div class="admin-chart-container">
                    <%- include("../layout/charts") %>
                </div>
            </div>

        </div>
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Socket.IO is required by the navbar for system notifications -->
    <script src="/socket.io/socket.io.js"></script>
    
    <!-- Renders the Chart.js canvases -->
    <script src="/js/dashboard.js"></script>
</body>
</html>