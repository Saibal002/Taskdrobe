<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <!-- Reusing your dashboard CSS to keep the card styles perfectly consistent -->
    
    <link href="/css/manager_dashboard.css" rel="stylesheet"> 
</head>
<body class="app-sidebar-layout bg-light">

    <!-- Unified Navbar & Sidebar -->
    <%- include("layout/navBar", { user: user, page: "projects" }) %>
    <script src="/js/navbar.js"></script>

    <main class="main-content" style="padding-top: 80px; min-height: 100vh;">
        <div class="container-fluid px-4">
            
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-5 mt-3">
                <div>
                    <h1 class="h3 fw-bold mb-1 text-dark">All Projects</h1>
                    <p class="text-muted mb-0">Browse and manage projects available to your workspace.</p>
                </div>
                
                <!-- RBAC: Only Managers and Admins can create projects -->
                <% if (user.role_name === 'manager' || user.role_name === 'admin') { %>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addProjectModal">
                        <i class="bi bi-plus-lg me-2"></i> Add Project
                    </button>
                <% } %>
            </div>

            <!-- Unified Project Grid -->
            <div class="row g-4">
                <% if (projects && projects.length > 0) { %>
                    <% projects.forEach((project, index) => { 
                        const progress = Math.min(100, Math.max(0, Number(project.progress || 0)));
                        const status = project.status || "Not started";
                        // Cycle through your existing dashboard card colors
                        const colorClass = ["project-card-navy", "project-card-teal", "project-card-coral"][index % 3];
                        const deadlineDate = project.deadline ? new Date(project.deadline).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "No deadline";
                    %>
                        <div class="col-12 col-md-6 col-xl-4">
                            <a class="project-card project-card-link <%= colorClass %> h-100 d-flex flex-column text-decoration-none" href="/projects/<%= project.project_id %>">
                                
                                <div class="project-card-topline mb-3">
                                    <span class="project-status"><%= status %></span>
                                    <span class="project-arrow"><i class="bi bi-arrow-up-right"></i></span>
                                </div>
                                
                                <h3 class="fs-5 fw-bold mb-2"><%= project.project_name %></h3>
                                <p class="project-description flex-grow-1 opacity-75 small">
                                    <%= project.description || "No description provided." %>
                                </p>
                                
                                <div class="project-progress-meta mt-4 mb-2 d-flex justify-content-between small fw-bold">
                                    <span>Progress</span>
                                    <span><%= progress %>%</span>
                                </div>
                                
                                <div class="progress project-progress mb-4" style="height: 6px; background-color: rgba(255,255,255,0.2);">
                                    <div class="progress-bar bg-white" style="width: <%= progress %>%"></div>
                                </div>
                                
                                <div class="project-card-footer mt-auto border-top border-light border-opacity-25 pt-3 d-flex justify-content-between small">
                                    <span><i class="bi bi-person-circle me-1"></i> <%= project.full_name %></span>
                                    <span><i class="bi bi-calendar-event me-1"></i> <%= deadlineDate %></span>
                                </div>
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <!-- Empty State -->
                    <div class="col-12">
                        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light mt-4">
                            <i class="bi bi-folder-x display-1 text-muted mb-3 d-block opacity-50"></i>
                            <h4 class="fw-bold text-dark">No projects found</h4>
                            <p class="text-muted">You do not have access to any active projects right now.</p>
                        </div>
                    </div>
                <% } %>
            </div>
            
        </div>
    </main>

    <!-- Modals & Scripts -->
    <% if (user.role_name === 'manager' || user.role_name === 'admin') { %>
        <%- include("layout/addProjectModal") %>
    <% } %>
    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>