<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Global Styles -->
    <link href="/css/style.css" rel="stylesheet">
    <!-- Using Manager Dashboard CSS for the native project grid architecture -->
    <link href="/css/manager_dashboard.css" rel="stylesheet">
</head>

<!-- Added manager-dashboard-page to trigger the radial gradient in dark mode -->
<body class="manager-dashboard-page app-sidebar-layout">

    <!-- Unified Navbar & Sidebar -->
    <%- include("layout/navBar", { user: user, page: "projects" }) %>
    <script src="/js/navBar.js"></script>

    <main class="manager-main">
        <div class="manager-container px-4 mt-5">
            
          <header class="section-heading mt-2 mb-4">
                <div>
                    <!-- Dynamic Kicker -->
                    <p class="section-kicker">
                        <%= user.role_name === 'admin' ? 'Global Workspace' : (user.role_name === 'manager' ? 'Management' : 'Your Workspace') %>
                    </p>
                    
                    <!-- Dynamic Title -->
                    <h2>
                        <%= user.role_name === 'admin' ? 'All Projects' : (user.role_name === 'manager' ? 'Projects You Manage' : 'Your Assigned Projects') %>
                    </h2>
                </div>
                
                <!-- RBAC: Only Managers can create projects -->
                <% if (user.role_name === 'manager' ) { %>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background: var(--accent-primary); border: none;" data-bs-toggle="modal" data-bs-target="#addProjectModal">
                        <i class="bi bi-plus-lg me-2"></i> Add Project
                    </button>
                <% } %>
            </header>

            <!-- Unified Project Grid -->
            <% if (projects && projects.length > 0) { %>
                <div class="manager-project-grid">
                    <% projects.forEach((project) => { 
                        const progress = Math.min(100, Math.max(0, Number(project.progress || 0)));
                        const status = project.status || "Not started";
                        const statusClass = status.toLowerCase().replace(" ", "-");
                        const deadlineDate = project.deadline ? new Date(project.deadline).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "No deadline";
                    %>
                        <a href="/projects/<%= project.project_id %>" class="manager-project-link text-decoration-none">
                            <div class="manager-project-card">
                                
                                <div class="manager-project-top">
                                    <span class="manager-project-status <%= statusClass %>">
                                        <span></span> <%= status %>
                                    </span>
                                    <div class="manager-project-actions">
                                        <div class="manager-project-action"><i class="bi bi-arrow-up-right"></i></div>
                                    </div>
                                </div>
                                
                                <div class="manager-project-body mt-2">
                                    <h3><%= project.project_name %></h3>
                                    <p><%= project.description || "No description provided." %></p>
                                </div>
                                
                                <div class="manager-progress-track mt-auto">
                                    <div class="manager-progress-fill" style="width: <%= progress %>%"></div>
                                </div>
                                
                                <div class="d-flex justify-content-between mt-3 text-muted small fw-bold">
                                    <span><i class="bi bi-person me-1"></i> <%= project.full_name %></span>
                                    <span><i class="bi bi-calendar-event me-1"></i> <%= deadlineDate %></span>
                                </div>
                                
                            </div>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <!-- Empty State -->
                <div class="manager-panel text-center py-5 mt-4">
                    <i class="bi bi-folder-x display-1 text-muted mb-3 d-block opacity-50"></i>
                    <h4 class="fw-bold text-dark">No projects available</h4>
                    <p class="text-muted">You do not currently have access to any active projects.</p>
                </div>
            <% } %>
            
        </div>
    </main>

    <!-- Modals & Scripts -->
    <% if (user.role_name === 'manager' || user.role_name === 'admin') { %>
        <%- include("layout/addProjectModal") %>
    <% } %>
    
<!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Real-time Sockets & Global Chat -->
    <script src="/socket.io/socket.io.js"></script>
    <%- include("layout/globalChat") %>
    
    <!-- Form AJAX (Fetches teams for Add Project modal) -->
    <script src="/js/sharedTeamsAjax.js"></script>
</body>
</html>