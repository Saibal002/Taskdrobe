<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">
    <link href="/css/project.css" rel="stylesheet">
</head>
<body>

    <%- include("../layout/header") %>

    <h1>Manager Dashboard</h1>

    <p>
        Welcome, <%= user.full_name %>
    </p>

    <p>
        Role:
        <%= user.role_name %>
    </p>

    <!-- Manager Project Statistics -->
    <div class="container mt-4 mb-5">

        <div class="d-flex align-items-center justify-content-between mb-4">

            <div>
                <h3 class="fw-bold mb-1">
                    Project Overview
                </h3>

                <p class="text-muted mb-0">
                    Overview of projects you manage
                </p>
            </div>

        </div>


        <div class="row g-4">

            <!-- Total Projects -->
            <div class="col-md-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted mb-2">
                            Total Projects
                        </h6>

                        <h2 class="fw-bold mb-0">
                            <%= projectStats.totalProjects %>
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Active Projects -->
            <div class="col-md-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted mb-2">
                            Active Projects
                        </h6>

                        <h2 class="fw-bold text-primary mb-0">
                            <%= projectStats.activeProjects %>
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Completed Projects -->
            <div class="col-md-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted mb-2">
                            Completed
                        </h6>

                        <h2 class="fw-bold text-success mb-0">
                            <%= projectStats.completedProjects %>
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Average Progress -->
            <div class="col-md-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted mb-2">
                            Average Progress
                        </h6>

                        <h2 class="fw-bold mb-0">
                            <%= projectStats.averageProgress %>%
                        </h2>

                    </div>

                </div>

            </div>

        </div>

    </div>
<!-- Manager Projects -->
<div class="container mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                My Projects
            </h3>

            <p class="text-muted mb-0">
                Create and manage the projects you own.
            </p>
        </div>

        <button
            class="btn btn-primary rounded-pill px-4"
            data-bs-toggle="modal"
            data-bs-target="#addProjectModal">

            <i class="bi bi-plus-lg me-2"></i>
            New Project

        </button>

    </div>


    <% if (!projects || projects.length === 0) { %>

        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-folder-x display-5 text-muted"></i>

                <h5 class="mt-3">
                    No projects yet
                </h5>

                <p class="text-muted">
                    Create your first project to get started.
                </p>

            </div>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% projects.forEach(project => { %>

                <div class="col-md-6 col-xl-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        <%= project.project_name %>
                                    </h5>

                                    <small class="text-muted">
                                        <%= project.status %>
                                    </small>
                                </div>

                                <div class="dropdown">

                                    <button
                                        class="btn btn-sm btn-light"
                                        data-bs-toggle="dropdown">

                                        <i class="bi bi-three-dots-vertical"></i>

                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">

                                        <li>
                                            <a
                                                class="dropdown-item"
                                                href="/projects/<%= project.project_id %>">

                                                <i class="bi bi-eye me-2"></i>
                                                View Project

                                            </a>
                                        </li>

                                        <li>
                                            <button
                                                class="dropdown-item"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editProjectModal-<%= project.project_id %>">

                                                <i class="bi bi-pencil me-2"></i>
                                                Edit Project

                                            </button>
                                        </li>

                                        <li>
                                            <a
                                                class="dropdown-item"
                                                href="/manager/projects/<%= project.project_id %>/members">

                                                <i class="bi bi-people me-2"></i>
                                                Manage Members

                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>

                                        <li>

                                            <form
                                                action="/projects/<%= project.project_id %>/delete"
                                                method="POST"
                                                onsubmit="return confirm('Delete this project?')">

                                                <button
                                                    type="submit"
                                                    class="dropdown-item text-danger">

                                                    <i class="bi bi-trash me-2"></i>
                                                    Delete Project

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>

                            </div>


                            <p class="text-muted small mt-3">

                                <%= project.description ||
                                    "No description available." %>

                            </p>


                            <!-- Progress -->

                            <div class="d-flex justify-content-between mb-2">

                                <small class="text-muted">
                                    Progress
                                </small>

                                <small class="fw-semibold">
                                    <%= project.progress %>%
                                </small>

                            </div>

                            <div class="progress mb-3"
                                style="height: 8px;">

                                <div
                                    class="progress-bar"
                                    style="width: <%= project.progress %>%;">
                                </div>

                            </div>


                            <!-- Deadline -->

                            <div class="small text-muted">

                                <i class="bi bi-calendar-event me-1"></i>

                                <%= project.deadline
                                    ? new Date(project.deadline).toLocaleDateString()
                                    : "No deadline" %>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Edit Project Modal -->

                <%- include("../layout/editProjectModal", {
                    project
                }) %>


            <% }) %>

        </div>

    <% } %>

</div>


<!-- Add Project Modal -->

<%- include("../layout/addProjectModal") %>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
        integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
        crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/dashboard.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</body>

</html>