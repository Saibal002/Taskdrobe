<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">
    <link href="/css/project.css" rel="stylesheet">
</head>
<body>

    <%- include("../layout/navBar") %>

    <div class="container-fluid">
        <div class="row">

            <%- include("../layout/sideBar") %>

            <!-- Main Content Area -->
            <main class="col-lg-9 col-xl-10 ms-sm-auto px-4 main-content">
                
                <!-- Your Existing Partials -->
                <%- include("../layout/welcome", { stats: projectStats }) %>
<%- include("../layout/projectCarousel") %>
<%- include("../layout/statistics", { stats: projectStats }) %>

            </main>
        </div>
    </div>

    <!-- 
      THE MODAL FLICKER FIX:
      Render all Add/Edit modals down here, completely outside the main layout grid 
      and away from any 'overflow-x' carousel containers. 
    -->
    <%- include("../layout/addProjectModal") %>
    
    <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
            <%- include("../layout/editProjectModal", { project }) %>
        <% }) %>
    <% } %>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/dashboard.js"></script>

    <!-- Carousel Scroll Logic -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const scrollContainer = document.getElementById('projectScrollContainer');
            const leftBtn = document.getElementById('scrollLeftBtn');
            const rightBtn = document.getElementById('scrollRightBtn');
            
            if (scrollContainer && leftBtn && rightBtn) {
                const scrollAmount = 364; 

                leftBtn.addEventListener('click', () => {
                    scrollContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                });

                rightBtn.addEventListener('click', () => {
                    scrollContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });
            }
        });
    </script>
    <script>

    // =========================================================
    // PROJECT CARD NAVIGATION
    // =========================================================

    $(document).on(
        "click",
        ".project-card-link",
        function (event) {

            // Do not navigate when Delete was clicked
            if (
                $(event.target)
                    .closest(".project-edit-btn, .project-delete-btn")
                    .length
            ) {
                return;
            }

            const projectUrl =
                $(this).data("project-url");

            if (projectUrl) {

                window.location.href =
                    projectUrl;

            }

        }
    );


    // Keyboard accessibility
    $(document).on(
        "keydown",
        ".project-card-link",
        function (event) {

            if (
                event.key !== "Enter" &&
                event.key !== " "
            ) {
                return;
            }

            if (
                $(event.target)
                    .closest(".project-delete-btn")
                    .length
            ) {
                return;
            }

            event.preventDefault();

            const projectUrl =
                $(this).data("project-url");

            if (projectUrl) {

                window.location.href =
                    projectUrl;

            }

        }
    );


    // =========================================================
    // DELETE PROJECT
    // =========================================================

    $(document).on(
        "click",
        ".project-delete-btn",
        function (event) {

            event.preventDefault();
            event.stopPropagation();

            const button =
                $(this);

            const projectId =
                button.data("project-id");


            if (!projectId) {

                alert(
                    "Project ID is missing."
                );

                return;

            }


            const confirmed =
                window.confirm(
                    "Are you sure you want to delete this project?"
                );


            if (!confirmed) {

                return;

            }


            button
                .prop("disabled", true)
                .html(
                    '<span class="spinner-border spinner-border-sm me-1"></span>Deleting...'
                );


            $.ajax({

                url:
                    `/projects/${projectId}/delete`,

                type:
                    "POST",

                headers: {
                    "X-Requested-With":
                        "XMLHttpRequest"
                },

                success:
                    function (response) {

                        if (
                            !response ||
                            !response.success
                        ) {

                            button
                                .prop(
                                    "disabled",
                                    false
                                )
                                .html(
                                    '<i class="bi bi-trash me-1"></i>Delete'
                                );

                            alert(
                                response?.message ||
                                "Unable to delete project."
                            );

                            return;

                        }


                        const card =
                            button.closest(
                                ".project-card-link"
                            );


                        card.fadeOut(
                            250,
                            function () {

                                $(this).remove();

                                // If no project cards remain
                                const remainingCards =
                                    $("#projectScrollContainer")
                                        .find(".project-card-link")
                                        .length;

                                if (
                                    remainingCards === 0
                                ) {

                                    $("#projectScrollContainer")
                                        .html(`
                                            <div class="text-center text-muted w-100 py-5">
                                                <i class="bi bi-folder-x display-5 d-block mb-3"></i>
                                                <h5 class="mb-1">
                                                    No projects yet.
                                                </h5>
                                                <p class="mb-0">
                                                    Create your first project to get started.
                                                </p>
                                            </div>
                                        `);

                                }

                            }
                        );

                    },


                error:
                    function (xhr) {

                        button
                            .prop(
                                "disabled",
                                false
                            )
                            .html(
                                '<i class="bi bi-trash me-1"></i>Delete'
                            );


                        let message =
                            "Unable to delete project.";


                        if (
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {

                            message =
                                xhr.responseJSON.message;

                        }


                        alert(message);

                    }

            });

        }
    );

</script>
</body>
</html>