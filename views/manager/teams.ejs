<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>
    
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom Styles -->
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/manager_dashboard.css" rel="stylesheet">
</head>
<body class="manager-dashboard-page" style="background-color: #f8fafc;">

    <!-- Navigation -->
    <%- include("../layout/sideBar") %>
    <%- include("./partials/managerNavBar") %>

    <main class="manager-main">
        <div class="manager-container">
            
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <span class="fw-bold" style="color: #7c3aed; font-size: 0.85rem; letter-spacing: 1px;">DIRECTORY</span>
                    <h1 class="fw-bold text-dark mb-1">Teams</h1>
                    <p class="text-muted mb-0">Manage your workspace groups and assign members.</p>
                </div>
                <button type="button" class="btn text-white px-4 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#addTeamModal">
                    <i class="bi bi-plus-lg me-2"></i> New Team
                </button>
            </div>

            <!-- Dynamic Team Grid -->
            <div class="row g-4" id="fullTeamGrid">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" style="color: #4f46e5 !important;" role="status"></div>
                    <p class="text-muted mt-2 fw-bold">Loading teams...</p>
                </div>
            </div>

        </div>
    </main>

    <!-- Modals -->
    <%- include("../layout/addTeamModal") %>
    
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/managerDashboard.js"></script>
    <script src="/js/managerTeamsAjax.js"></script>
    
</body>
</html>