<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | TaskDrobe
    </title>


    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
        rel="stylesheet">


    <!-- Global styles -->
    <link
        href="/css/style.css"
        rel="stylesheet">


    <!-- Manager design system -->
    <link
        href="/css/manager_dashboard.css"
        rel="stylesheet">

</head>


<body class="manager-dashboard-page">


    <!-- Manager Sidebar -->
    <%- include("../layout/sideBar") %>


    <!-- Manager Navbar -->
    <%- include("./partials/managerNavBar") %>


    <!-- Main -->
    <main class="manager-main">

        <div class="manager-container">


            <!-- Page Context -->
            <div class="manager-page-context">

                <div>

                    <span>
                        Directory
                    </span>

                    <strong>
                        Teams
                    </strong>

                </div>


                <div>

                    <button
                        type="button"
                        class="manager-primary-button"
                        data-bs-toggle="modal"
                        data-bs-target="#addTeamModal">

                        <i class="bi bi-plus-lg"></i>

                        New Team

                    </button>

                </div>

            </div>


            <!-- Teams Panel -->
            <section class="manager-panel">

                <div class="manager-panel-header">

                    <div>

                        <span class="manager-section-eyebrow">
                            PEOPLE
                        </span>

                        <h2>
                            Your teams
                        </h2>

                        <p>
                            Manage your workspace groups and assign members.
                        </p>

                    </div>

                </div>


                <!-- Dynamic Team Grid -->
                <div
                    class="manager-team-directory"
                    id="fullTeamGrid">

                    <div class="manager-team-loading">

                        <div
                            class="spinner-border spinner-border-sm"
                            role="status">
                        </div>

                        <span>
                            Loading teams...
                        </span>

                    </div>

                </div>

            </section>


        </div>

    </main>


    <!-- Add Team Modal -->
    <%- include("../layout/addTeamModal") %>


    <!-- Libraries -->
    <script
        src="https://code.jquery.com/jquery-3.7.1.min.js">
    </script>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Manager JavaScript -->
    <script
        src="/js/managerDashboard.js">
    </script>

    <script
        src="/js/managerTeamsAjax.js">
    </script>

</body>

</html>