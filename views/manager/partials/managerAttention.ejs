<section class="manager-panel">

    <div class="manager-panel-header">

        <div>
            <span class="manager-section-eyebrow">
                PRIORITY
            </span>

            <h2>
                Attention required
            </h2>

            <p>
                Items that may need your attention.
            </p>
        </div>

    </div>


    <div class="manager-attention-list">

        <% items.forEach(item => { %>

            <a
                href="<%= item.action %>"
                class="manager-attention-item <%= item.tone %>">

                <div class="manager-attention-icon">
                    <i class="bi <%= item.icon %>"></i>
                </div>


                <div class="manager-attention-content">

                    <strong>
                        <%= item.title %>
                    </strong>

                    <span>
                        <%= item.text %>
                    </span>

                </div>


                <i class="bi bi-chevron-right manager-attention-arrow"></i>

            </a>

        <% }) %>

    </div>

</section>