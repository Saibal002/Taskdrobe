<section class="manager-panel manager-team-overview-panel">
    <div class="manager-panel-header">
        <div>
            <span class="manager-section-eyebrow">PEOPLE</span>
            <h2>Team overview</h2>
            <p>A quick look at your active teams.</p>
        </div>

        <button
            type="button"
            class="manager-primary-button manager-create-team-button"
            data-bs-toggle="modal"
            data-bs-target="#addTeamModal">
            <i class="bi bi-plus-lg"></i>
            Create Team
        </button>
    </div>

    <!-- AJAX Container: keep this ID unchanged -->
    <div id="managerTeamListContainer" class="manager-team-list">
        <div class="manager-team-loading">
            <div class="spinner-border" role="status" aria-label="Loading teams"></div>
            <span>Loading your teams...</span>
        </div>
    </div>

    <div class="manager-team-footer">
        <span class="manager-team-count" id="managerTeamCount"></span>

        <a href="/manager/teams" class="manager-text-button">
            View all teams
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</section>
