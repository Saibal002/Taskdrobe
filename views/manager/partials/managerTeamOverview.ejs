<section class="manager-panel border-0 shadow-sm rounded-4">
    <div class="manager-panel-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="manager-section-eyebrow fw-bold" style="color: #7c3aed;">PEOPLE</span>
            <h2 class="fw-bold text-dark">Team overview</h2>
            <p class="text-muted">A quick look at your active teams.</p>
        </div>
        
        <button type="button" class="btn text-white px-4 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#addTeamModal">
            <i class="bi bi-plus-lg me-1"></i> Create Team
        </button>
    </div>

    <!-- AJAX Container -->
    <div id="managerTeamListContainer" class="manager-team-list d-flex flex-column gap-3">
        <div class="text-center py-4 text-muted">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <p>Loading your teams...</p>
        </div>
    </div>

  <!-- Replace your current footer div with this -->
    <div class="mt-4 pt-3 text-center border-top">
        <a href="/manager/teams" class="text-decoration-none fw-bold" style="color: #4f46e5;">
            View All Teams <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>