<%
    const completedTasks = Number(stats.completedTasks || 0);
    const pendingTasks = Number(stats.pendingTasks || 0);
    const overdueTasks = Number(stats.overdueTasks || 0);
    const completionRate = Number(stats.completionRate || 0);
    const totalTasks = Number(stats.totalTasks || 0);
%>

<section class="manager-panel manager-task-panel">

    <div class="manager-panel-header">

        <div>
            <span class="manager-section-eyebrow">
                TASKS
            </span>

            <h2>
                Task overview
            </h2>

            <p>
                Current task distribution.
            </p>
        </div>

    </div>


    <div class="manager-task-chart-wrapper">

        <canvas
            id="taskChart"
            data-completed="<%= completedTasks %>"
            data-pending="<%= pendingTasks %>"
            data-overdue="<%= overdueTasks %>">
        </canvas>

        <div class="manager-chart-center">

            <strong>
                <%= totalTasks %>
            </strong>

            <span>
                Total Tasks
            </span>

        </div>

    </div>


    <div class="manager-task-legend">

        <div class="manager-legend-item">

            <span class="manager-legend-dot completed"></span>

            <div>
                <strong>
                    <%= completedTasks %>
                </strong>

                <span>
                    Completed
                </span>
            </div>

        </div>


        <div class="manager-legend-item">

            <span class="manager-legend-dot pending"></span>

            <div>
                <strong>
                    <%= pendingTasks %>
                </strong>

                <span>
                    Pending
                </span>
            </div>

        </div>


        <div class="manager-legend-item">

            <span class="manager-legend-dot overdue"></span>

            <div>
                <strong>
                    <%= overdueTasks %>
                </strong>

                <span>
                    Overdue
                </span>
            </div>

        </div>

    </div>


    <div class="manager-completion-summary">

        <div>

            <span>
                Overall completion
            </span>

            <strong>
                <%= completionRate %>%
            </strong>

        </div>

        <div class="manager-progress-track">

            <div
                class="manager-progress-fill teal"
                style="width: <%= Math.min(100, Math.max(0, completionRate)) %>%">
            </div>

        </div>

    </div>

</section>