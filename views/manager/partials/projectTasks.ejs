<!-- =========================================================
     PROJECT TASKS
========================================================= -->
<section
    id="projectTasksSection"
    data-tasks-url="/tasks/project/<%= project.project_id %>/data"
    data-project-id="<%= project.project_id %>"
    data-user-id="<%= user.user_id %>"
    data-user-role="<%= user.role_name %>"
    class="mt-5 pt-3">

    <!-- =====================================================
         HEADER
    ===================================================== -->
    <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
        <div>
            <div class="project-section-eyebrow mb-1">Execution</div>
            <h3 class="project-section-title mb-0">Project Tasks</h3>
        </div>

        <button
            type="button"
            class="btn btn-theme rounded-pill px-4"
            data-bs-toggle="modal"
            data-bs-target="#addTaskModal">
            <i class="fas fa-plus me-2"></i> Add New Task
        </button>
    </div>

    <!-- =====================================================
         AJAX MESSAGE
    ===================================================== -->
    <div id="projectTasksMessage" class="alert d-none rounded-pill text-center shadow-sm" role="alert"></div>

    <!-- =====================================================
         TASK LIST
    ===================================================== -->
    <!-- TASK CONTROLS TOOLBAR -->
<div class="task-toolbar d-flex flex-wrap align-items-center gap-3 mb-4 p-3 rounded-4 shadow-sm">
    <div class="input-group flex-grow-1" style="min-width: 250px;">
        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="fas fa-search"></i></span>
        <input type="text" id="taskSearchInput" class="form-control border-start-0" placeholder="Search tasks by title...">
    </div>
    
    <select id="taskStatusFilter" class="form-select flex-grow-0 w-auto">
        <option value="all">All Statuses</option>
        <option value="To Do">To Do</option>
        <option value="In Progress">In Progress</option>
        <option value="Completed">Completed</option>
    </select>

    <select id="taskPriorityFilter" class="form-select flex-grow-0 w-auto">
        <option value="all">All Priorities</option>
        <option value="Critical">Critical</option>
        <option value="High">High</option>
        <option value="Medium">Medium</option>
        <option value="Low">Low</option>
    </select>

    <button id="taskSortBtn" class="btn btn-outline-theme d-flex align-items-center gap-2">
        <i class="fas fa-calendar-day"></i> 
        <span>Due Date</span>
        <i class="fas fa-sort" id="sortIcon"></i>
    </button>
</div>

<!-- SLICK TABLE LAYOUT -->
<div class="table-responsive task-table-wrapper rounded-4 shadow-sm mb-4">
    <table class="table custom-slick-table align-middle mb-0">
        <thead>
            <tr>
                <th scope="col" style="width: 5%;">Status</th>
                <th scope="col" style="width: 35%;">Task Details</th>
                <th scope="col" style="width: 15%;">Priority</th>
                <th scope="col" style="width: 15%;">Assignee</th>
                <th scope="col" style="width: 15%;">Due Date</th>
                <th scope="col" style="width: 15%; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody id="projectTasksTbody" aria-live="polite">
            <tr>
                <td colspan="6" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading tasks...</span>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- PAGINATION -->
<div id="taskPagination" class="d-flex justify-content-end"></div>
</section>


<!-- =========================================================
     TASK AJAX
========================================================= -->

<script>
$(document).ready(function () {

    /* =========================================================
       PROJECT TASKS - jQuery AJAX
    ========================================================= */

    const $section =
        $("#projectTasksSection");

    if (!$section.length) {
        return;
    }


    const $taskList =
        $("#projectTasksList");

    const $message =
        $("#projectTasksMessage");


    const tasksUrl =
        $section.attr("data-tasks-url");


    const projectId =
        String(
            $section.attr("data-project-id")
        );


    const currentUserId =
        String(
            $section.attr("data-user-id")
        );


    const currentUserRole =
        $section.attr("data-user-role");


    const isManager =
        currentUserRole === "manager";


    /* =========================================================
       HELPERS
    ========================================================= */

    function escapeHtml(value) {

        return $("<div>")
            .text(
                value == null
                    ? ""
                    : String(value)
            )
            .html();
    }


    function getErrorMessage(
        xhr,
        fallback
    ) {

        if (
            xhr.responseJSON &&
            xhr.responseJSON.message
        ) {
            return xhr.responseJSON.message;
        }

        return fallback;
    }


    function showMessage(
        message,
        type = "success"
    ) {

        $message
            .removeClass(
                "d-none alert-success alert-danger alert-warning alert-info"
            )
            .addClass(
                "alert-" + type
            )
            .text(message);
    }


    function clearMessage() {

        $message
            .addClass("d-none")
            .removeClass(
                "alert-success alert-danger alert-warning alert-info"
            )
            .text("");
    }


    function showLoading() {

        $taskList.html(`
            <div class="col-12">

                <div class="text-center py-5">

                    <div
                        class="spinner-border text-primary"
                        role="status">

                        <span class="visually-hidden">
                            Loading tasks...
                        </span>

                    </div>

                    <p class="text-muted mt-2 mb-0">
                        Loading tasks...
                    </p>

                </div>

            </div>
        `);
    }


    function showTaskError(message) {

        $taskList.html(`
            <div class="col-12">

                <div class="text-center py-5">

                    <i
                        class="fas fa-triangle-exclamation
                               fa-2x
                               text-danger
                               mb-3">
                    </i>

                    <h5>
                        Unable to load tasks
                    </h5>

                    <p class="text-muted">
                        ${escapeHtml(message)}
                    </p>

                    <button
                        type="button"
                        class="btn btn-outline-primary btn-sm"
                        id="retryTasksBtn">

                        <i class="fas fa-rotate-right me-1"></i>
                        Try Again

                    </button>

                </div>

            </div>
        `);
    }


    function formatDate(value) {

        if (!value) {
            return "No Due Date";
        }

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return "No Due Date";
        }

        return date.toLocaleDateString();
    }


    function formatDateForInput(value) {

        if (!value) {
            return "";
        }

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return "";
        }

        return date.toISOString().split("T")[0];
    }

function getPriorityClass(priority) {
        switch (priority) {
            case "Critical": return "priority-critical";
            case "High": return "priority-high";
            case "Medium": return "priority-medium";
            default: return "priority-default";
        }
    }


    /*
     * Controllers that still return a redirect/HTML can be
     * tolerated here. JSON is preferred, but the DB operation
     * has already happened, so we refresh the task list.
     */
    function normalizeMutationResponse(response) {

        if (
            response &&
            typeof response === "object"
        ) {
            return response;
        }

        if (typeof response === "string") {

            try {
                return JSON.parse(response);
            } catch (error) {

                return {
                    success: true,
                    legacyHtmlResponse: true
                };
            }
        }

        return {};
    }


   /* =========================================================
       RENDER TASKS (Premium Look)
    ========================================================= */
   /* =========================================================
       STATE MANAGEMENT
    ========================================================= */
  /* =========================================================
       STATE MANAGEMENT
    ========================================================= */
    let allProjectTasks = [];
    let currentPage = 1;
    const tasksPerPage = 8;
    
    // Filter State
    let searchFilter = "";
    let statusFilter = "all";
    let priorityFilter = "all";
    let dateSortAsc = true; // true = earliest first, false = latest first

    /* =========================================================
       RENDER TABLE ENGINE
    ========================================================= */
    function renderTable() {
        const $tbody = $("#projectTasksTbody");
        const $pagination = $("#taskPagination");

        // 1. Filter
        let processedTasks = allProjectTasks.filter(task => {
            const matchesSearch = (task.title || "").toLowerCase().includes(searchFilter) || 
                                  (task.description || "").toLowerCase().includes(searchFilter);
            const matchesStatus = statusFilter === "all" || task.status === statusFilter;
            const matchesPriority = priorityFilter === "all" || task.priority === priorityFilter;
            
            return matchesSearch && matchesStatus && matchesPriority;
        });

        // 2. Sort by Due Date
        processedTasks.sort((a, b) => {
            const dateA = a.due_date ? new Date(a.due_date).getTime() : Infinity; // Unset dates go to bottom
            const dateB = b.due_date ? new Date(b.due_date).getTime() : Infinity;
            
            if (dateA === dateB) return 0;
            return dateSortAsc ? (dateA - dateB) : (dateB - dateA);
        });

        // 3. Paginate
        const totalPages = Math.ceil(processedTasks.length / tasksPerPage) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        
        const startIndex = (currentPage - 1) * tasksPerPage;
        const endIndex = startIndex + tasksPerPage;
        const paginatedTasks = processedTasks.slice(startIndex, endIndex);

        // 4. Render Rows
        if (paginatedTasks.length === 0) {
            $tbody.html(`
                <tr>
                    <td colspan="6" class="text-center py-5">
                        <div class="mb-3"><i class="fas fa-inbox fa-3x text-muted" style="opacity: 0.3;"></i></div>
                        <h6 class="fw-bold text-secondary">No tasks match your criteria</h6>
                    </td>
                </tr>
            `);
            $pagination.empty();
            return;
        }

        let html = "";
        $.each(paginatedTasks, function (index, task) {
            const taskId = String(task.task_id);
            const isTaskCreator = String(task.created_by) === currentUserId;
            const isTaskAssignee = task.assigned_to && String(task.assigned_to) === currentUserId;
            const canEdit = isManager || isTaskCreator;
            const canDelete = isManager || isTaskCreator;
            const canChangeStatus = isManager || isTaskCreator || isTaskAssignee;

            const title = escapeHtml(task.title || "");
            const description = escapeHtml(task.description || "No description");
            const priority = escapeHtml(task.priority || "");
            const status = escapeHtml(task.status || "");
            const assignedUser = task.assigned_user ? escapeHtml(String(task.assigned_user).trim()) : "Unassigned";
            const dueDate = formatDate(task.due_date);
            
            // Format data specifically for the Edit/Assign Modals
            const editDueDate = formatDateForInput(task.due_date);
            const assignedToVal = task.assigned_to ? String(task.assigned_to) : "";

            let statusHtml = canChangeStatus ? `
                <button type="button" class="task-toggle-btn m-0 ${task.status === 'Completed' ? 'is-completed' : ''}" 
                    data-task-id="${taskId}">
                    <i class="fas fa-check"></i>
                </button>
            ` : `<span class="badge bg-secondary">${status}</span>`;

            // Build Actions HTML with full data attributes and lock icon fallback
            let actionsHtml = `<div class="d-flex justify-content-end align-items-center gap-2">`;
            
            if (isManager) {
                actionsHtml += `<button type="button" class="task-btn-icon task-btn-assign assignTaskBtn" 
                                    data-task-id="${taskId}" 
                                    data-assigned-to="${escapeHtml(assignedToVal)}" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#assignTaskModal" 
                                    title="Assign User">
                                    <i class="fas fa-user-plus"></i>
                                </button>`;
            }
            
            if (canEdit) {
                actionsHtml += `<button type="button" class="task-btn-icon task-btn-edit editTaskBtn" 
                                    data-id="${taskId}" 
                                    data-title="${title}" 
                                    data-description="${description}" 
                                    data-priority="${priority}" 
                                    data-status="${status}" 
                                    data-due-date="${editDueDate}" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#editTaskModal" 
                                    title="Edit Task">
                                    <i class="fas fa-pen"></i>
                                </button>`;
            }
            
            if (canDelete) {
                actionsHtml += `<button type="button" class="task-btn-icon task-btn-delete deleteTaskBtn" 
                                    data-task-id="${taskId}" 
                                    data-task-title="${title}" 
                                    title="Delete Task">
                                    <i class="fas fa-trash"></i>
                                </button>`;
            }

            if (!isManager && !canEdit && !canDelete) {
                actionsHtml += `<span class="text-muted small px-2" title="You can only edit or delete tasks you created">
                                    <i class="fas fa-lock opacity-50"></i>
                                </span>`;
            }
            
            actionsHtml += `</div>`;

            html += `
                <tr>
                    <td>${statusHtml}</td>
                    <td>
                        <div class="table-task-title">${title}</div>
                        <div class="table-task-desc">${description}</div>
                    </td>
                    <td><span class="task-badge ${getPriorityClass(task.priority)}">${priority}</span></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-user-circle text-muted"></i>
                            <span class="small fw-semibold text-dark">${assignedUser}</span>
                        </div>
                    </td>
                    <td>
                        <div class="meta-chip border-0 bg-transparent p-0">
                            <i class="fas fa-calendar-day"></i> <span>${dueDate}</span>
                        </div>
                    </td>
                    <td>${actionsHtml}</td>
                </tr>
            `;
        });

        $tbody.html(html);

        // 5. Render Pagination Controls
        if (totalPages > 1) {
            let pagHtml = `<ul class="pagination pagination-sm shadow-sm m-0">`;
            pagHtml += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="#" data-page="${currentPage - 1}"><i class="fas fa-chevron-left"></i></a></li>`;
            
            for (let i = 1; i <= totalPages; i++) {
                pagHtml += `<li class="page-item ${currentPage === i ? 'active' : ''}"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
            }
            
            pagHtml += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link" href="#" data-page="${currentPage + 1}"><i class="fas fa-chevron-right"></i></a></li>`;
            pagHtml += `</ul>`;
            $pagination.html(pagHtml);
        } else {
            $pagination.empty();
        }
    }
    /* =========================================================
       EVENT LISTENERS FOR TOOLBAR
    ========================================================= */
    $("#taskSearchInput").on("input", function() {
        searchFilter = $(this).val().toLowerCase();
        currentPage = 1;
        renderTable();
    });

    $("#taskStatusFilter").on("change", function() {
        statusFilter = $(this).val();
        currentPage = 1;
        renderTable();
    });

    $("#taskPriorityFilter").on("change", function() {
        priorityFilter = $(this).val();
        currentPage = 1;
        renderTable();
    });

    $("#taskSortBtn").on("click", function() {
        dateSortAsc = !dateSortAsc;
        $("#sortIcon").removeClass("fa-sort-up fa-sort-down fa-sort").addClass(dateSortAsc ? "fa-sort-up" : "fa-sort-down");
        renderTable();
    });

    $(document).on("click", "#taskPagination .page-link", function(e) {
        e.preventDefault();
        const targetPage = parseInt($(this).attr("data-page"));
        if (!isNaN(targetPage)) {
            currentPage = targetPage;
            renderTable();
        }
    });

    /* =========================================================
       UPDATE PROJECT PROGRESS UI
    ========================================================= */
    function updateProgressUI(tasks) {
        let progressPercentage = 0;

        if (tasks && tasks.length > 0) {
            const totalTasks = tasks.length;
            const completedTasks = tasks.filter(t => t.status === 'Completed').length;
            progressPercentage = Math.round((completedTasks / totalTasks) * 100);
        }

        // Update the text values
        $("#kpiProgressValue").text(progressPercentage + "%");
        $("#barProgressValue").text(progressPercentage + "%");
        
        // Animate the progress bar fill
        $("#progressBarFill").css("width", progressPercentage + "%");
    }
    /* =========================================================
       GET TASKS
    ========================================================= */

    function loadProjectTasks() {

        clearMessage();
        showLoading();


        $.ajax({

            url: tasksUrl,

            type: "GET",

            dataType: "json",

            cache: false,

            headers: {
                "Accept": "application/json",
                "X-Requested-With":
                    "XMLHttpRequest"
            },

           success: function (response) {
        if (!response || response.success !== true) {
            showTaskError(response && response.message ? response.message : "Unable to load tasks.");
            return;
        }
        allProjectTasks = response.tasks; // Store fetched data
        // 1. Update the table
        renderTable(); 
        
        // 2. Update the progress stats immediately 
        updateProgressUI(allProjectTasks);
    },
            error: function (xhr) {

                console.error(
                    "Task GET error:",
                    xhr
                );


                showTaskError(
                    getErrorMessage(
                        xhr,
                        "Unable to load project tasks."
                    )
                );
            }
        });
    }


    /* =========================================================
       AJAX MUTATION HELPER
    ========================================================= */

    function runTaskMutation({
        url,
        data = null,
        button = null,
        loadingHtml = null,
        successFallback,
        errorFallback,
        onSuccess = null
    }) {

        let originalHtml = null;


        if (button) {

            originalHtml =
                button.html();

            button
                .prop("disabled", true);


            if (loadingHtml) {
                button.html(loadingHtml);
            }
        }


        clearMessage();


        $.ajax({

            url: url,

            type: "POST",

            data: data,

            /*
             * Do not force dataType here.
             *
             * This lets us safely tolerate either:
             * JSON from the updated controller, or
             * the old redirect/HTML response.
             */
            headers: {
                "Accept": "application/json",
                "X-Requested-With":
                    "XMLHttpRequest"
            },

            success: function (response) {

                const result =
                    normalizeMutationResponse(
                        response
                    );


                /*
                 * Explicit JSON failure.
                 */
                if (
                    result &&
                    result.success === false
                ) {

                    showMessage(
                        result.message ||
                        errorFallback,
                        "danger"
                    );

                    return;
                }


                if (typeof onSuccess === "function") {
                    onSuccess(result);
                }


                showMessage(
                    result.message ||
                    successFallback,
                    "success"
                );


                /*
                 * Always fetch the newest DB state.
                 */
                loadProjectTasks();
            },

            error: function (xhr) {

                console.error(
                    "Task mutation error:",
                    xhr
                );


                showMessage(
                    getErrorMessage(
                        xhr,
                        errorFallback
                    ),
                    "danger"
                );
            },

            complete: function () {

                if (button) {

                    button
                        .prop("disabled", false)
                        .html(originalHtml);
                }
            }
        });
    }


    /* =========================================================
       CREATE TASK
    ========================================================= */

    $(document).on(
        "submit",
        "#addTaskForm",
        function (event) {

            event.preventDefault();


            const form = this;
            const $form = $(form);


            if (!form.checkValidity()) {

                form.classList.add(
                    "was-validated"
                );

                return;
            }


            const $button =
                $form.find(
                    '[type="submit"]'
                );


            runTaskMutation({

                url:
                    $form.attr("action") ||
                    "/tasks",

                data:
                    $form.serialize(),

                button:
                    $button,

                loadingHtml: `
                    <span
                        class="spinner-border
                               spinner-border-sm
                               me-2"
                        aria-hidden="true">
                    </span>
                    Creating...
                `,

                successFallback:
                    "Task created successfully.",

                errorFallback:
                    "Unable to create task.",

                onSuccess: function () {

                    /*
                     * Close modal only after successful request.
                     */
                    const modalElement =
                        document.getElementById(
                            "addTaskModal"
                        );


                    if (
                        modalElement &&
                        window.bootstrap
                    ) {

                        const modal =
                            bootstrap.Modal
                                .getInstance(
                                    modalElement
                                );


                        if (modal) {
                            modal.hide();
                        }
                    }


                    form.reset();

                    form.classList.remove(
                        "was-validated"
                    );
                }
            });
        }
    );


    /* =========================================================
       OPEN EDIT MODAL
    ========================================================= */

    $(document).on(
        "click",
        ".editTaskBtn",
        function () {

            const $button =
                $(this);


            $("#editTitle").val(
                $button.attr("data-title") || ""
            );


            $("#editDescription").val(
                $button.attr("data-description") || ""
            );


            $("#editPriority").val(
                $button.attr("data-priority") || ""
            );


            $("#editStatus").val(
                $button.attr("data-status") || ""
            );


            $("#editDueDate").val(
                $button.attr("data-due-date") || ""
            );


            $("#editTaskForm").attr(
                "action",
                `/tasks/${encodeURIComponent(
                    $button.attr("data-id")
                )}/update`
            );


            $("#editTaskForm")
                .removeClass(
                    "was-validated"
                );
        }
    );


    /* =========================================================
       UPDATE TASK
    ========================================================= */

    $(document).on(
        "submit",
        "#editTaskForm",
        function (event) {

            event.preventDefault();


            const form = this;
            const $form = $(form);


            if (!form.checkValidity()) {

                form.classList.add(
                    "was-validated"
                );

                return;
            }


            const $button =
                $form.find(
                    '[type="submit"]'
                );


            runTaskMutation({

                url:
                    $form.attr("action"),

                data:
                    $form.serialize(),

                button:
                    $button,

                loadingHtml: `
                    <span
                        class="spinner-border
                               spinner-border-sm
                               me-2"
                        aria-hidden="true">
                    </span>
                    Saving...
                `,

                successFallback:
                    "Task updated successfully.",

                errorFallback:
                    "Unable to update task.",

                onSuccess: function () {

                    const modalElement =
                        document.getElementById(
                            "editTaskModal"
                        );


                    if (
                        modalElement &&
                        window.bootstrap
                    ) {

                        const modal =
                            bootstrap.Modal
                                .getInstance(
                                    modalElement
                                );


                        if (modal) {
                            modal.hide();
                        }
                    }
                }
            });
        }
    );


    /* =========================================================
       DELETE TASK
    ========================================================= */

    $(document).on(
        "click",
        ".deleteTaskBtn",
        function () {

            const $button =
                $(this);


            const taskId =
                $button.attr(
                    "data-task-id"
                );


            const title =
                $button.attr(
                    "data-task-title"
                ) ||
                "this task";


            if (!taskId) {
                return;
            }


            if (
                !window.confirm(
                    `Delete "${title}"?`
                )
            ) {
                return;
            }


            runTaskMutation({

                url:
                    `/tasks/${encodeURIComponent(
                        taskId
                    )}/delete`,

                button:
                    $button,

                loadingHtml: `
                    <span
                        class="spinner-border
                               spinner-border-sm"
                        aria-hidden="true">
                    </span>
                `,

                successFallback:
                    "Task deleted successfully.",

                errorFallback:
                    "Unable to delete task."
            });
        }
    );


    /* =========================================================
       TOGGLE TASK STATUS
    ========================================================= */

    $(document).on(
        "click",
        ".task-toggle-btn",
        function () {

            const $button =
                $(this);


            const taskId =
                $button.attr(
                    "data-task-id"
                );


            if (!taskId) {
                return;
            }


            runTaskMutation({

                url:
                    `/tasks/${encodeURIComponent(
                        taskId
                    )}/toggle`,

                button:
                    $button,

                loadingHtml: `
                    <span
                        class="spinner-border
                               spinner-border-sm"
                        aria-hidden="true">
                    </span>
                `,

                successFallback:
                    "Task status updated successfully.",

                errorFallback:
                    "Unable to update task status."
            });
        }
    );


    /* =========================================================
       ASSIGN MODAL OPEN
    ========================================================= */

    const assignTaskModal =
        document.getElementById(
            "assignTaskModal"
        );


    if (assignTaskModal) {

        assignTaskModal.addEventListener(
            "show.bs.modal",
            function (event) {

                const button =
                    event.relatedTarget;


                if (!button) {
                    return;
                }


                const taskId =
                    button.getAttribute(
                        "data-task-id"
                    );


                const assignedTo =
                    button.getAttribute(
                        "data-assigned-to"
                    ) || "";


                const form =
                    assignTaskModal.querySelector(
                        "#assignTaskForm"
                    );


                const select =
                    assignTaskModal.querySelector(
                        "#assignedTo"
                    );


                if (
                    !form ||
                    !select
                ) {
                    return;
                }


                form.action =
                    `/tasks/${encodeURIComponent(
                        taskId
                    )}/assign`;


                select.value =
                    String(assignedTo);
            }
        );
    }


    /* =========================================================
       ASSIGN / REASSIGN TASK
    ========================================================= */

    $(document).on(
        "submit",
        "#assignTaskForm",
        function (event) {

            event.preventDefault();


            const form = this;
            const $form = $(form);


            /*
             * Assignment may be empty if your modal allows
             * making the task unassigned.
             */
            const $button =
                $form.find(
                    '[type="submit"]'
                );


            runTaskMutation({

                url:
                    $form.attr("action"),

                data:
                    $form.serialize(),

                button:
                    $button,

                loadingHtml: `
                    <span
                        class="spinner-border
                               spinner-border-sm
                               me-2"
                        aria-hidden="true">
                    </span>
                    Saving...
                `,

                successFallback:
                    "Task assignment updated successfully.",

                errorFallback:
                    "Unable to update task assignment.",

                onSuccess: function () {

                    const modalElement =
                        document.getElementById(
                            "assignTaskModal"
                        );


                    if (
                        modalElement &&
                        window.bootstrap
                    ) {

                        const modal =
                            bootstrap.Modal
                                .getInstance(
                                    modalElement
                                );


                        if (modal) {
                            modal.hide();
                        }
                    }
                }
            });
        }
    );


    /* =========================================================
       RETRY
    ========================================================= */

    $(document).on(
        "click",
        "#retryTasksBtn",
        function () {

            loadProjectTasks();

        }
    );


    /* =========================================================
       INITIAL LOAD
    ========================================================= */

    loadProjectTasks();

});
</script>


