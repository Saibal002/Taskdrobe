<%
    const managerStats = projectStats || {};

    /*
     * Static preview data.
     * These will eventually come from the team/activity/deadline backend.
     */

    const managerTeamMemberCount = 7;


    const attentionItems = [

        {
            tone: Number(managerStats.overdueTasks || 0) > 0
                ? "danger"
                : "success",

            icon: Number(managerStats.overdueTasks || 0) > 0
                ? "bi-exclamation-octagon"
                : "bi-check-circle",

            title: Number(managerStats.overdueTasks || 0) > 0
                ? `${managerStats.overdueTasks} overdue task${Number(managerStats.overdueTasks) === 1 ? "" : "s"}`
                : "No overdue tasks",

            text: Number(managerStats.overdueTasks || 0) > 0
                ? "Review overdue work and reassign where necessary."
                : "Your current overdue queue is clear.",

            action: "/tasks"
        },

        {
            tone: "warning",
            icon: "bi-clock-history",
            title: "2 projects nearing deadline",
            text: "Review upcoming milestones before they become blockers.",
            action: "/projects"
        },

        {
            tone: "purple",
            icon: "bi-person-exclamation",
            title: "1 task needs assignment",
            text: "Make sure new work has a clear owner.",
            action: "/tasks"
        }

    ];

    /*
     * Dynamic schedule data.
     * Use the real project deadlines already available to the dashboard.
     * Keep only projects with a valid deadline, sort by date, and show the
     * next three items in the manager schedule panel.
     */
    const todayStart = new Date();
    todayStart.setHours(0, 0, 0, 0);

    const upcomingDeadlines = (projects || [])
        .filter(project => project && project.deadline)
        .map(project => {
            const deadlineDate = new Date(project.deadline);

            if (Number.isNaN(deadlineDate.getTime())) {
                return null;
            }

            const dateOnly = new Date(
                deadlineDate.getFullYear(),
                deadlineDate.getMonth(),
                deadlineDate.getDate()
            );

            const daysUntil = Math.ceil(
                (dateOnly.getTime() - todayStart.getTime()) /
                (1000 * 60 * 60 * 24)
            );

            let priority = "Planned";
            let tone = "purple";

            if (daysUntil < 0) {
                priority = "Overdue";
                tone = "danger";
            } else if (daysUntil <= 3) {
                priority = "High";
                tone = "danger";
            } else if (daysUntil <= 7) {
                priority = "Medium";
                tone = "warning";
            }

            let relative = "Upcoming";

            if (daysUntil < 0) {
                const overdueDays = Math.abs(daysUntil);
                relative = `${overdueDays} day${overdueDays === 1 ? "" : "s"} overdue`;
            } else if (daysUntil === 0) {
                relative = "Due today";
            } else if (daysUntil === 1) {
                relative = "Due tomorrow";
            } else {
                relative = `Due in ${daysUntil} days`;
            }

            return {
                date: dateOnly,
                day: String(dateOnly.getDate()).padStart(2, "0"),
                month: dateOnly.toLocaleDateString(undefined, {
                    month: "short"
                }).toUpperCase(),
                project: project.project_name || "Untitled project",
                description: project.description || "Project deadline",
                priority,
                tone,
                relative,
                projectId: project.project_id
            };
        })
        .filter(Boolean)
        .sort((a, b) => a.date - b.date)
        .slice(0, 3);





   
%>


<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | TaskDrobe
    </title>


    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
        rel="stylesheet">


    <!-- Font Awesome -->
    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
        rel="stylesheet">


    <!-- Global styles -->
    <link
        href="/css/style.css"
        rel="stylesheet">


    <!-- Existing project/modal styles -->
    <link
        href="/css/project.css"
        rel="stylesheet">


    <!-- Manager-only design -->
    <link
        href="/css/manager_dashboard.css"
        rel="stylesheet">

</head>


<body class="manager-dashboard-page app-sidebar-layout">


    <!-- Shared authenticated navigation: navbar + sidebar -->
    <%- include("../layout/navBar", { user: user, page: "dashboard" }) %>
    <script src="/js/navbar.js"></script>


    <!-- Main Dashboard -->
    <main class="manager-main">

        <div class="manager-container">


            <!-- Small page context -->
            <div class="manager-page-context">

                <div>

                    <span>
                        Workspace
                    </span>

                    <strong>
                        Manager Dashboard
                    </strong>

                </div>


                <div class="manager-date-chip">

                    <i class="bi bi-calendar3"></i>

                    <%= today %>

                </div>

            </div>


            <!-- Statistics -->
            <%- include("./partials/managerStats", {
                stats: managerStats,
                teamMemberCount: managerTeamMemberCount
            }) %>


          <!-- Projects + Upcoming Deadlines -->
<div class="manager-dashboard-grid manager-main-grid">

    <%- include("./partials/managerProjects", {
        projects,
        user
    }) %>

    <%- include("./partials/managerDeadlines", {
        deadlines: upcomingDeadlines
    }) %>

</div>

<!-- Attention + Task Overview -->
<div class="manager-dashboard-grid manager-secondary-grid">

    <%- include("./partials/managerAttention", {
        items: attentionItems
    }) %>

    <%- include("./partials/managerTaskOverview", {
        stats: managerStats
    }) %>

</div>




            <!-- Activity + Team -->
            <div class="manager-dashboard-grid manager-bottom-grid">

                <%- include("./partials/managerActivity", {
                    activities: []
                }) %>


                <%- include("./partials/managerTeamOverview") %>

            </div>

        </div>

    </main>


    <!-- Existing Add Project Modal -->
    <%- include("../layout/addProjectModal") %>

    <!-- New Add Team Modal -->
    <%- include("../layout/addTeamModal") %>

    <!-- Existing Edit Project Modals -->
    <% if (projects && projects.length > 0) { %>

        <% projects.forEach(project => { %>

            <%- include("../layout/editProjectModal", {
                project
            }) %>

        <% }) %>

    <% } %>


    <!-- Libraries -->
    <script
        src="https://code.jquery.com/jquery-3.7.1.min.js">
    </script>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

   <!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script
        src="/socket.io/socket.io.js">
    </script>


    <!-- Manager-only JavaScript -->
    <script
        src="/js/managerDashboard.js">
    </script>
    <script src="/js/sharedTeamsAjax.js"></script>

    <%- include("../layout/globalChat") %>

</body>

</html>