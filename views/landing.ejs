<%- include('layout/header', { title: 'Welcome to TaskDrobe' }) %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="/css/landing.css" />

<style>
    :root {
        --td-primary: #6366f1;
        --td-primary-dark: #4f46e5;
        --td-purple: #8b5cf6;
        --td-pink: #ec4899;
        --td-cyan: #06b6d4;
        --td-emerald: #10b981;
        --td-amber: #f59e0b;
        --td-slate-900: #0f172a;
        --td-slate-700: #334155;
        --td-slate-600: #475569;
        --td-slate-400: #94a3b8;
    }

    .landing-shell {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        position: relative;
        overflow-x: hidden;
        background-color: #f4f7fe;
        color: var(--td-slate-900);
        z-index: 1;
    }

    /* =========================================================
       AMBIENT FLOATING GRADIENT ORBS (MATCHES LOGIN / SIGNUP)
    ========================================================= */
    .landing-ambient-canvas {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        background:
            radial-gradient(circle at 15% 10%, rgba(224, 231, 255, 0.8) 0%, transparent 50%),
            radial-gradient(circle at 85% 20%, rgba(252, 231, 243, 0.65) 0%, transparent 50%),
            radial-gradient(circle at 50% 80%, rgba(207, 250, 254, 0.55) 0%, transparent 55%),
            #f4f7fe;
    }

    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(65px);
        opacity: 0.55;
        animation: floatLandingOrb 18s ease-in-out infinite alternate;
    }

    .orb-1 {
        width: 460px;
        height: 460px;
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        top: -140px;
        left: -120px;
    }

    .orb-2 {
        width: 390px;
        height: 390px;
        background: linear-gradient(135deg, #ec4899 0%, #f43f5e 100%);
        top: 22%;
        right: -110px;
        animation-duration: 22s;
        animation-delay: -5s;
    }

    .orb-3 {
        width: 340px;
        height: 340px;
        background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
        bottom: 12%;
        left: 8%;
        opacity: 0.4;
        animation-duration: 20s;
        animation-delay: -9s;
    }

    .orb-4 {
        width: 260px;
        height: 260px;
        background: linear-gradient(135deg, #8b5cf6 0%, #38bdf8 100%);
        bottom: -80px;
        right: 14%;
        opacity: 0.45;
        animation-duration: 16s;
        animation-delay: -3s;
    }

    @keyframes floatLandingOrb {
        0% { transform: translate(0, 0) scale(1) rotate(0deg); }
        50% { transform: translate(40px, -30px) scale(1.06) rotate(5deg); }
        100% { transform: translate(-25px, 25px) scale(0.95) rotate(-5deg); }
    }

    /* =========================================================
       TOP GLASS NAVIGATION BAR
    ========================================================= */
    .landing-topbar {
        max-width: 1240px;
        margin: 1.25rem auto 0;
        padding: 0 1.25rem;
    }

    .landing-topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.35rem;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 20px;
        box-shadow: 0 12px 32px -12px rgba(15, 23, 42, 0.08);
    }

    .landing-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
    }

    .landing-brand img {
        height: 40px;
        width: auto;
        object-fit: contain;
    }

    .landing-nav-links {
        display: flex;
        align-items: center;
        gap: 1.75rem;
    }

    .landing-nav-links a {
        text-decoration: none;
        color: var(--td-slate-600);
        font-weight: 600;
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }

    .landing-nav-links a:hover {
        color: var(--td-primary);
    }

    .landing-nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    /* =========================================================
       HERO SECTION
    ========================================================= */
    .landing-hero {
        max-width: 1240px;
        margin: 0 auto;
        padding: 3.5rem 1.25rem 3rem;
    }

    .landing-hero-inner {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 3rem;
        align-items: center;
    }

    .landing-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(99, 102, 241, 0.25);
        color: var(--td-primary-dark);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.08);
        margin-bottom: 1.5rem;
    }

    .landing-hero-title {
        font-size: clamp(2.4rem, 4.5vw, 3.65rem);
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -0.035em;
        color: var(--td-slate-900);
        margin-bottom: 1.25rem;
    }

    .landing-gradient-text {
        display: block;
        background: linear-gradient(135deg, #4f46e5 0%, #9333ea 50%, #ec4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .landing-hero-subtitle {
        font-size: 1.08rem;
        line-height: 1.68;
        color: var(--td-slate-600);
        max-width: 540px;
        margin-bottom: 2rem;
    }

    .landing-hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-bottom: 2rem;
    }

    .landing-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.88rem 1.65rem;
        border-radius: 14px;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .landing-btn-primary {
        background: linear-gradient(135deg, var(--td-primary) 0%, var(--td-purple) 100%);
        color: #ffffff !important;
        box-shadow: 0 12px 26px -6px rgba(99, 102, 241, 0.5);
        border: none;
    }

    .landing-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 32px -6px rgba(99, 102, 241, 0.6);
    }

    .landing-btn-ghost {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(12px);
        color: var(--td-slate-900) !important;
        border: 1.5px solid rgba(203, 213, 225, 0.85);
    }

    .landing-btn-ghost:hover {
        background: #ffffff;
        border-color: var(--td-primary);
        transform: translateY(-2px);
    }

    .landing-btn-sm {
        padding: 0.55rem 1.1rem;
        font-size: 0.85rem;
        border-radius: 12px;
    }

    /* Feature Mini Pills under CTA */
    .hero-feature-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.85rem;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.75);
        border: 1px solid rgba(203, 213, 225, 0.7);
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--td-slate-700);
    }

    /* =========================================================
       HERO RIGHT: REALISTIC TASKDROBE GLASS WORKSPACE PREVIEW
    ========================================================= */
    .landing-hero-preview {
        position: relative;
    }

    .preview-sphere {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
    }

    .preview-sphere-1 {
        width: 130px;
        height: 130px;
        top: -35px;
        right: -25px;
        background: radial-gradient(circle at 30% 30%, #f472b6, #7c3aed 75%);
        box-shadow: 0 20px 40px rgba(124, 58, 237, 0.3);
        animation: floatLandingOrb 12s ease-in-out infinite alternate;
    }

    .preview-sphere-2 {
        width: 90px;
        height: 90px;
        bottom: -25px;
        left: -25px;
        background: radial-gradient(circle at 30% 30%, #38bdf8, #4f46e5 75%);
        box-shadow: 0 15px 30px rgba(79, 70, 229, 0.28);
        animation: floatLandingOrb 10s ease-in-out infinite alternate-reverse;
    }

    .workspace-mockup {
        position: relative;
        z-index: 2;
        background: rgba(255, 255, 255, 0.76);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 26px;
        padding: 1.35rem;
        box-shadow:
            0 30px 65px -15px rgba(15, 23, 42, 0.14),
            0 0 0 1px rgba(255, 255, 255, 0.6) inset;
    }

    .mockup-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid rgba(203, 213, 225, 0.5);
    }

    .mockup-dots {
        display: flex;
        gap: 6px;
    }

    .mockup-dots span {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .mockup-dots span:nth-child(1) { background: #f43f5e; }
    .mockup-dots span:nth-child(2) { background: #f59e0b; }
    .mockup-dots span:nth-child(3) { background: #10b981; }

    .mockup-role-tags {
        display: flex;
        gap: 0.4rem;
    }

    .role-chip {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .role-chip-admin { background: rgba(236, 72, 153, 0.12); color: #db2777; }
    .role-chip-manager { background: rgba(99, 102, 241, 0.14); color: #4f46e5; }
    .role-chip-emp { background: rgba(6, 182, 212, 0.14); color: #0891b2; }

    /* Mockup Inner Cards */
    .mockup-card {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 0.85rem;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }

    .mockup-meeting-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4f46e5 100%);
        color: #ffffff;
        border-radius: 16px;
        padding: 0.95rem 1.1rem;
        margin-bottom: 0.85rem;
    }

    .live-pulse-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.2);
        border: 1px solid rgba(16, 185, 129, 0.45);
        color: #6ee7b7;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
    }

    .mockup-task-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0;
        border-bottom: 1px dashed rgba(203, 213, 225, 0.6);
    }

    .mockup-task-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .mockup-task-left {
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .mockup-check {
        width: 18px;
        height: 18px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        color: #fff;
        background: var(--td-primary);
    }

    .mockup-priority {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 8px;
    }

    .prio-high { background: rgba(244, 63, 94, 0.12); color: #e11d48; }
    .prio-med { background: rgba(245, 158, 11, 0.14); color: #d97706; }
    .prio-done { background: rgba(16, 185, 129, 0.14); color: #059669; }

    /* Floating Socket.IO Chat Toast on Mockup */
    .mockup-chat-float {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        background: linear-gradient(135deg, rgba(236, 72, 153, 0.95), rgba(139, 92, 246, 0.95));
        color: #ffffff;
        padding: 0.75rem 1rem;
        border-radius: 16px;
        box-shadow: 0 12px 24px -6px rgba(139, 92, 246, 0.45);
    }

    /* =========================================================
       ARCHITECTURE PILLARS STRIP
    ========================================================= */
    .landing-trust-strip {
        max-width: 1200px;
        margin: 0 auto 3.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 20px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .landing-trust-strip p {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--td-slate-400);
    }

    .landing-trust-logos {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .landing-trust-logos span {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--td-slate-700);
    }

    /* =========================================================
       SECTIONS & FEATURE CARDS
    ========================================================= */
    .landing-section {
        max-width: 1240px;
        margin: 0 auto;
        padding: 3.5rem 1.25rem;
    }

    .landing-section-head {
        text-align: center;
        max-width: 680px;
        margin: 0 auto 3rem;
    }

    .landing-eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--td-primary);
        background: rgba(99, 102, 241, 0.1);
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 0.85rem;
    }

    .landing-section-head h2 {
        font-size: clamp(1.85rem, 3.2vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.75rem;
    }

    .landing-section-head p {
        color: var(--td-slate-600);
        font-size: 1rem;
        line-height: 1.6;
    }

    .landing-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .landing-feature-card {
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 15px 35px -12px rgba(15, 23, 42, 0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .landing-feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 22px 45px -12px rgba(99, 102, 241, 0.16);
    }

    .landing-feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-bottom: 1.25rem;
    }

    .landing-icon-purple { background: rgba(99, 102, 241, 0.14); color: #4f46e5; }
    .landing-icon-teal   { background: rgba(6, 182, 212, 0.14); color: #0891b2; }
    .landing-icon-orange { background: rgba(245, 158, 11, 0.15); color: #d97706; }
    .landing-icon-blue   { background: rgba(59, 130, 246, 0.14); color: #2563eb; }
    .landing-icon-green  { background: rgba(16, 185, 129, 0.14); color: #059669; }
    .landing-icon-pink   { background: rgba(236, 72, 153, 0.14); color: #db2777; }

    .landing-feature-card h3 {
        font-size: 1.2rem;
        font-weight: 800;
        margin-bottom: 0.6rem;
    }

    .landing-feature-card p {
        color: var(--td-slate-600);
        font-size: 0.93rem;
        line-height: 1.6;
        margin: 0;
    }

    /* =========================================================
       RBAC WORKSPACE SHOWCASE (ADMIN / MANAGER / EMPLOYEE)
    ========================================================= */
    .landing-stats {
        max-width: 1200px;
        margin: 1rem auto;
        padding: 2.25rem;
        background: linear-gradient(140deg, #1e1b4b 0%, #312e81 50%, #4f46e5 100%);
        border-radius: 26px;
        color: #ffffff;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1.5rem;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(49, 46, 129, 0.35);
    }

    .landing-stat strong {
        display: block;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
    }

    .landing-stat span {
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.8);
    }

    /* =========================================================
       HOW IT WORKS STEPS
    ========================================================= */
    .landing-steps {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .landing-step {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 22px;
        padding: 2rem;
        position: relative;
    }

    .landing-step-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--td-primary), var(--td-purple));
        color: #ffffff;
        font-weight: 800;
        font-size: 0.95rem;
        margin-bottom: 1.15rem;
    }

    .landing-step h3 {
        font-size: 1.15rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .landing-step p {
        color: var(--td-slate-600);
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 0;
    }

    /* =========================================================
       BOTTOM CTA CARD
    ========================================================= */
    .landing-cta {
        max-width: 1200px;
        margin: 2rem auto 4rem;
        padding: 0 1.25rem;
    }

    .landing-cta-inner {
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.92);
        border-radius: 28px;
        padding: 3.5rem 2rem;
        text-align: center;
        box-shadow: 0 25px 55px -15px rgba(15, 23, 42, 0.1);
    }

    .landing-cta-inner h2 {
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 800;
        margin-bottom: 0.75rem;
    }

    .landing-cta-inner p {
        color: var(--td-slate-600);
        max-width: 560px;
        margin: 0 auto 1.85rem;
    }

    .landing-cta-inner .landing-hero-cta {
        justify-content: center;
        margin-bottom: 0;
    }

    @media (max-width: 991.98px) {
        .landing-hero-inner {
            grid-template-columns: 1fr;
        }
        .landing-nav-links {
            display: none;
        }
    }
</style>

<main class="landing-shell">

    <!-- Ambient Floating Gradient Orbs -->
    <div class="landing-ambient-canvas" aria-hidden="true">
        <span class="orb orb-1"></span>
        <span class="orb orb-2"></span>
        <span class="orb orb-3"></span>
        <span class="orb orb-4"></span>
    </div>

    <!-- =========================================================
         TOP GLASS NAVBAR
    ========================================================= -->
    <nav class="landing-topbar" aria-label="Landing Navigation">
        <div class="landing-topbar-inner">
            <a href="/" class="landing-brand">
                <img src="/images/logo.png.png" onerror="this.onerror=null;this.src='/images/logo.png.png';" alt="TaskDrobe Logo">
            </a>

            <div class="landing-nav-links">
                <a href="#features">Workspace Features</a>
                <a href="#roles">Role Workspaces</a>
                <a href="#workflow">How It Works</a>
            </div>

            <div class="landing-nav-actions">
                <a href="/login" class="landing-btn landing-btn-ghost landing-btn-sm">Sign In</a>
                <a href="/signup" class="landing-btn landing-btn-primary landing-btn-sm">Get Started</a>
            </div>
        </div>
    </nav>

    <!-- =========================================================
         HERO SECTION
    ========================================================= -->
    <section class="landing-hero">
        <div class="landing-hero-inner">

            <!-- Left Copy -->
            <div class="landing-hero-copy">
                <span class="landing-badge">
                    <i class="bi bi-stars text-warning"></i>
                    <span>Real-Time Project, Team &amp; Meeting Suite</span>
                </span>

                <h1 class="landing-hero-title">
                    Orchestrate every project, team, and
                    <span class="landing-gradient-text">deadline in real time.</span>
                </h1>

                <p class="landing-hero-subtitle">
                    TaskDrobe unifies role-based dashboards for Admins, Managers, and Employees with conflict-free meeting scheduling, live Socket.IO messaging, threaded discussions, and workload analytics.
                </p>

                <div class="landing-hero-cta">
                    <a href="/signup" class="btn-glow landing-btn landing-btn-primary">
