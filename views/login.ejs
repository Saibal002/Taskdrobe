<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="keywords" content="TaskDrobe Login">
    <meta name="description" content="Login to TaskDrobe and manage your projects, teams and tasks efficiently.">
    <meta name="author" content="TaskDrobe">

    <link rel="icon" href="/images/cutout.png">

    <title>
        <%= title %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #c5e6fc;
            --secondary-color: #6366f1;
            --accent-color: #6366f1;
            --text-color: rgba(103, 0, 112, 0.8);
        }

        .parent {
            background-color: var(--primary-color);
        }

        .main-card {
            max-width: 900px;
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(146, 1, 146, 0.1);
        }

        .left {
            padding: 20px;
        }

        .right {
            background: linear-gradient(135deg,
                    var(--secondary-color) 0%,
                    var(--accent-color) 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 40px;
        }

        .right-card {
            background: rgba(255, 255, 255, .15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, .2);
            border-radius: 20px;
            padding: 40px 30px;
            max-width: 350px;
            text-align: center;
            position: relative;
            box-shadow: 0 8px 20px rgba(25, 1, 63, .4);
        }

        .right-card h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 30px;
            line-height: 1.4;
        }

        .image-container {
            width: 180px;
            height: 220px;
            position: relative;
            left: 114px;
            top: 24px;
        }

        button {
            border: none;
            border-radius: 20px;
        }

        .login-btn {
            background: var(--secondary-color);
            color: white;
        }

        .reg-btn {
            color: var(--accent-color);
            text-decoration: none;
            text-align: center;
        }

        .dec-circle {
            position: absolute;
            inset: 0;
        }

        .circle {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(to right,
                    var(--accent-color),
                    var(--primary-color));
        }

        .circle-1 {
            width: 80px;
            height: 80px;
            top: 40%;
            right: -10%;
        }

        .circle-2 {
            width: 60px;
            height: 60px;
            bottom: 20%;
            left: -10%;
        }

        .circle-3 {
            width: 40px;
            height: 40px;
            top: 15%;
            left: -6%;
        }
    </style>
</head>

<body>

    <div class="parent container-fluid d-flex vh-100 align-items-center justify-content-center">

        <div class="main-card row w-100 bg-white">

            <!-- LEFT -->

            <div
                class="left col-lg-6 col-md-6 order-2 order-md-1 d-flex flex-column align-items-center justify-content-center">

                <div class="mb-4 w-100">

                    <h2>Login</h2>

                    <p>Let's get inside...</p>

                </div>

                <form action="/auth/login" method="POST" class="w-100" id="loginForm">

                    <div class="mb-3">

                        <label for="email" class="form-label">

                            Email

                        </label>

                        <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email"
                            autocomplete="email" required>

                        <div id="emailError" class="invalid-feedback">

                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="password" class="form-label">

                            Password

                        </label>

                        <div class="input-group">

    <input
        type="password"
        id="password"
        name="password"
        class="form-control"
        placeholder="Enter your password"
        autocomplete="current-password"
        required>

    <button
        class="btn btn-outline-secondary"
        type="button"
        id="togglePassword">

        👁️

    </button>

</div>
<div class="d-flex justify-content-between align-items-center mb-3">

    <div class="form-check">

        <input
            class="form-check-input"
            type="checkbox"
            id="rememberMe"
            name="rememberMe">

        <label
            class="form-check-label"
            for="rememberMe">

            Remember Me

        </label>

    </div>

   <div class="text-end mb-3">
    <a href="#" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal" class="text-primary text-decoration-none small fw-semibold">Forgot Password?</a>
</div>

</div>

                        <div id="passwordError" class="invalid-feedback">

                        </div>

                    </div>

                    

                    <div class="d-flex flex-column gap-3">

                        <button class="login-btn" type="submit">

                            Login

                        </button>

                        <a href="/signup" class="reg-btn">

                            Register

                        </a>

                    </div>

                </form>

                <p class="text-center text-muted small mt-4">

                    &copy; <%= new Date().getFullYear() %> TaskDrobe. All Rights Reserved.

                </p>

            </div>

            <!-- RIGHT -->

            <div class="right col-lg-6 col-md-6 order-1 order-md-2">

                <div class="right-card">

                    <div class="dec-circle">

                        <div class="circle circle-1"></div>
                        <div class="circle circle-2"></div>
                        <div class="circle circle-3"></div>

                    </div>

                    <h2 class="text-start p-2">

                        Very good works are waiting for you

                    </h2>

                    <div class="image-container">

                        <img src="/images/logo.png" alt="Login Illustration" class="mw-100">

                    </div>

                </div>

            </div>

        </div>

    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/auth.js"></script>
    <%- include("layout/footer") %>



    <!-- =========================================================
     FORGOT PASSWORD MODAL
========================================================= -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-4">Enter the email address associated with your account, and we'll send you a secure link to reset your password.</p>
                <form id="forgotPasswordForm">
                    <div class="mb-4">
                        <label for="resetEmail" class="form-label fw-semibold">Email Address</label>
                        <div class="input-group shadow-sm rounded-3">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control border-start-0" id="resetEmail" name="email" placeholder="name@company.com" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm" id="forgotPasswordBtn">
                        Send Reset Link
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     FORGOT PASSWORD AJAX SCRIPT
========================================================= -->
<script>
$(document).ready(function() {
    $("#forgotPasswordForm").on("submit", function(e) {
        e.preventDefault();
        const $form = $(this);
        const $btn = $("#forgotPasswordBtn");
        const originalHtml = $btn.html();
        
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Sending...');

        $.ajax({
            url: "/auth/forgot-password",
            type: "POST",
            data: $form.serialize(),
            success: function(res) {
                if (res.success) {
                    // Assuming you have SweetAlert Toast configured globally
                    if (typeof Toast !== 'undefined') {
                        Toast.fire({ icon: 'success', title: res.message });
                    } else {
                        alert(res.message);
                    }
                    $("#forgotPasswordModal").modal('hide');
                    $form[0].reset();
                } else {
                    if (typeof Toast !== 'undefined') {
                        Toast.fire({ icon: 'error', title: res.message });
                    } else {
                        alert(res.message);
                    }
                }
            },
            error: function() {
                if (typeof Toast !== 'undefined') {
                    Toast.fire({ icon: 'error', title: 'A server error occurred. Please try again.' });
                } else {
                    alert('A server error occurred. Please try again.');
                }
            },
            complete: function() {
                $btn.prop("disabled", false).html(originalHtml);
            }
        });
    });
});
</script>
</body>

</html>