        .right {
            background: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);

            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            position: relative;
        }

        .right-card {
            background-color: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 40px 30px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 350px;
            box-shadow: 0 8px 20px rgba(25, 1, 63, 0.4);
        }

        .right-card h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 30px;
            line-height: 1.4;
        }

        .image-container {
            width: 180px;
            height: 220px;
            /* display: flex;
            align-items: flex-end; */
            position: relative;
            overflow: visible;
            /* background: rgba(255, 255, 255, 0.1); */
            border-radius: 15px;

            top: 24px;
            left: 114px;


        }

        /* .image-container img {
            max-width: 100%;
            height: auto;
            display:block;
            object-fit: cover;
            object-position: center bottom;
            border-radius: 15px;
        } */
        button {
            border: none;
            border-radius: 20px;
        }

        .login-btn {
            background-color: var(--secondary-color);
            color: white;
        }

        .reg-btn {
            color: var(--accent-color);
        }

        .dec-circle {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
        }

        .circle {
            position: absolute;
            background: linear-gradient(to right, var(--accent-color), var(--primary-color));
            border-radius: 50%;
        }

        .circle-1 {
            width: 80px;
            height: 80px;
            top: 40%;
            right: -10%;
        }

        .circle-2 {
            width: 60px;
            height: 60px;
            bottom: 20%;
            left: -10%;
        }

        .circle-3 {
            width: 40px;
            height: 40px;
            top: 15%;
            left: -6%;
        }
    </style>
</head>

<body>
    <div class="parent container-fluid d-flex vh-100 align-items-center justify-content-center">
        <div class="main-card row w-100 p-10 align-items-center bg-white ">
            <!-- left -->
            <div class="left d-flex align-items-center flex-column bg-white col-lg-6 col-md-6 order-2 order-md-1">

                <div class="mb-4">
                    <h2>Login</h2>
                    <p>Let's get Inside....</p>
                       <% if (error) { %>
                        <div style="color: red; font-weight: bold;">
                            <%= error %>
                        </div>
                        <% } %>
                </div>


                <form action="/api/v1/login-submit" method="POST">

                    <div class="mb-3">
                        <label for="Email" class="form-label">Email</label>
                        <input type="text" placeholder="email" class="form-control" name="email">
                    </div>
                    <div class="mb-3">
                        <label for="Password" class="form-label">Password</label>
                        <input type="password" placeholder="password" class="form-control" name="password">
                    </div>
                    <div class="text-end mb-2">
                        <a href="javascript;" class="mb-4">Forget password?</a>
                    </div>
                    <div id="btn" class="d-flex flex-column gap-3 ">
                        <button class="login-btn" type="submit">Login</button>
                        <a class="reg-btn" href="/signup">Register</a>

                    </div>
                </form>
                <p class="text-center text-muted small mt-3 ">&copy;2025 All Right Reserved</p>



            </div>

            <!-- right -->
            <div class="right col-lg-6 col-md-6 order-1 order-md-2">

                <div class="right-card ">
                    <div class="dec-circle">
                        <div class="circle circle-1"></div>
                        <div class="circle circle-2"></div>
                        <div class="circle circle-3"></div>

                    </div>
                    <h2 class="text-start p-2">Very good works are waiting for you</h2>

                    <div class="image-container"><img src="images/cutout.png" alt="image" class="mw-100 image"></div>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>

