<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="keywords" content="TaskDrobe Login">
    <meta name="description" content="Login to TaskDrobe and manage your projects, teams and tasks efficiently.">
    <meta name="author" content="TaskDrobe">

    <link rel="icon" href="/images/cutout.png">
    <title><%= title %></title>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --td-primary: #6366f1;
            --td-primary-dark: #4f46e5;
            --td-secondary: #ec4899;
            --td-cyan: #06b6d4;
            --td-purple: #8b5cf6;
            --td-slate-900: #0f172a;
            --td-slate-600: #475569;
            --td-slate-400: #94a3b8;
        }

        body.auth-page {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f4f7fe;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow-x: hidden;
            color: var(--td-slate-900);
        }

        /* Hide the default layout footer bar so the glass canvas stays clean */
        body.auth-page > footer {
            display: none !important;
        }

        /* =========================================================
           AMBIENT FLOATING GRADIENT BALLS (BACKGROUND)
        ========================================================= */
        .ambient-canvas {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
            background: radial-gradient(circle at 50% 0%, rgba(224, 231, 255, 0.7) 0%, rgba(244, 247, 254, 1) 75%);
        }

        .gradient-ball {
            position: absolute;
            border-radius: 50%;
            filter: blur(55px);
            opacity: 0.65;
            animation: floatOrb 18s ease-in-out infinite alternate;
        }

        .ball-1 {
            width: 420px;
            height: 420px;
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            top: -120px;
            left: -100px;
            animation-duration: 16s;
        }

        .ball-2 {
            width: 360px;
            height: 360px;
            background: linear-gradient(135deg, #ec4899 0%, #f43f5e 100%);
            bottom: -90px;
            right: -70px;
            animation-duration: 20s;
            animation-delay: -4s;
        }

        .ball-3 {
            width: 280px;
            height: 280px;
            background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
            top: 40%;
            left: 18%;
            opacity: 0.45;
            animation-duration: 22s;
            animation-delay: -8s;
        }

        .ball-4 {
            width: 220px;
            height: 220px;
            background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
            top: 12%;
            right: 15%;
            opacity: 0.5;
            animation-duration: 15s;
            animation-delay: -2s;
        }

        .ball-5 {
            width: 170px;
            height: 170px;
            background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
            bottom: 14%;
            left: 10%;
            opacity: 0.55;
            animation-duration: 19s;
            animation-delay: -6s;
        }

        @keyframes floatOrb {
            0% {
                transform: translate(0, 0) scale(1) rotate(0deg);
            }
            50% {
                transform: translate(35px, -30px) scale(1.07) rotate(6deg);
            }
            100% {
                transform: translate(-25px, 25px) scale(0.95) rotate(-6deg);
            }
        }

        /* =========================================================
           MAIN GLASSMORPHISM CONTAINER
        ========================================================= */
        .auth-wrapper {
            position: relative;
            z-index: 2;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .glass-auth-card {
            width: 100%;
            max-width: 1020px;
            background: rgba(255, 255, 255, 0.72);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.85);
            border-radius: 28px;
            box-shadow:
                0 25px 60px -15px rgba(15, 23, 42, 0.1),
                0 0 0 1px rgba(255, 255, 255, 0.5) inset;
            overflow: hidden;
        }

        /* Left Column: Form Area */
        .auth-form-side {
            padding: 3rem 3.25rem;
            background: rgba(255, 255, 255, 0.55);
        }

        .brand-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
            margin-bottom: 1.75rem;
        }

        .brand-pill img {
            width: 36px;
            height: 36px;
            object-fit: contain;
            border-radius: 10px;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
        }

        .brand-pill span {
            font-weight: 800;
            font-size: 1.2rem;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .auth-heading h1 {
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--td-slate-900);
            margin-bottom: 0.4rem;
        }

        .auth-heading p {
            color: var(--td-slate-600);
            font-size: 0.95rem;
            margin-bottom: 1.85rem;
        }

        /* Form Controls */
        .form-label {
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--td-slate-600);
            margin-bottom: 0.45rem;
        }

        .glass-input-group {
            position: relative;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.85);
            border: 1.5px solid rgba(203, 213, 225, 0.8);
            border-radius: 14px;
            padding: 0.78rem 1rem;
            font-size: 0.95rem;
            color: var(--td-slate-900);
            transition: all 0.2s ease;
        }

        .form-control::placeholder {
            color: var(--td-slate-400);
        }

        .form-control:focus {
            background: #ffffff;
            border-color: var(--td-primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
        }

        .input-group .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
            border-right: none;
        }

        #togglePassword {
            background: rgba(255, 255, 255, 0.85);
            border: 1.5px solid rgba(203, 213, 225, 0.8);
            border-left: none;
            border-top-right-radius: 14px;
            border-bottom-right-radius: 14px;
            padding: 0 1rem;
            color: var(--td-slate-600);
            transition: all 0.2s ease;
        }

        #togglePassword:hover {
            color: var(--td-primary);
            background: #ffffff;
        }

        .form-check-input:checked {
            background-color: var(--td-primary);
            border-color: var(--td-primary);
        }

        /* Buttons */
        .login-btn {
            background: linear-gradient(135deg, var(--td-primary) 0%, var(--td-purple) 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.98rem;
            padding: 0.85rem 1.5rem;
            border-radius: 14px;
            border: none;
            width: 100%;
            box-shadow: 0 10px 22px -5px rgba(99, 102, 241, 0.45);
            transition: all 0.25s ease;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 28px -6px rgba(99, 102, 241, 0.55);
        }

        .login-btn:active {
            transform: translateY(0);
        }

        .google-btn {
            background: rgba(255, 255, 255, 0.9);
            border: 1.5px solid rgba(203, 213, 225, 0.85);
            color: var(--td-slate-900);
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.78rem 1.25rem;
            border-radius: 14px;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .google-btn:hover {
            background: #ffffff;
            border-color: #94a3b8;
            color: var(--td-slate-900);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
        }

        .divider-line {
            display: flex;
            align-items: center;
            text-align: center;
            color: var(--td-slate-400);
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin: 1.2rem 0;
        }

        .divider-line::before,
        .divider-line::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid rgba(203, 213, 225, 0.7);
        }

        .divider-line:not(:empty)::before {
            margin-right: 0.85rem;
        }

        .divider-line:not(:empty)::after {
            margin-left: 0.85rem;
        }

        .reg-btn {
            color: var(--td-primary);
            font-weight: 700;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .reg-btn:hover {
            color: var(--td-primary-dark);
            text-decoration: underline;
        }

        /* =========================================================
           RIGHT SHOWCASE PANEL (3D ORBS + INNER GLASS CARD)
        ========================================================= */
        .auth-showcase-side {
            position: relative;
            background: linear-gradient(145deg, #1e1b4b 0%, #312e81 45%, #4f46e5 100%);
            padding: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            color: #ffffff;
        }

        /* 3D Glossy Spheres inside right panel */
        .sphere {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .sphere-1 {
            width: 210px;
            height: 210px;
            top: -50px;
            right: -45px;
            background: radial-gradient(circle at 30% 30%, #f472b6, #9333ea 70%, #3b0764);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            animation: floatOrb 14s ease-in-out infinite alternate;
        }

        .sphere-2 {
            width: 140px;
            height: 140px;
            bottom: 35px;
            left: 25px;
            background: radial-gradient(circle at 30% 30%, #38bdf8, #4f46e5 70%, #1e1b4b);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
            animation: floatOrb 11s ease-in-out infinite alternate-reverse;
        }

        .sphere-3 {
            width: 70px;
            height: 70px;
            top: 22%;
            left: 14%;
            background: radial-gradient(circle at 35% 35%, #a7f3d0, #06b6d4 75%);
            box-shadow: 0 10px 25px rgba(6, 182, 212, 0.35);
            animation: floatOrb 9s ease-in-out infinite alternate;
        }

        .sphere-4 {
            width: 95px;
            height: 95px;
            bottom: -20px;
            right: 18%;
            background: radial-gradient(circle at 30% 30%, #fde047, #ec4899 70%);
            opacity: 0.85;
            animation: floatOrb 13s ease-in-out infinite alternate;
        }

        .showcase-glass-box {
            position: relative;
            z-index: 2;
            background: rgba(255, 255, 255, 0.11);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(255, 255, 255, 0.24);
            border-radius: 24px;
            padding: 2.5rem 2.25rem;
            max-width: 380px;
            width: 100%;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
        }

        .showcase-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.38rem 0.85rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            margin-bottom: 1.25rem;
        }

        .showcase-glass-box h2 {
            font-size: 1.65rem;
            font-weight: 800;
            line-height: 1.3;
            letter-spacing: -0.02em;
            margin-bottom: 0.85rem;
        }

        .showcase-glass-box p {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.6;
            margin-bottom: 1.75rem;
        }

        .showcase-logo-stage {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.25rem;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.14);
            margin-bottom: 1.5rem;
        }

        .showcase-logo-stage img {
            max-height: 110px;
            width: auto;
            object-fit: contain;
            filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.25));
        }

        .feature-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .feature-pill {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.35rem 0.75rem;
            border-radius: 10px;
            background: rgba(15, 23, 42, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: rgba(255, 255, 255, 0.92);
        }

        @media (max-width: 767.98px) {
            .auth-form-side {
                padding: 2.25rem 1.5rem;
            }
            .auth-showcase-side {
                padding: 2.25rem 1.5rem;
            }
        }
    </style>
</head>

<body class="auth-page">

    <!-- Ambient Floating Gradient Balls -->
    <div class="ambient-canvas" aria-hidden="true">
        <div class="gradient-ball ball-1"></div>
        <div class="gradient-ball ball-2"></div>
        <div class="gradient-ball ball-3"></div>
        <div class="gradient-ball ball-4"></div>
        <div class="gradient-ball ball-5"></div>
    </div>

    <main class="auth-wrapper">
        <div class="glass-auth-card row g-0">

            <!-- LEFT: LOGIN FORM -->
            <div class="auth-form-side col-lg-6 col-md-6 order-2 order-md-1 d-flex flex-column justify-content-center">

                <a href="/" class="brand-pill">
                    <img src="/images/logo.png.png.png" alt="TaskDrobe Logo">
                    <span>TaskDrobe</span>
                </a>

                <div class="auth-heading">
                    <h1>Welcome back</h1>
                    <p>Let's get inside your workspace and keep momentum going.</p>
                </div>

                <form action="/auth/login" method="POST" class="w-100" id="loginForm">

                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="name@company.com"
                            autocomplete="email"
                            required
                        >
                        <div id="emailError" class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="form-control"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required
                            >
                            <button class="btn" type="button" id="togglePassword" aria-label="Toggle password visibility">
                                👁️
                            </button>
                        </div>
                        <div id="passwordError" class="invalid-feedback d-block"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe">
                            <label class="form-check-label small fw-medium text-secondary" for="rememberMe">
                                Remember Me
                            </label>
                        </div>

                        <a href="#" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal"
                            class="text-decoration-none small fw-bold" style="color: var(--td-primary);">
                            Forgot Password?
                        </a>
                    </div>

                    <button class="login-btn" type="submit">
                        Sign In to Workspace <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <div class="divider-line">or continue with</div>

                    <a href="/auth/google"
                        class="google-btn w-100 d-flex align-items-center justify-content-center gap-2">
                        <img src="https://cdn-icons-png.flaticon.com/512/300/300221.png" alt="Google" width="18" height="18">
                        <span>Continue with Google</span>
                    </a>

                    <p class="text-center small text-secondary mt-4 mb-0">
                        Don't have an account yet?
                        <a href="/signup" class="reg-btn ms-1">Create an account</a>
                    </p>
                </form>

                <p class="text-center text-muted small mt-4 mb-0" style="font-size: 0.78rem;">
                    &copy; <%= new Date().getFullYear() %> TaskDrobe. All Rights Reserved.
                </p>
            </div>

            <!-- RIGHT: GLASSMORPHIC VISUAL SHOWCASE -->
            <div class="auth-showcase-side col-lg-6 col-md-6 order-1 order-md-2">
                <!-- Floating 3D Gradient Spheres -->
                <div class="sphere sphere-1"></div>
                <div class="sphere sphere-2"></div>
                <div class="sphere sphere-3"></div>
                <div class="sphere sphere-4"></div>

                <div class="showcase-glass-box">
                    <span class="showcase-badge">
                        <i class="bi bi-stars text-warning"></i> Unified Workspace
                    </span>

                    <h2>Very good works are waiting for you.</h2>
                    <p>Collaborate in real time, track critical milestones, and keep your entire team aligned in one place.</p>

                    <div class="showcase-logo-stage">
                        <img src="/images/logo.png.png.png" alt="TaskDrobe Illustration">
                    </div>

                    <div class="feature-pills">
                        <span class="feature-pill"><i class="bi bi-check2-circle me-1 text-info"></i>Smart Sprints</span>
                        <span class="feature-pill"><i class="bi bi-lightning-charge me-1 text-warning"></i>Live Chat</span>
                        <span class="feature-pill"><i class="bi bi-shield-check me-1 text-success"></i>RBAC Ready</span>
                        <span class="feature-pill"><i class="bi bi-calendar2-check me-1" style="color: #f472b6;"></i>Conflict-Free Meetings</span>
                        <span class="feature-pill"><i class="bi bi-graph-up-arrow me-1" style="color: #a78bfa;"></i>Live Analytics</span>
                        <span class="feature-pill"><i class="bi bi-bell me-1" style="color: #fb923c;"></i>Instant Alerts</span>
                        <span class="feature-pill"><i class="bi bi-chat-square-text me-1" style="color: #38bdf8;"></i>Threaded Discussions</span>
                        <span class="feature-pill"><i class="bi bi-journal-richtext me-1" style="color: #4ade80;"></i>Quick Notes</span>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- =========================================================
         FORGOT PASSWORD MODAL
    ========================================================= -->
    <div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4" style="background: rgba(255,255,255,0.95); backdrop-filter: blur(16px);">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Reset Password</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">
                        Enter the email address associated with your account, and we'll send you a secure link to reset your password.
                    </p>
                    <form id="forgotPasswordForm">
                        <div class="mb-4">
                            <label for="resetEmail" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 14px 0 0 14px; border: 1.5px solid rgba(203, 213, 225, 0.8);">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <input
                                    type="email"
                                    class="form-control border-start-0"
                                    id="resetEmail"
                                    name="email"
                                    placeholder="name@company.com"
                                    style="border-radius: 0 14px 14px 0;"
                                    required
                                >
                            </div>
                        </div>
                        <button type="submit" class="login-btn" id="forgotPasswordBtn">
                            Send Reset Link
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/auth.js"></script>
    <%- include("layout/footer") %>

    <!-- =========================================================
         FORGOT PASSWORD AJAX SCRIPT
    ========================================================= -->
    <script>
        $(document).ready(function () {
            $("#forgotPasswordForm").on("submit", function (e) {
                e.preventDefault();
                const $form = $(this);
                const $btn = $("#forgotPasswordBtn");
                const originalHtml = $btn.html();

                $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Sending...');

                $.ajax({
                    url: "/auth/forgot-password",
                    type: "POST",
                    data: $form.serialize(),
                    success: function (res) {
                        if (res.success) {
                            if (typeof Toast !== 'undefined') {
                                Toast.fire({ icon: 'success', title: res.message });
                            } else {
                                alert(res.message);
                            }
                            $("#forgotPasswordModal").modal('hide');
                            $form[0].reset();
                        } else {
                            if (typeof Toast !== 'undefined') {
                                Toast.fire({ icon: 'error', title: res.message });
                            } else {
                                alert(res.message);
                            }
                        }
                    },
                    error: function () {
                        if (typeof Toast !== 'undefined') {
                            Toast.fire({ icon: 'error', title: 'A server error occurred. Please try again.' });
                        } else {
                            alert('A server error occurred. Please try again.');
                        }
                    },
                    complete: function () {
                        $btn.prop("disabled", false).html(originalHtml);
                    }
                });
            });
        });
    </script>
</body>

</html>