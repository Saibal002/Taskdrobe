<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Error <%= statusCode %></title>

    <style>

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            font-family: Arial, sans-serif;

            background: #f5f5f5;
        }

        .error-container {
            width: 90%;
            max-width: 600px;

            padding: 40px;

            text-align: center;

            background: white;

            border-radius: 12px;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .error-code {
            font-size: 72px;
            font-weight: bold;

            margin-bottom: 10px;

            color: #dc3545;
        }

        h1 {
            margin: 0 0 15px;
        }

        .message {
            color: #666;
            font-size: 18px;
        }

        .back-button {
            display: inline-block;

            margin-top: 25px;
            padding: 12px 22px;

            color: white;
            background: #333;

            text-decoration: none;

            border-radius: 6px;
        }

        .back-button:hover {
            opacity: 0.85;
        }

        .details {
            margin-top: 25px;
            padding: 15px;

            text-align: left;

            background: #f8f8f8;

            border-radius: 6px;

            font-size: 13px;
            color: #777;

            overflow-x: auto;
        }

        .details pre {
            white-space: pre-wrap;
            word-break: break-word;
        }

    </style>

</head>

<body>

    <div class="error-container">

        <div class="error-code">
            <%= statusCode %>
        </div>

        <h1>
            <%= title || "Something went wrong" %>
        </h1>

        <div class="message">
            <%= message %>
        </div>

        <% if (stack) { %>

            <div class="details">

                <strong>
                    Developer details
                </strong>

                <pre><%= stack %></pre>

            </div>

        <% } %>

        <a
            href="javascript:history.back()"
            class="back-button"
        >
            Go Back
        </a>

    </div>

</body>

</html>