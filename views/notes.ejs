<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        .note-card { transition: transform 0.2s, box-shadow 0.2s; border: 1px solid var(--border-color); border-radius: 12px; background: rgba(0,0,0,0.02); cursor: pointer; }
        .note-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); border-color: var(--accent-primary); }
        .note-meta { font-size: 0.8rem; color: var(--text-secondary); }
        .note-body-preview { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
        .read-note-body { white-space: pre-wrap; font-size: 1.05rem; line-height: 1.7; color: var(--text-primary); }
    </style>
</head>
<body class="app-sidebar-layout">
    <%- include("layout/navBar", { user: user, page: "notes" }) %>
    <script src="/js/navBar.js"></script>

    <main class="app-page-main">
        <div class="container-fluid py-4 fade-in">
            
            <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
                <div>
                    <h1 class="h3 fw-bold mb-1">Knowledge Base</h1>
                    <p class="text-secondary mb-0">Public team knowledge and your private workspace.</p>
                </div>
                <div>
                    <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#noteModal" onclick="openCreateNoteModal()">
                        <i class="fas fa-plus me-2"></i>New Note
                    </button>
                </div>
            </div>

            <!-- Instant Search Bar -->
            <div class="row mb-5">
                <div class="col-md-6 col-lg-5">
                    <div class="input-group shadow-sm rounded-pill overflow-hidden border">
                        <span class="input-group-text bg-white border-0 ps-4"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="noteSearch" class="form-control border-0 shadow-none py-2" placeholder="Search notes...">
                    </div>
                </div>
            </div>

            <!-- Notes Grid -->
            <div class="row g-4" id="notesGrid">
                <% if (notes && notes.length > 0) { %>
                    <% notes.forEach(note => { %>
                        <div class="col-md-6 col-xl-4 note-item">
                            <!-- Click card to open Read Modal -->
                            <div class="note-card h-100 p-4 d-flex flex-column" onclick='openReadModal(<%- JSON.stringify(note).replace(/'/g, "&#39;") %>)'>
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="badge <%= note.is_public ? 'bg-primary' : 'bg-secondary' %> bg-opacity-10 <%= note.is_public ? 'text-primary' : 'text-secondary' %> rounded-pill px-3 py-1">
                                        <i class="fas <%= note.is_public ? 'fa-globe' : 'fa-lock' %> me-1"></i> <%= note.is_public ? 'Public' : 'Private' %>
                                    </div>
                                    
                                    <!-- Only show edit/delete if user owns the note. Stop click propagation to prevent opening the read modal -->
                                    <% if (String(note.user_id) === String(user.user_id)) { %>
                                        <div class="dropdown" onclick="event.stopPropagation();">
                                            <button class="btn btn-sm btn-link text-muted p-0 shadow-none" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                <li><a class="dropdown-item" href="#" onclick='openEditNoteModal(<%- JSON.stringify(note).replace(/'/g, "&#39;") %>)'><i class="fas fa-edit me-2 text-primary"></i> Edit</a></li>
                                                <li><a class="dropdown-item text-danger" href="#" onclick="deleteNote('<%= note.note_id %>')"><i class="fas fa-trash-alt me-2"></i> Delete</a></li>
                                            </ul>
                                        </div>
                                    <% } %>
                                </div>
                                
                                <h5 class="fw-bold mb-1"><%= note.title %></h5>
                                <% if (note.description) { %>
                                    <p class="text-primary small fw-medium mb-3"><%= note.description %></p>
                                <% } %>
                                
                                <p class="note-body-preview text-secondary small flex-grow-1 mb-4"><%= note.body %></p>
                                
                                <div class="d-flex align-items-center mt-auto pt-3 border-top">
                                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center text-primary fw-bold me-2" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <%= note.creator_name.charAt(0) %>
                                    </div>
                                    <span class="note-meta flex-grow-1"><%= note.creator_name %></span>
                                    <span class="note-meta"><%= new Date(note.created_at).toLocaleDateString() %></span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5 mt-4">
                        <div class="display-1 text-muted mb-3 opacity-25"><i class="bi bi-journal-text"></i></div>
                        <h4>No notes found</h4>
                        <p class="text-secondary">Create your first private scratchpad or share knowledge with the team.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="noteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 p-4 pb-0">
                    <h5 class="modal-title fw-bold" id="noteModalTitle">Create Note</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <form id="noteForm">
                    <div class="modal-body p-4">
                        <input type="hidden" id="noteId" name="noteId">
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Title</label>
                            <input type="text" class="form-control shadow-none rounded-3" id="noteTitle" required placeholder="e.g., Onboarding Checklist">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Short Description (Optional)</label>
                            <input type="text" class="form-control shadow-none rounded-3" id="noteDescription" placeholder="A brief summary of this note">
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Content</label>
                            <textarea class="form-control shadow-none rounded-3" id="noteBody" rows="8" required placeholder="Write your notes here..."></textarea>
                        </div>
                        
                        <div class="form-check form-switch p-4 rounded-3 border bg-light d-flex align-items-center">
                            <input class="form-check-input ms-0 me-3 shadow-none" type="checkbox" role="switch" id="noteVisibility" style="width: 3rem; height: 1.5rem; cursor: pointer;">
                            <label class="form-check-label flex-grow-1" for="noteVisibility" style="cursor: pointer;">
                                <strong class="d-block text-dark">Make this note Public</strong>
                                <span class="text-muted small">Anyone in the workspace will be able to read this note.</span>
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 p-4 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" id="noteSubmitBtn">Save Note</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Read Note Modal -->
    <div class="modal fade" id="readNoteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div id="readNoteVisibility" class="badge rounded-pill px-3 py-1"></div>
                        <span id="readNoteDate" class="text-secondary small"></span>
                    </div>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 p-md-5">
                    <h2 class="fw-bold mb-2" id="readNoteTitle"></h2>
                    <p class="lead text-primary mb-4" id="readNoteDescription"></p>
                    
                    <div class="d-flex align-items-center mb-5 pb-4 border-bottom">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center text-primary fw-bold me-3" style="width: 40px; height: 40px;" id="readNoteAvatar"></div>
                        <div>
                            <div class="fw-bold" id="readNoteAuthor"></div>
                            <div class="text-secondary small">Author</div>
                        </div>
                    </div>
                    
                    <div id="readNoteContent" class="read-note-body"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/notes.js"></script>
    <%- include("layout/globalChat") %>
</body>
</html>