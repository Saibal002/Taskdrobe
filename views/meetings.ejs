<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        .meeting-card { border-left: 4px solid var(--accent-primary); transition: transform 0.2s; }
        .meeting-card:hover { transform: translateX(5px); }
        .time-block { min-width: 120px; text-align: center; background: rgba(0,0,0,0.03); border-radius: 8px; padding: 10px; }
    </style>
</head>
<body class="app-sidebar-layout">
    <%- include("layout/navBar", { user: user, page: "meetings" }) %>
    <script src="/js/navbar.js"></script>

    <main class="app-page-main">
        <div class="container-fluid py-4 fade-in">
            
            <div class="d-flex flex-wrap justify-content-between align-items-end mb-5 gap-3">
                <div>
                    <h1 class="h3 fw-bold mb-1">Team Schedule</h1>
                    <p class="text-secondary mb-0">Non-overlapping meetings for your teams.</p>
                </div>
                <div>
                    <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#meetingModal">
                        <i class="fas fa-calendar-plus me-2"></i>Schedule Meeting
                    </button>
                </div>
            </div>

            <!-- Meetings List -->
            <div class="row">
                <div class="col-xl-8 col-lg-10">
                    <% if (meetings && meetings.length > 0) { %>
                        <div class="d-flex flex-column gap-3" id="meetingsList">
                            <% meetings.forEach(meeting => { 
                                const start = new Date(meeting.start_time);
                                const end = new Date(meeting.end_time);
                            %>
                                <div class="card border-0 shadow-sm meeting-card p-3" id="meeting-row-<%= meeting.meeting_id %>">
                                    <div class="d-flex flex-column flex-md-row gap-4 align-items-md-center">
                                        
                                        <div class="time-block">
                                            <div class="fw-bold text-primary mb-1"><%= start.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div>
                                            <div class="small fw-semibold"><%= start.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                                            <div class="text-muted" style="font-size: 0.7rem;">to <%= end.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                                        </div>

                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <h5 class="fw-bold mb-0"><%= meeting.title %></h5>
                                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">
                                                        <i class="fas fa-users me-1"></i> <%= meeting.team_name %>
                                                    </span>
                                                </div>

                                                <% if (String(meeting.organizer_id) === String(user.user_id)) { %>
                                                    <button type="button" class="btn btn-sm text-danger p-0 shadow-none btn-delete-meeting" data-id="<%= meeting.meeting_id %>" title="Cancel Meeting">
                                                        <i class="fas fa-times-circle fs-5"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                            
                                            <p class="text-secondary small mb-2"><%= meeting.description || 'No description provided.' %></p>
                                            
                                            <div class="d-flex align-items-center gap-3 mt-3">
                                                <div class="d-flex align-items-center text-muted small">
                                                    <i class="fas fa-user-circle me-1"></i> Organized by <%= meeting.organizer_name %>
                                                </div>
                                                <% if (meeting.meeting_link) { %>
                                                    <a href="<%= meeting.meeting_link %>" target="_blank" class="badge bg-success bg-opacity-10 text-success text-decoration-none rounded-pill px-3 py-1">
                                                        <i class="fas fa-video me-1"></i> Join Call
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5 mt-4 admin-glass-panel">
                            <div class="display-1 text-muted mb-3 opacity-25"><i class="bi bi-calendar2-x"></i></div>
                            <h4>No upcoming meetings</h4>
                            <p class="text-secondary">Your team schedule is completely clear.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <!-- Schedule Modal -->
    <div class="modal fade" id="meetingModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 p-4 pb-0">
                    <h5 class="modal-title fw-bold">Schedule a Team Meeting</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <form id="meetingForm">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Select Team</label>
                            <select class="form-select shadow-none rounded-3" id="meetingTeam" required>
                                <option value="" disabled selected>Choose a team...</option>
                                <% if (typeof teams !== 'undefined' && teams.length > 0) { %>
                                    <% teams.forEach(t => { %>
                                        <option value="<%= t.team_id %>"><%= t.team_name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Title</label>
                            <input type="text" class="form-control shadow-none rounded-3" id="meetingTitle" required placeholder="e.g., Sprint Planning">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Meeting Link (Optional)</label>
                            <input type="url" class="form-control shadow-none rounded-3" id="meetingLink" placeholder="https://meet.google.com/...">
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Start Time</label>
                                <input type="datetime-local" class="form-control shadow-none rounded-3" id="meetingStart" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">End Time</label>
                                <input type="datetime-local" class="form-control shadow-none rounded-3" id="meetingEnd" required>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea class="form-control shadow-none rounded-3" id="meetingDescription" rows="3" placeholder="Agenda or details..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 p-4 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Schedule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/meetings.js"></script>
    <%- include("layout/globalChat") %>
</body>
</html>