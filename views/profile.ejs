<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>
    
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    
    <!-- Sockets for Navbar Notifications -->
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="profile-page app-sidebar-layout">

    <!-- Unified Navbar (Handles Sidebar & Notifications) -->
    <%- include("layout/navBar", { user: user, page: "profile" }) %>
    <script src="/js/navbar.js"></script>

    <!-- Main Content Area -->
    <main class="app-page-main profile-page-main">
        <div class="profile-page-shell fade-in">
            
            <!-- Profile Hero -->
            <div class="profile-header-card mb-4">
                <div class="profile-header-content">
                    <div class="avatar-upload-wrapper">
                        <% if (user.profile_image) { %>
                            <img src="<%= user.profile_image %>" alt="Profile Image" class="profile-avatar" id="headerAvatarPreview">
                        <% } else { %>
                            <div class="avatar-placeholder" id="headerAvatarPlaceholder">
                                <%= user.full_name.charAt(0).toUpperCase() %>
                            </div>
                        <% } %>
                    </div>
                    <div class="profile-header-text">
                        <div class="profile-role-badge">
                            <%= user.role_name %>
                        </div>
                        <h2><%= user.full_name %></h2>
                        <p><i class="fas fa-envelope me-2"></i><%= user.email %></p>
                    </div>
                </div>
            </div>

            <!-- Profile Form -->
            <div class="profile-form-panel">
                <div class="profile-form-header">
                    <div class="profile-form-icon"><i class="fas fa-user-edit"></i></div>
                    <h4>Personal Information</h4>
                </div>

                <form action="/<%= user.role_name %>/profile/update" method="POST" enctype="multipart/form-data">
                    
                    <div class="row mb-5">
                        <div class="col-12 text-center">
                            <div class="avatar-upload-wrapper mx-auto">
                                <% if (user.profile_image) { %>
                                    <img src="<%= user.profile_image %>" alt="Profile Image" class="profile-avatar" id="formAvatarPreview">
                                <% } else { %>
                                    <div class="avatar-placeholder" id="formAvatarPlaceholder">
                                        <%= user.full_name.charAt(0).toUpperCase() %>
                                    </div>
                                    <img src="" alt="Profile Image" class="profile-avatar d-none" id="formAvatarPreview">
                                <% } %>
                                
                                <label for="profileImage" class="profile-upload-btn" title="Upload new image">
                                    <i class="fas fa-camera"></i>
                                </label>
                                <input type="file" name="profileImage" id="profileImage" class="d-none" accept="image/jpeg, image/png, image/webp">
                            </div>
                            <div class="small text-muted mt-3">Allowed: JPG, PNG, WEBP. Max size: 5MB.</div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label profile-label">Full Name (Read Only)</label>
                            <input type="text" class="form-control profile-input" value="<%= user.full_name %>" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label profile-label">Email Address (Read Only)</label>
                            <input type="email" class="form-control profile-input" value="<%= user.email %>" readonly>
                        </div>
                        
                        <div class="col-md-6">
                            <label for="phone" class="form-label profile-label">Phone Number</label>
                            <input type="text" name="phone" id="phone" class="form-control profile-input" placeholder="+1 (555) 000-0000" value="<%= user.phone || '' %>">
                        </div>
                        
                        <div class="col-12">
                            <label for="bio" class="form-label profile-label">Professional Bio</label>
                            <textarea name="bio" id="bio" rows="4" class="form-control profile-input" placeholder="Tell us a little about your role and expertise..."><%= user.bio || '' %></textarea>
                        </div>
                    </div>

                    <div class="profile-form-footer">
                        <a href="/dashboard" class="btn profile-btn-cancel">Cancel</a>
                        <button type="submit" class="btn profile-btn-save">
                            <i class="fas fa-save me-2"></i> Save Changes
                        </button>
                    </div>
                </form>

            </div>


            <!-- Change Password Form -->
           <!-- Change Password Form -->
            <div class="profile-form-panel mt-4">
                <div class="profile-form-header">
                    <div class="profile-form-icon"><i class="fas fa-lock"></i></div>
                    <h4>Security & Password</h4>
                </div>

                <!-- ADDED id="changePasswordForm" -->
                <form id="changePasswordForm" action="/<%= user.role_name %>/profile/change-password" method="POST">
                    <div class="row g-4 mb-4">
                        <div class="col-md-12">
                            <label for="currentPassword" class="form-label profile-label">Current Password</label>
                            <input type="password" name="currentPassword" id="currentPassword" class="form-control profile-input" required>
                        </div>
                        
                        <div class="col-md-6">
                            <label for="newPassword" class="form-label profile-label">New Password</label>
                            <input type="password" name="newPassword" id="newPassword" class="form-control profile-input" required minlength="8">
                        </div>

                        <div class="col-md-6">
                            <label for="confirmPassword" class="form-label profile-label">Confirm New Password</label>
                            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control profile-input" required minlength="8">
                        </div>
                    </div>

                    <div class="profile-form-footer">
                        <button type="submit" id="changePasswordBtn" class="btn btn-primary px-4 rounded-pill shadow-sm fw-bold">
                            <i class="fas fa-key me-2"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
<!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Client-side Image Preview -->
    <script>
        document.getElementById('profileImage').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const previewUrl = e.target.result;
                    
                    // Update Form Preview
                    const formPreview = document.getElementById('formAvatarPreview');
                    const formPlaceholder = document.getElementById('formAvatarPlaceholder');
                    
                    if (formPlaceholder) formPlaceholder.classList.add('d-none');
                    if (formPreview) {
                        formPreview.src = previewUrl;
                        formPreview.classList.remove('d-none');
                    }
                    
                    // Update Header Preview dynamically
                    const headerPreview = document.getElementById('headerAvatarPreview');
                    const headerPlaceholder = document.getElementById('headerAvatarPlaceholder');
                    
                    if (headerPreview) {
                        headerPreview.src = previewUrl;
                    } else if (headerPlaceholder) {
                        headerPlaceholder.outerHTML = `<img src="${previewUrl}" alt="Profile Image" class="profile-avatar" id="headerAvatarPreview">`;
                    }
                }
                reader.readAsDataURL(file);
            }
        });
    </script>

    <!-- AJAX Password Change Script -->
    <script>
        $(document).ready(function() {
            // Configure SweetAlert Toast
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3500,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            // 1. Real-time Password Match Validation (MOVED OUTSIDE THE SUBMIT BLOCK)
            $('#newPassword, #confirmPassword').on('input', function () {
                const newPass = $('#newPassword').val();
                const confirmPass = $('#confirmPassword').val();

                if (confirmPass.length === 0) {
                    // Remove colored borders if the confirm box is empty
                    $('#confirmPassword').removeClass('is-valid is-invalid');
                } else if (newPass === confirmPass) {
                    // Passwords match -> Green border
                    $('#confirmPassword').removeClass('is-invalid').addClass('is-valid');
                } else {
                    // Passwords do not match -> Red border
                    $('#confirmPassword').removeClass('is-valid').addClass('is-invalid');
                }
            });

            // 2. Form Submission Logic
            $("#changePasswordForm").on("submit", function(e) {
                e.preventDefault(); // Stop standard redirect submission
                
                const $form =$(this);
                const $btn =$("#changePasswordBtn");
                const originalHtml = $btn.html();
                
                // Show loading state
                $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Verifying...');

                $.ajax({
                    url: $form.attr("action"),
                    type: "POST",
                    data: $form.serialize(),
                    success: function(res) {
                        if (res.success) {
                            Toast.fire({ icon: 'success', title: res.message });
                            $form[0].reset(); // Clear passwords from input fields$('#confirmPassword').removeClass('is-valid is-invalid'); // Reset border colors on success
                        }
                    },
                    error: function(xhr) {
                        // Extract error message sent from the controller
                        let errorMsg = "A server error occurred. Please try again.";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        // Trigger Error Toast
                        Toast.fire({ icon: 'error', title: errorMsg });
                    },
                    complete: function() {
                        // Restore button state
                        $btn.prop("disabled", false).html(originalHtml);
                    }
                });
            });
        });
    </script>
</body>
</html>