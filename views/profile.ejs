<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>
    
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">

    <style>
        .profile-header-card {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border-radius: 24px;
            padding: 3rem;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(99, 102, 241, 0.2);
        }

        .profile-header-card::before {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
            top: -100px;
            right: -100px;
            border-radius: 50%;
        }

        .glass-panel {
            background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid rgba(99, 102, 241, 0.15);
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 10px 40px rgba(15, 23, 42, 0.04);
        }

        .avatar-upload-wrapper {
            position: relative;
            width: 140px;
            height: 140px;
            margin: 0 auto;
        }

        .profile-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            background: #e0e7ff;
        }

        .avatar-placeholder {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #e0e7ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            font-weight: 800;
            border: 4px solid #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        .upload-btn {
            position: absolute;
            bottom: 0;
            right: 0;
            background: #10b981;
            color: #fff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 3px solid #fff;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);
        }

        .upload-btn:hover {
            transform: scale(1.1);
            background: #059669;
        }

        .form-control, .form-select {
            background: #f1f5f9;
            border: 1px solid transparent;
            border-radius: 12px;
            padding: 0.75rem 1.25rem;
            transition: all 0.2s;
        }

        .form-control:focus {
            background: #fff;
            border-color: #818cf8;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }
    </style>
</head>
<body>

    <%- include("layout/navBar") %>

    <div class="container-fluid">
        <div class="row">
            <%- include("layout/sideBar") %>

            <main class="col-lg-9 col-xl-10 ms-sm-auto px-4 py-5 main-content">
                
                <!-- Profile Header -->
                <div class="profile-header-card mb-4 fade-in">
                    <div class="position-relative z-1 d-flex align-items-center gap-4">
                        <div class="avatar-upload-wrapper" style="margin: 0;">
                            <% if (user.profile_image) { %>
                                <img src="<%= user.profile_image %>" alt="Profile Image" class="profile-avatar" id="headerAvatarPreview">
                            <% } else { %>
                                <div class="avatar-placeholder" id="headerAvatarPlaceholder">
                                    <%= user.full_name.charAt(0).toUpperCase() %>
                                </div>
                            <% } %>
                        </div>
                        <div>
                            <div class="badge bg-white text-primary rounded-pill px-3 py-2 mb-2 text-uppercase tracking-wide fw-bold">
                                <%= user.role_name %>
                            </div>
                            <h2 class="fw-bold mb-1"><%= user.full_name %></h2>
                            <p class="text-white text-opacity-75 mb-0"><i class="fas fa-envelope me-2"></i><%= user.email %></p>
                        </div>
                    </div>
                </div>

                <!-- Profile Form -->
                <div class="glass-panel fade-in" style="animation-delay: 0.1s;">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="p-2 bg-primary bg-opacity-10 rounded-3 text-primary"><i class="fas fa-user-edit"></i></div>
                        <h4 class="fw-bold text-dark mb-0">Personal Information</h4>
                    </div>

                    <!-- Note the enctype required for Multer -->
                    <form action="/<%= user.role_name %>/profile/update" method="POST" enctype="multipart/form-data">
                        
                        <div class="row mb-4">
                            <div class="col-12 text-center mb-4">
                                <div class="avatar-upload-wrapper">
                                    <% if (user.profile_image) { %>
                                        <img src="<%= user.profile_image %>" alt="Profile Image" class="profile-avatar" id="formAvatarPreview">
                                    <% } else { %>
                                        <div class="avatar-placeholder" id="formAvatarPlaceholder">
                                            <%= user.full_name.charAt(0).toUpperCase() %>
                                        </div>
                                        <!-- Hidden img tag for live preview when placeholder is active -->
                                        <img src="" alt="Profile Image" class="profile-avatar d-none" id="formAvatarPreview">
                                    <% } %>
                                    
                                    <label for="profileImage" class="upload-btn" title="Upload new image">
                                        <i class="fas fa-camera"></i>
                                    </label>
                                    <input type="file" name="profileImage" id="profileImage" class="d-none" accept="image/jpeg, image/png, image/webp">
                                </div>
                                <div class="small text-muted mt-2">Allowed: JPG, PNG, WEBP. Max size: 5MB.</div>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Full Name (Read Only)</label>
                                <input type="text" class="form-control text-muted" value="<%= user.full_name %>" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary small text-uppercase">Email Address (Read Only)</label>
                                <input type="email" class="form-control text-muted" value="<%= user.email %>" readonly>
                            </div>
                            
                            <div class="col-md-6">
                                <label for="phone" class="form-label fw-bold text-secondary small text-uppercase">Phone Number</label>
                                <input type="text" name="phone" id="phone" class="form-control" placeholder="+1 (555) 000-0000" value="<%= user.phone || '' %>">
                            </div>
                            
                            <div class="col-12">
                                <label for="bio" class="form-label fw-bold text-secondary small text-uppercase">Professional Bio</label>
                                <textarea name="bio" id="bio" rows="4" class="form-control" placeholder="Tell us a little about your role and expertise..."><%= user.bio || '' %></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top border-light">
                            <a href="/dashboard" class="btn btn-light rounded-pill px-4 fw-bold">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm hover-lift">
                                <i class="fas fa-save me-2"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>

            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Client-side Image Preview -->
    <script>
        document.getElementById('profileImage').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const previewUrl = e.target.result;
                    
                    // Update Form Preview
                    const formPreview = document.getElementById('formAvatarPreview');
                    const formPlaceholder = document.getElementById('formAvatarPlaceholder');
                    
                    if (formPlaceholder) formPlaceholder.classList.add('d-none');
                    formPreview.src = previewUrl;
                    formPreview.classList.remove('d-none');
                    
                    // Update Header Preview dynamically
                    const headerPreview = document.getElementById('headerAvatarPreview');
                    const headerPlaceholder = document.getElementById('headerAvatarPlaceholder');
                    
                    if (headerPreview) {
                        headerPreview.src = previewUrl;
                    } else if (headerPlaceholder) {
                        headerPlaceholder.outerHTML = `<img src="${previewUrl}" alt="Profile Image" class="profile-avatar" id="headerAvatarPreview">`;
                    }
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html>