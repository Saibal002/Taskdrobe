<%- include('layout/header', { title: 'Sign Up' }) %>

<div class="auth-layout">
    <div class="auth-card" style="flex-direction: row-reverse;">
        
        <!-- Right Side: Form (Flipped for variety) -->
        <div class="auth-left">
            <h2>Create Account</h2>
            <p>Join TaskDrobe and start managing projects efficiently.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div style="color: #ff00ff; margin-bottom: 1rem;"><%= error %></div>
            <% } %>

            <form method="POST" action="/auth/signup">
                <div class="auth-form-group">
                    <label for="fullName" class="auth-label">Full Name</label>
                    <input type="text" id="fullName" name="fullName" class="auth-input" placeholder="Enter your full name" required value="<%= typeof formData !== 'undefined' ? formData.fullName : '' %>">
                </div>

                <div class="auth-form-group">
                    <label for="email" class="auth-label">Email</label>
                    <input type="email" id="email" name="email" class="auth-input" placeholder="Enter your email" required value="<%= typeof formData !== 'undefined' ? formData.email : '' %>">
                </div>

                <div class="auth-form-group">
                    <label for="password" class="auth-label">Password</label>
                    <input type="password" id="password" name="password" class="auth-input" placeholder="Create a password" required>
                </div>

                <button type="submit" class="btn-glow" style="margin-top: 1rem;">Sign Up</button>

                <p style="text-align: center; margin-top: 2rem; color: var(--text-secondary); font-size: 0.9rem;">
                    Already have an account? <a href="/login" style="font-weight: 700;">Login</a>
                </p>
            </form>
        </div>

        <!-- Left Side: Visual -->
        <div class="auth-right">
            <div class="glass-panel" style="padding: 3rem; text-align: center; max-width: 300px; border: none; background: rgba(255,255,255,0.15);">
                <h3 style="color: #fff; font-size: 2rem; line-height: 1.2;">Organize.<br>Track.<br>Assign.</h3>
            </div>
        </div>

    </div>
</div>

<%- include('layout/footer') %>