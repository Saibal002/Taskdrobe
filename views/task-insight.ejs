<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= task.title %> | TaskDrobe</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <!-- V3 Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/discussion-comments.css" rel="stylesheet">
</head>
<body class="task-insight-page app-sidebar-layout">

    <!-- Unified Navbar -->
    <%- include("layout/navBar", { user: user, page: "tasks" }) %>
    <script src="/js/navbar.js"></script>

    <main class="app-page-main">
        <div class="app-page-shell fade-in">
            
            <!-- Task Header Section -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-2 gap-3">
                <div class="section-heading mb-0">
                    <div>
                        <h6 class="section-kicker"><i class="fas fa-project-diagram me-2"></i><%= task.project_title %></h6>
                        <h2><%= task.title %></h2>
                    </div>
                </div>
                
                <div class="d-flex gap-2">
                    <% 
                        let statusColor = 'secondary';
                        if (task.status === 'Completed') statusColor = 'success';
                        if (task.status === 'In Progress') statusColor = 'primary';
                        if (task.status === 'Todo') statusColor = 'warning';
                    %>
                    <span class="badge bg-<%= statusColor %> bg-opacity-10 text-<%= statusColor %> px-3 py-2 rounded-pill border border-<%= statusColor %> border-opacity-25 shadow-sm fs-6">
                        <i class="fas fa-circle me-1 small" style="font-size: 0.5rem; vertical-align: middle;"></i> 
                        <%= task.status %>
                    </span>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="row g-4 mt-2">
                
                <!-- Left Column: Details & Files -->
                <div class="col-lg-7 col-xl-8 d-flex flex-column gap-4 align-self-start">
                    
                    <!-- Description & Meta Panel -->
                    <div class="admin-glass-panel p-4 p-md-5">
                        <div class="mb-4 pb-4 border-bottom border-secondary border-opacity-10">
                            <h6 class="text-uppercase fw-bold text-secondary small mb-3 tracking-wide">Task Description</h6>
                            <p class="fs-5 text-primary mb-0" style="line-height: 1.7;">
                                <%= task.description || 'No description provided for this task.' %>
                            </p>
                        </div>

                        <div class="row g-4">
                            <div class="col-sm-4">
                                <div class="text-uppercase fw-bold text-secondary small mb-1 tracking-wide">Assigned To</div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-list-icon blue" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <span class="fw-bold text-primary"><%= task.assigned_to_name || 'Unassigned' %></span>
                                </div>
                            </div>
                            
                            <div class="col-sm-4">
                                <div class="text-uppercase fw-bold text-secondary small mb-1 tracking-wide">Priority</div>
                                <div class="d-flex align-items-center gap-2">
                                    <% 
                                        let prioColor = 'primary';
                                        if (task.priority === 'High') prioColor = 'danger';
                                        if (task.priority === 'Medium') prioColor = 'warning';
                                    %>
                                    <div class="admin-list-icon <%= prioColor === 'danger' ? 'dark' : 'blue' %>" style="width: 28px; height: 28px; font-size: 0.8rem; background: rgba(var(--bs-<%= prioColor %>-rgb), 0.1); color: var(--bs-<%= prioColor %>);">
                                        <i class="fas fa-flag"></i>
                                    </div>
                                    <span class="fw-bold text-primary"><%= task.priority %></span>
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="text-uppercase fw-bold text-secondary small mb-1 tracking-wide">Due Date</div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-list-icon green" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <i class="fas fa-calendar-alt"></i>
                                    </div>
                                    <span class="fw-bold text-primary">
                                        <% if (task.due_date) { %>
                                            <%= new Date(task.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        <% } else { %>
                                            Not Set
                                        <% } %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Files Panel -->
                    <div class="admin-glass-panel p-4">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom border-secondary border-opacity-10 pb-3 mb-4 gap-3">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="fas fa-paperclip text-secondary me-2"></i> Attachments
                            </h5>

                            <form id="taskFileUploadForm" class="d-flex gap-2 m-0">
                                <input type="file" name="taskFile" id="taskFile" class="form-control form-control-sm bg-light border-0 shadow-sm rounded-pill px-3" required>
                                <button type="submit" id="uploadTaskFileBtn" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm hover-lift text-nowrap">
                                    Upload
                                </button>
                            </form>
                        </div>

                        <div id="taskFileMessage" class="alert d-none small py-2 rounded-pill text-center fw-bold shadow-sm"></div>

                        <!-- Using the V3 AJAX Row Utility -->
                        <div class="app-ajax-list" id="taskFilesList">
                            <% const canManageAllFiles = user.role_name === 'admin' || user.role_name === 'manager'; %>
                            <% if (files && files.length > 0) { %>
                                <% files.forEach(file => { %>
                                    <% const isUploader = String(file.uploaded_by) === String(user.user_id); %>
                                    
                                    <div class="app-ajax-row app-ajax-row--compact app-ajax-row--info" id="file-row-<%= file.attachment_id %>">
                                        <div class="admin-list-icon blue flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <div class="flex-grow-1 min-w-0">
                                            <a href="<%= file.file_path %>" target="_blank" class="fw-bold text-decoration-none text-truncate d-block" style="color: var(--accent-primary);">
                                                <%= file.original_name %>
                                            </a>
                                            <small class="text-secondary d-block">By <%= file.uploaded_by_name %></small>
                                        </div>
                                        
                                        <% if (canManageAllFiles || isUploader) { %>
                                            <button type="button" class="btn btn-sm btn-light rounded-circle text-danger hover-lift delete-task-file-btn flex-shrink-0" data-id="<%= file.attachment_id %>" title="Delete File" style="width: 32px; height: 32px;">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        <% } %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-4 text-muted no-files-msg">
                                    <i class="fas fa-folder-open fa-2x mb-2 opacity-50"></i>
                                    <p class="mb-0 small fw-bold text-uppercase tracking-wide">No attachments found</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

               <!-- Right Column: Discussion Component -->
                <div class="col-lg-5 col-xl-4 task-insight-discussion" style="height: calc(100vh - 140px); position: sticky; top: 110px;">
                    <div class="admin-glass-panel p-0 h-100 d-flex flex-column overflow-hidden">
                        <%- include("layout/discussionComments", {
                            currentUser: user,
                            contextType: "task",
                            contextId: task.task_id,
                            listUrl: `/tasks/${task.task_id}/comments`,
                            createUrl: `/tasks/${task.task_id}/comments`,
                            deleteUrl: `/tasks/comments/:commentId`
                        }) %>
                    </div>
                </div>

                <style>
                    /* Force flex-grow and scroll behavior onto the comments list */
                    .task-insight-discussion [data-comments-list] {
                        overflow-y: auto !important;
                        flex: 1 1 0 !important;
                        min-height: 0 !important;
                    }
                    /* Match the clean scrollbar styling from the admin page */
                    .task-insight-discussion [data-comments-list]::-webkit-scrollbar { width: 6px; }
                    .task-insight-discussion [data-comments-list]::-webkit-scrollbar-track { background: transparent; }
                    .task-insight-discussion [data-comments-list]::-webkit-scrollbar-thumb { background-color: rgba(0,0,0,0.1); border-radius: 10px; }
                    html[data-theme="dark"] .task-insight-discussion [data-comments-list]::-webkit-scrollbar-thumb { background-color: rgba(255,255,255,0.1); }
                </style>

            </div>
        </div>
    </main>

    <!-- Global Chat -->
    <%- include("layout/globalChat") %>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/discussion-comments.js"></script>

    <script>
    $(document).ready(function () {
        const taskId = "<%= task.task_id %>";

        /* ==========================================
           FILE UPLOAD AJAX
        ========================================== */
        $("#taskFileUploadForm").on("submit", function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            const $btn =$("#uploadTaskFileBtn");
            const $msg =$("#taskFileMessage");
            const originalText = $btn.html();

            $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm"></span>');

            $.ajax({
                url: `/tasks/${taskId}/files`,
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $(".no-files-msg").remove();
                        const file = res.attachment;

                        // Insert new file using the V3 app-ajax-row format
                        $("#taskFilesList").prepend(`
                            <div class="app-ajax-row app-ajax-row--compact app-ajax-row--success" id="file-row-${file.attachment_id}" style="display: none;">
                                <div class="admin-list-icon green flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    <i class="fas fa-file-alt"></i>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <a href="${file.file_path}" target="_blank" class="fw-bold text-decoration-none text-truncate d-block" style="color: var(--accent-primary);">
                                        ${file.original_name}
                                    </a>
                                    <small class="text-secondary d-block">Just now</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-light rounded-circle text-danger hover-lift delete-task-file-btn flex-shrink-0" data-id="${file.attachment_id}" title="Delete File" style="width: 32px; height: 32px;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        `);

                        $(`#file-row-${file.attachment_id}`).fadeIn();
                        $("#taskFileUploadForm")[0].reset();

                        $msg.removeClass("d-none alert-danger").addClass("alert-success").text("File uploaded successfully.");
                        setTimeout(() => $msg.fadeOut(() =>$msg.addClass("d-none").show()), 3000);
                    }
                },
                error: function () {
                    $msg.removeClass("d-none alert-success").addClass("alert-danger").text("Error uploading file.");
                    setTimeout(() => $msg.fadeOut(() =>$msg.addClass("d-none").show()), 3000);
                },
                complete: function () {
                    $btn.prop("disabled", false).html(originalText);
                }
            });
        });

        /* ==========================================
           FILE DELETE AJAX
        ========================================== */
        $(document).on("click", ".delete-task-file-btn", function () {
            const attachmentId = $(this).data("id");
            if (!window.confirm("Are you sure you want to delete this file? This cannot be undone.")) return;

            const $btn =$(this);
            const originalHtml = $btn.html();$btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm text-danger"></span>');

            $.ajax({
                url: `/tasks/files/${attachmentId}`,
                type: "DELETE",
                success: function (res) {
                    if (res.success) {
                        $(`#file-row-${attachmentId}`).fadeOut(300, function () {
                            $(this).remove();
                            if ($("#taskFilesList").children(".app-ajax-row").length === 0) {
                                $("#taskFilesList").html(`
                                    <div class="text-center py-4 text-muted no-files-msg">
                                        <i class="fas fa-folder-open fa-2x mb-2 opacity-50"></i>
                                        <p class="mb-0 small fw-bold text-uppercase tracking-wide">No attachments found</p>
                                    </div>
                                `);
                            }
                        });
                    } else {
                        alert(res.message || "Unable to delete file.");
                        $btn.prop("disabled", false).html(originalHtml);
                    }
                },
                error: function () {
                    alert("An error occurred while trying to delete the file.");
                    $btn.prop("disabled", false).html(originalHtml);
                }
            });
        });
    });
    </script>
</body>
</html>