<%- include('layout/header') %>
<link rel="stylesheet" href="/css/discussion-comments.css">

<main class="container-fluid px-4 py-5" style="margin-top: 60px;">

    <!-- Task Header Banner -->
    <div class="rounded-4 shadow-sm p-4 p-md-5 mb-4 text-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4"
        style="background: linear-gradient(135deg, #4c1d95, #be123c);">
        <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3 py-2">
                    <i class="fas fa-project-diagram me-2"></i>
                    <%= task.project_title %>
                </span>
                <span class="badge <%= task.status === 'Completed' ? 'bg-success' : 'bg-warning text-dark' %> rounded-pill px-3 py-2">
                    <%= task.status %>
                </span>
            </div>

            <h1 class="display-6 fw-bold mb-0">
                <%= task.title %>
            </h1>

            <p class="lead opacity-75 mb-0">
                <%= task.description || 'No description provided.' %>
            </p>
        </div>

        <div class="bg-white bg-opacity-10 p-3 rounded-4 backdrop-blur shadow-sm text-end"
            style="min-width: 200px;">
            <div class="small opacity-75 mb-1 text-uppercase fw-bold tracking-wider">
                Due Date
            </div>

            <div class="fs-4 fw-bold">
                <% if (task.due_date) { %>
                    <%= new Date(task.due_date).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                    }) %>
                <% } else { %>
                    Not Set
                <% } %>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">

        <!-- Left Column: Details & Files -->
        <div class="col-lg-7 col-xl-8 d-flex flex-column gap-4">

            <!-- Metadata Card -->
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: #f8fafc;">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4 text-dark border-bottom pb-3">
                        Task Overview
                    </h5>

                    <div class="row g-4">

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="fs-3 text-primary">
                                    <i class="fas fa-user-circle"></i>
                                </div>

                                <div>
                                    <div class="small text-muted fw-bold text-uppercase">
                                        Assigned To
                                    </div>

                                    <div class="fs-6 fw-semibold text-dark">
                                        <%= task.assigned_to_name || 'Unassigned' %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="fs-3 text-danger">
                                    <i class="fas fa-flag"></i>
                                </div>

                                <div>
                                    <div class="small text-muted fw-bold text-uppercase">
                                        Priority
                                    </div>

                                    <div class="fs-6 fw-semibold text-dark">
                                        <%= task.priority %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Task Files Section -->
            <div class="card border-0 shadow-sm rounded-4"
                style="background: linear-gradient(to right bottom, #ffffff, #f1f5f9);">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">

                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="fas fa-paperclip text-success me-2"></i>
                            Task Attachments
                        </h5>

                        <form id="taskFileUploadForm" class="d-flex gap-2 m-0">

                            <input
                                type="file"
                                name="taskFile"
                                id="taskFile"
                                class="form-control form-control-sm border-0 bg-white rounded-pill px-3 shadow-sm"
                                required
                            >

                            <button
                                type="submit"
                                id="uploadTaskFileBtn"
                                class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm d-flex align-items-center gap-1"
                            >
                                <i class="fas fa-upload"></i>
                                Upload
                            </button>

                        </form>
                    </div>

                    <div id="taskFileMessage"
                        class="alert d-none small py-2 rounded-3">
                    </div>

                    <div class="row g-3" id="taskFilesList">

                        <% const canManageAllFiles =
                            user.role_name === 'admin' ||
                            user.role_name === 'manager'; %>

                        <% if (files && files.length > 0) { %>

                            <% files.forEach(file => { %>

                                <% const isUploader =
                                    String(file.uploaded_by) === String(user.user_id); %>

                                <div class="col-md-6 file-card-<%= file.attachment_id %>">

                                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-white shadow-sm border-start border-4 border-success">

                                        <div class="flex-grow-1 min-w-0 me-3">

                                            <a
                                                href="<%= file.file_path %>"
                                                target="_blank"
                                                class="fw-bold text-dark text-decoration-none text-truncate d-block"
                                            >
                                                <%= file.original_name %>
                                            </a>

                                            <div class="small text-muted mt-1">
                                                By <%= file.uploaded_by_name %>
                                            </div>

                                        </div>

                                        <% if (canManageAllFiles || isUploader) { %>

                                            <button
                                                type="button"
                                                class="btn btn-sm text-danger bg-danger bg-opacity-10 rounded-circle delete-task-file-btn hover-lift"
                                                data-id="<%= file.attachment_id %>"
                                                title="Delete File"
                                                style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;"
                                            >
                                                <i class="fas fa-trash"></i>
                                            </button>

                                        <% } %>

                                    </div>
                                </div>

                            <% }) %>

                        <% } else { %>

                            <div class="col-12 text-center py-4 text-muted no-files-msg">

                                <i class="fas fa-folder-open fa-2x mb-2 opacity-50"></i>

                                <p class="mb-0 small">
                                    No files attached to this task.
                                </p>

                            </div>

                        <% } %>

                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Reusable Task Discussion -->
        <div class="col-lg-5 col-xl-4">

            <%- include("layout/discussionComments", {
                currentUser: user,
                contextType: "task",
                contextId: task.task_id,
                listUrl: `/tasks/${task.task_id}/comments`,
                createUrl: `/tasks/${task.task_id}/comments`,
                deleteUrl: `/tasks/comments/:commentId`
            }) %>

        </div>

    </div>
</main>

<script>
$(document).ready(function () {

    const taskId = "<%= task.task_id %>";

    /* ==========================================
       FILE UPLOAD AJAX
    ========================================== */

    $("#taskFileUploadForm").on("submit", function (e) {

        e.preventDefault();

        const formData = new FormData(this);

        const $btn = $("#uploadTaskFileBtn");
        const $msg = $("#taskFileMessage");

        $btn
            .prop("disabled", true)
            .html('<i class="fas fa-spinner fa-spin"></i>');

        $.ajax({

            url: `/tasks/${taskId}/files`,

            type: "POST",

            data: formData,

            processData: false,

            contentType: false,

            success: function (res) {

                if (res.success) {

                    $(".no-files-msg").remove();

                    const file = res.attachment;

                    $("#taskFilesList").prepend(`

                        <div class="col-md-6 file-card-${file.attachment_id}">

                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-white shadow-sm border-start border-4 border-success">

                                <div class="flex-grow-1 min-w-0 me-3">

                                    <a
                                        href="${file.file_path}"
                                        target="_blank"
                                        class="fw-bold text-dark text-decoration-none text-truncate d-block"
                                    >
                                        ${file.original_name}
                                    </a>

                                    <div class="small text-muted mt-1">
                                        Just now
                                    </div>

                                </div>

                                <button
                                    type="button"
                                    class="btn btn-sm text-danger bg-danger bg-opacity-10 rounded-circle delete-task-file-btn hover-lift"
                                    data-id="${file.attachment_id}"
                                    title="Delete File"
                                    style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;"
                                >
                                    <i class="fas fa-trash"></i>
                                </button>

                            </div>
                        </div>
                    `);

                    $("#taskFileUploadForm")[0].reset();

                    $msg
                        .removeClass("d-none alert-danger")
                        .addClass("alert-success")
                        .text("File uploaded successfully.");

                    setTimeout(function () {
                        $msg.addClass("d-none");
                    }, 3000);
                }
            },

            error: function () {

                $msg
                    .removeClass("d-none alert-success")
                    .addClass("alert-danger")
                    .text("Error uploading file.");

            },

            complete: function () {

                $btn
                    .prop("disabled", false)
                    .html('<i class="fas fa-upload"></i> Upload');

            }

        });

    });


    /* ==========================================
       FILE DELETE AJAX
    ========================================== */

    $(document).on(
        "click",
        ".delete-task-file-btn",
        function () {

            const attachmentId =
                $(this).attr("data-id");

            if (
                !window.confirm(
                    "Are you sure you want to delete this file? This cannot be undone."
                )
            ) {
                return;
            }

            const $btn = $(this);

            $btn
                .prop("disabled", true)
                .html(
                    '<span class="spinner-border spinner-border-sm"></span>'
                );

            $.ajax({

                url: `/tasks/files/${attachmentId}`,

                type: "DELETE",

                success: function (res) {

                    if (res.success) {

                        $(`.file-card-${attachmentId}`)
                            .fadeOut(300, function () {

                                $(this).remove();

                                if (
                                    $("#taskFilesList")
                                        .children(".col-md-6")
                                        .length === 0
                                ) {

                                    $("#taskFilesList").html(`

                                        <div class="col-12 text-center py-4 text-muted no-files-msg">

                                            <i class="fas fa-folder-open fa-2x mb-2 opacity-50"></i>

                                            <p class="mb-0 small">
                                                No files attached to this task.
                                            </p>

                                        </div>

                                    `);

                                }

                            });

                    } else {

                        alert(
                            res.message ||
                            "Unable to delete file."
                        );

                        $btn
                            .prop("disabled", false)
                            .html('<i class="fas fa-trash"></i>');
                    }

                },

                error: function () {

                    alert(
                        "An error occurred while trying to delete the file."
                    );

                    $btn
                        .prop("disabled", false)
                        .html('<i class="fas fa-trash"></i>');

                }

            });

        }
    );

});
</script>

<script src="/js/discussion-comments.js"></script>

<%- include('layout/footer') %>
