<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TaskDrobe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/project.css" rel="stylesheet">
</head>

<body class="app-sidebar-layout">

    <%- include("layout/navBar", { user: user, page: "tasks" }) %>
    <script src="/js/navbar.js"></script>

    <!-- FIX 1: Using app-page-main so it properly offsets the sidebar -->
    <main class="app-page-main">
        <div class="container-fluid pt-4 fade-in">
            
            <header class="section-heading mb-4">
                <div>
                    <p class="section-kicker">
                        <%= user.role_name === 'admin' ? 'Global System' : (user.role_name === 'manager' ? 'Management' : 'Team Visibility') %>
                    </p>
                    <h2 class="fw-bold m-0">
                        <%= user.role_name === 'admin' ? 'All System Tasks' : 'Workspace Tasks' %>
                    </h2>
                </div>
            </header>

            <div class="project-members-card" id="projectTasksSection">
                <% if (tasks && tasks.length > 0) { %>
                    
                    <!-- =====================================================
                         FILTER TOOLBAR
                    ===================================================== -->
                    <div class="task-toolbar d-flex flex-wrap align-items-center gap-3 mb-4 p-3 rounded-4 shadow-sm bg-light border border-light">
                        <div class="input-group flex-grow-1" style="min-width: 250px;">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
                            <input type="text" id="globalTaskSearch" class="form-control border-start-0 border-white" placeholder="Search tasks by title or project...">
                        </div>
                        
                        <select id="globalStatusFilter" class="form-select border-white flex-grow-0 w-auto shadow-sm">
                            <option value="all">All Statuses</option>
                            <!-- FIX 2: Value must exactly match the database string "Todo" -->
                            <option value="Todo">To Do</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                        </select>

                        <select id="globalPriorityFilter" class="form-select border-white flex-grow-0 w-auto shadow-sm">
                            <option value="all">All Priorities</option>
                            <option value="Critical">Critical</option>
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Normal">Normal</option>
                            <option value="Low">Low</option>
                        </select>
                    </div>

                    <!-- =====================================================
                         TASK TABLE
                    ===================================================== -->
                    <div class="table-responsive" id="tasksTableWrapper">
                        <table class="table align-middle mb-0 custom-slick-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;" class="text-center"><i class="bi bi-check2-square"></i></th>
                                    <th>Task Name</th>
                                    <th>Project</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Assigned To</th>
                                    <th>Due Date</th>
                                    <% if (user.role_name !== 'employee') { %>
                                        <th class="text-end">Actions</th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% tasks.forEach((task) => { 
                                    const isAssignee = String(task.assigned_to) === String(user.user_id);
                                    const canToggle = user.role_name === 'admin' || user.role_name === 'manager' || isAssignee;
                                    const priorityVal = String(task.priority || '').toLowerCase();
                                    const priorityBadge = priorityVal === 'high' || priorityVal === 'critical' ? 'danger' : (priorityVal === 'medium' ? 'warning text-dark' : 'success');
                                    const deadlineDate = task.due_date ? new Date(task.due_date).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "None";
                                %>
                                    <tr class="task-row <%= !canToggle ? 'opacity-75' : '' %>" 
                                        data-title="<%= task.title ? task.title.toLowerCase() : '' %>"
                                        data-project="<%= task.project_name ? task.project_name.toLowerCase() : '' %>"
                                        data-status="<%= task.status %>"
                                        data-priority="<%= task.priority || 'Normal' %>">
                                        
                                        <td class="text-center">
                                            <% if (canToggle) { %>
                                                <form action="/tasks/<%= task.task_id %>/toggle" method="POST" class="task-toggle-form d-inline m-0 p-0">
                                                    <button type="submit" class="btn p-0 border-0 bg-transparent text-<%= task.status === 'Completed' ? 'success' : 'secondary' %>" title="Toggle Status">
                                                        <i class="bi <%= task.status === 'Completed' ? 'bi-check-circle-fill' : 'bi-circle' %> fs-5"></i>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="text-muted" title="Only the assigned user can update this task">
                                                    <i class="bi bi-lock-fill fs-6"></i>
                                                </span>
                                            <% } %>
                                        </td>
                                        
                                        <td class="fw-bold">
                                            <a href="/tasks/<%= task.task_id %>/insight" class="text-dark text-decoration-none hover-primary transition"><%= task.title %></a>
                                        </td>
                                        
                                        <td>
                                            <a href="/projects/<%= task.project_id %>" class="text-decoration-none text-primary fw-medium">
                                                <i class="bi bi-folder2 me-1"></i> <%= task.project_name %>
                                            </a>
                                        </td>
                                        
                                        <td><span class="badge bg-<%= priorityBadge %> bg-opacity-10 text-<%= priorityBadge.split(' ')[0] %> border border-<%= priorityBadge.split(' ')[0] %>"><%= task.priority || 'Normal' %></span></td>
                                        <td><span class="badge bg-light text-dark border task-status-badge"><%= task.status %></span></td>
                                        
                                        <td>
                                            <% if (task.assigned_to_name) { %>
                                                <span class="<%= isAssignee ? 'text-primary fw-bold' : 'text-muted' %>">
                                                    <i class="bi bi-person-circle me-1"></i> <%= task.assigned_to_name %>
                                                </span>
                                            <% } else { %>
                                                <span class="text-muted fst-italic">Unassigned</span>
                                            <% } %>
                                        </td>
                                        
                                        <td class="text-muted small fw-medium">
                                            <i class="bi bi-calendar me-1"></i> <%= deadlineDate %>
                                        </td>
                                        
                                        <% if (user.role_name !== 'employee') { %>
                                            <td class="text-end">
                                                <form action="/tasks/<%= task.task_id %>/delete" method="POST" class="delete-task-form d-inline" data-title="<%= task.title %>">
                                                    <button class="btn btn-sm text-danger bg-danger bg-opacity-10 rounded-circle hover-lift" type="submit" title="Delete Task" style="width: 32px; height: 32px;">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        <% } %>
                                        
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    
                    <div id="noSearchResults" class="text-center py-5 d-none">
                        <i class="fas fa-search fa-3x text-muted mb-3 opacity-25"></i>
                        <h5 class="fw-bold text-secondary">No tasks match your criteria</h5>
                        <p class="text-muted">Try adjusting your filters or search term.</p>
                    </div>

                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-check2-circle display-1 text-muted mb-3 d-block opacity-25"></i>
                        <h4 class="fw-bold">No tasks found</h4>
                        <p class="text-muted">There are currently no tasks to display.</p>
                    </div>
                <% } %>
            </div>
            
        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- =========================================================
         INSTANT FILTER SCRIPT
    ========================================================= -->
    <script>
        $(document).ready(function() {
            function filterTasks() {
                const searchTerm = $("#globalTaskSearch").val().toLowerCase();
                const statusFilter = $("#globalStatusFilter").val();
                const priorityFilter = $("#globalPriorityFilter").val();
                let visibleCount = 0;

                $(".task-row").each(function() {
                    const $row =$(this);
                    const title = $row.attr("data-title");
                    const project = $row.attr("data-project");
                    const status = $row.attr("data-status");
                    const priority = $row.attr("data-priority");

                    const matchesSearch = title.includes(searchTerm) || project.includes(searchTerm);
                    const matchesStatus = statusFilter === "all" || status === statusFilter;
                    const matchesPriority = priorityFilter === "all" || priority === priorityFilter;

                    if (matchesSearch && matchesStatus && matchesPriority) {
                        $row.show();
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });

                if (visibleCount === 0) {
                    $("#noSearchResults").removeClass("d-none");
                    $("#tasksTableWrapper").addClass("d-none");
                } else {
                    $("#noSearchResults").addClass("d-none");
                    $("#tasksTableWrapper").removeClass("d-none");
                }
            }

            $("#globalTaskSearch").on("input", filterTasks);
            $("#globalStatusFilter, #globalPriorityFilter").on("change", filterTasks);
        });
    </script>

    <!-- =========================================================
         AJAX TOGGLE & DELETE ACTIONS (Swal)
    ========================================================= -->
    <script>
        $(document).ready(function() {
            // Toggle Status
            $(document).on("submit", ".task-toggle-form", function(e) {
                e.preventDefault(); 
                const $form =$(this);
                const $btn =$form.find("button");
                const $icon =$btn.find("i");
                
                $icon.attr("class", "spinner-border spinner-border-sm text-secondary");
                $btn.prop("disabled", true);

                $.ajax({
                    url: $form.attr("action"),
                    type: "POST",
                    headers: { "Accept": "application/json" },
                    success: function(res) {
                        if (res.success) {
                            Toast.fire({ icon: 'success', title: res.message });
                            
                            if (res.task.status === 'Completed') {
                                $icon.attr("class", "bi bi-check-circle-fill fs-5");
                                $btn.removeClass("text-secondary").addClass("text-success");
                            } else {
                                $icon.attr("class", "bi bi-circle fs-5");
                                $btn.removeClass("text-success").addClass("text-secondary");
                            }
                            
                            // Update internal data so filter keeps working
                            $form.closest("tr").attr("data-status", res.task.status);
                            $form.closest("tr").find(".task-status-badge").text(res.task.status);
                        } else {
                            Toast.fire({ icon: 'error', title: 'Failed to update task' });
                        }
                    },
                    complete: function() {
                        $btn.prop("disabled", false);
                    }
                });
            });

            // Delete Task
            $(document).on("submit", ".delete-task-form", function(e) {
                e.preventDefault();
                const $form =$(this);
                const taskTitle = $form.attr("data-title");

                Swal.fire({
                    title: `Delete "${taskTitle}"?`,
                    text: "This action cannot be undone.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Yes, delete it'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: $form.attr("action"),
                            type: "POST",
                            headers: { "Accept": "application/json" },
                            success: function(res) {
                                if (res.success) {
                                    Toast.fire({ icon: 'success', title: 'Task deleted' });
                                    $form.closest("tr").fadeOut(300, function() { $(this).remove(); });
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>

    <%- include("layout/footer") %>
</body>
</html>