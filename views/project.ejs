<%- include("layout/header", { title: project.project_name }   ) %>
<link rel="stylesheet" href="/css/project.css">
    <div class="container mt-5">

        <div class="project-page-shell">

            <!-- =====================================================
             PROJECT OVERVIEW
        ====================================================== -->

            <section class="project-overview-card ">

                <div class="project-overview-top">

                    <div class="project-overview-heading">

                        <a href="/dashboard" class="project-back-link">

                            <i class="fas fa-arrow-left"></i>

                            <span>
                                Back to Dashboard
                            </span>

                        </a>


                        <div class="project-title-row">

                            <div class="project-title-icon">

                                <i class="fas fa-folder-open"></i>

                            </div>


                            <div>

                                <div class="project-eyebrow">
                                    Project Overview
                                </div>

                                <h1 class="project-page-title">
                                    <%= project.project_name %>
                                </h1>

                            </div>

                        </div>


                        <p class="project-page-description">

                            <%= project.description || "No description has been added for this project yet." %>

                        </p>

                    </div>


                    <div class="project-status-panel">

                        <span class="project-status-label">
                            Current Status
                        </span>


                        <span class="project-status-badge
                        <%= project.status === 'Completed'
                            ? 'project-status-completed'
                            : project.status === 'In Progress'
                            ? 'project-status-progress'
                            : project.status === 'Cancelled'
                            ? 'project-status-cancelled'
                            : 'project-status-default' %>">

                            <span class="project-status-dot"></span>

                            <%= project.status %>

                        </span>

                    </div>

                </div>


                <!-- =================================================
                 PROJECT KPI CARDS
            ================================================== -->

                <div class="project-kpi-grid">

                    <div class="project-kpi-card project-kpi-progress">

                        <div class="project-kpi-icon">

                            <i class="fas fa-chart-line"></i>

                        </div>


                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Progress
                            </span>

                            <strong class="project-kpi-value">

                                <%= Number(project.progress || 0) %>%

                            </strong>

                        </div>

                    </div>


                    <div class="project-kpi-card project-kpi-status">

                        <div class="project-kpi-icon">

                            <i class="fas fa-layer-group"></i>

                        </div>


                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Status
                            </span>

                            <strong class="project-kpi-value project-kpi-value-small">

                                <%= project.status %>

                            </strong>

                        </div>

                    </div>


                    <div class="project-kpi-card project-kpi-deadline">

                        <div class="project-kpi-icon">

                            <i class="fas fa-calendar-days"></i>

                        </div>


                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Deadline
                            </span>

                            <strong class="project-kpi-value project-kpi-value-small">

                                <%= project.deadline ? new Date(project.deadline) .toLocaleDateString() : "Not Set" %>

                            </strong>

                        </div>

                    </div>


                    <div class="project-kpi-card project-kpi-owner">

                        <div class="project-kpi-icon">

                            <i class="fas fa-user"></i>

                        </div>


                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Created By
                            </span>

                            <strong class="project-kpi-value project-kpi-value-small">

                                <%= project.full_name %>

                            </strong>

                        </div>

                    </div>

                </div>

            </section>

            <!-- =================================================
     PROJECT PROGRESS
================================================== -->

<div class="project-progress-section">

    <div class="project-progress-header">

        <div>

            <span class="project-progress-label">
                Project Progress
            </span>

            <span class="project-progress-caption">
                Overall completion
            </span>

        </div>

        <strong>
            <%= Number(project.progress || 0) %>%
        </strong>

    </div>


    <div class="project-progress-track">

        <div
            class="project-progress-fill"
            style="width: <%= Number(project.progress || 0) %>%;">
        </div>

    </div>

</div>
            <!-- =====================================================
             PROJECT MEMBERS
             New design + jQuery AJAX
        ====================================================== -->

            <% if (user && user.role_name === "manager") { %>

    <!-- =====================================================
         PROJECT MEMBERS
         MANAGER ONLY
    ====================================================== -->

    <section
        class="project-members-section mt-4"
        id="projectMembersSection"
        data-members-url="/projects/<%= project.project_id %>/members/data"
        data-add-url="/projects/<%= project.project_id %>/members"
        data-remove-url="/projects/<%= project.project_id %>/members"
        data-role="<%= user.role_name %>">


        <div class="project-members-card">


            <!-- HEADER -->

            <div class="project-members-header">

                <div class="project-members-heading">

                    <div class="project-section-icon">

                        <i class="fas fa-users"></i>

                    </div>


                    <div>

                        <div class="project-section-eyebrow">
                            Collaboration
                        </div>

                        <h3 class="project-section-title">
                            Project Members
                        </h3>

                        <p class="project-section-subtitle">
                            People currently working on this project.
                        </p>

                    </div>

                </div>


                <span class="project-members-permission-badge">

                    <i class="fas fa-user-shield me-1"></i>

                    Manager

                </span>

            </div>


            <!-- AJAX MESSAGE -->

            <div
                id="projectMembersMessage"
                class="project-members-message alert d-none"
                role="alert">
            </div>


            <div class="row g-4">


                <!-- CURRENT MEMBERS -->

                <div class="col-lg-7">

                    <div
                        id="projectMembersList"
                        class="project-members-list"
                        aria-live="polite">

                        <div class="project-members-loading">

                            <span
                                class="spinner-border spinner-border-sm"
                                aria-hidden="true">
                            </span>

                            <span>
                                Loading members...
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ADD MEMBER -->

                <div class="col-lg-5">

                    <div class="project-add-member-panel">


                        <div class="project-add-member-heading">


                            <div class="project-add-member-icon">

                                <i class="fas fa-user-plus"></i>

                            </div>


                            <div>

                                <h4>
                                    Add Employee
                                </h4>

                                <p>
                                    Assign an active employee to this project.
                                </p>

                            </div>

                        </div>


                        <form
                            id="addProjectMemberForm"
                            novalidate>


                            <div class="mb-3">


                                <label
                                    for="projectMemberUserId"
                                    class="form-label fw-semibold">

                                    Employee

                                </label>


                                <select
                                    class="form-select"
                                    id="projectMemberUserId"
                                    name="userId"
                                    required>

                                    <option value="">
                                        Select an employee
                                    </option>

                                </select>


                                <div
                                    class="invalid-feedback"
                                    id="projectMemberUserIdError">

                                    Please select an employee.

                                </div>

                            </div>


                            <button
                                type="submit"
                                id="addProjectMemberBtn"
                                class="btn btn-primary w-100">

                                <i class="fas fa-user-plus me-2"></i>

                                Add Employee

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

<% } %>


            <!-- =====================================================
             TASKS
             Task UI + Task AJAX stay in projectTasks.ejs
        ====================================================== -->

            <hr>

            <%- include("manager/partials/projectTasks", { project: project, user: user }) %>
                <%- include("layout/addTaskModal") %>
                    <%- include("layout/editTaskModal") %>
                        <%- include("layout/assignTaskModal") %>


        </div>

    </div>


    <!-- =========================================================
     PROJECT MEMBERS AJAX
========================================================= -->

    <script>

        $(document).ready(function () {


            /* =========================================================
               ELEMENTS
            ========================================================= */

            const $section =
                $("#projectMembersSection");


            if (!$section.length) {
                return;
            }


            const $membersList =
                $("#projectMembersList");


            const $messageBox =
                $("#projectMembersMessage");


            const $addForm =
                $("#addProjectMemberForm");


            const $employeeSelect =
                $("#projectMemberUserId");


            const $addButton =
                $("#addProjectMemberBtn");


            /* =========================================================
               URLS
            ========================================================= */

            const membersUrl =
                $section.attr("data-members-url");


            const addUrl =
                $section.attr("data-add-url");


            const removeBaseUrl =
                $section.attr("data-remove-url");


            const role =
                $section.attr("data-role");


            /* =========================================================
               ESCAPE HTML
            ========================================================= */

            function escapeHtml(value) {

                return $("<div>")
                    .text(
                        value == null
                            ? ""
                            : String(value)
                    )
                    .html();

            }


            /* =========================================================
               MESSAGE
            ========================================================= */

            function showMessage(
                message,
                type = "success"
            ) {

                $messageBox
                    .removeClass(
                        "d-none alert-success alert-danger alert-warning alert-info"
                    )
                    .addClass(
                        "alert-" + type
                    )
                    .text(message);

            }


            function clearMessage() {

                $messageBox
                    .addClass("d-none")
                    .removeClass(
                        "alert-success alert-danger alert-warning alert-info"
                    )
                    .text("");

            }


            /* =========================================================
               ERROR MESSAGE
            ========================================================= */

            function getErrorMessage(
                xhr,
                fallback
            ) {

                if (
                    xhr.responseJSON &&
                    xhr.responseJSON.message
                ) {

                    return xhr.responseJSON.message;

                }

                return fallback;

            }


            /* =========================================================
               LOADING
            ========================================================= */

            function showLoading() {

                $membersList.html(`

            <div class="project-members-loading">

                <span
                    class="spinner-border spinner-border-sm"
                    aria-hidden="true">
                </span>

                <span>
                    Loading latest members...
                </span>

            </div>

        `);

            }


            /* =========================================================
               ERROR STATE
            ========================================================= */

            function showError(message) {

                $membersList.html(`

            <div
                class="
                    project-members-empty
                    project-members-error
                ">

                <div
                    class="project-members-empty-icon">

                    <i
                        class="fas fa-triangle-exclamation">
                    </i>

                </div>


                <h5>
                    Could not load members
                </h5>


                <p>
                    ${escapeHtml(message)}
                </p>


                <button
                    type="button"
                    class="btn btn-outline-primary btn-sm"
                    id="retryProjectMembers">

                    <i
                        class="fas fa-rotate-right me-1">
                    </i>

                    Try Again

                </button>

            </div>

        `);

            }


            /* =========================================================
               RENDER MEMBERS
            ========================================================= */

            function renderMembers(
                members
            ) {

                if (
                    !Array.isArray(members) ||
                    members.length === 0
                ) {

                    $membersList.html(`

                <div class="project-members-empty">

                    <div
                        class="project-members-empty-icon">

                        <i
                            class="fas fa-user-slash">
                        </i>

                    </div>


                    <h5>
                        No employees assigned
                    </h5>


                    <p>
                        Add an employee to start collaborating.
                    </p>

                </div>

            `);

                    return;
                }


                const html =
                    members
                        .map(function (member) {


                            const fullName =
                                String(
                                    member.full_name || "Unknown User"
                                ).trim();


                            const email =
                                String(
                                    member.email || "No email"
                                ).trim();


                            const roleName =
                                String(
                                    member.role_name || "User"
                                ).trim();


                            const initials =
                                fullName
                                    .split(/\s+/)
                                    .slice(0, 2)
                                    .map(
                                        name =>
                                            name.charAt(0)
                                    )
                                    .join("")
                                    .toUpperCase();


                            let avatar;


                            if (member.profile_image) {

                                avatar = `

                            <img
                                src="${escapeHtml(
                                    member.profile_image
                                )}"

                                alt="${escapeHtml(
                                    fullName
                                )}"

                                class="project-member-avatar">

                        `;

                            } else {

                                avatar = `

                            <div
                                class="
                                    project-member-avatar
                                    project-member-avatar-placeholder
                                ">

                                ${escapeHtml(
                                    initials
                                )}

                            </div>

                        `;

                            }


                            let removeButton = "";


                            /*
                             * Only manager gets Remove.
                             * Backend remains the authority.
                             */

                            if (
                                role === "manager"
                            ) {

                                removeButton = `

                            <button
                                type="button"

                                class="
                                    btn
                                    btn-outline-danger
                                    btn-sm
                                    project-remove-member-btn
                                "

                                data-user-id="${escapeHtml(
                                    member.user_id
                                )}"

                                data-user-name="${escapeHtml(
                                    fullName
                                )}">

                                <i
                                    class="fas fa-user-minus me-1">
                                </i>

                                Remove

                            </button>

                        `;

                            }


                            return `

                        <div
                            class="project-member-row"
                            data-user-id="${escapeHtml(
                                member.user_id
                            )}">


                            <div
                                class="project-member-identity">

                                ${avatar}


                                <div
                                    class="project-member-details">

                                    <strong>
                                        ${escapeHtml(
                                fullName
                            )}
                                    </strong>


                                    <span>
                                        ${escapeHtml(
                                email
                            )}
                                    </span>

                                </div>

                            </div>


                            <div
                                class="project-member-actions">


                                <span
                                    class="project-member-role">

                                    <i
                                        class="fas fa-user me-1">
                                    </i>

                                    ${escapeHtml(
                                roleName
                            )}

                                </span>


                                ${removeButton}

                            </div>

                        </div>

                    `;

                        })
                        .join("");


                $membersList.html(
                    html
                );

            }


            /* =========================================================
               RENDER AVAILABLE EMPLOYEES
            ========================================================= */

            function renderAvailableEmployees(
                employees
            ) {

                if (!$employeeSelect.length) {
                    return;
                }


                $employeeSelect.empty();


                $employeeSelect.append(
                    $("<option>", {
                        value: "",
                        text: "Select an employee"
                    })
                );


                if (
                    !Array.isArray(employees) ||
                    employees.length === 0
                ) {

                    $employeeSelect.append(
                        $("<option>", {

                            value: "",

                            text:
                                "No employees available",

                            disabled:
                                true

                        })
                    );

                    return;
                }


                $.each(
                    employees,
                    function (
                        index,
                        employee
                    ) {

                        $employeeSelect.append(
                            $("<option>", {

                                value:
                                    employee.user_id,

                                text:
                                    `${String(
                                        employee.full_name || ""
                                    ).trim()} — ${String(
                                        employee.email || ""
                                    ).trim()}`
                            })
                        );

                    }
                );

            }


            /* =========================================================
               LOAD MEMBERS
            ========================================================= */

            function loadMembers() {

                clearMessage();

                showLoading();


                $.ajax({

                    url:
                        membersUrl,

                    type:
                        "GET",

                    dataType:
                        "json",

                    cache:
                        false,

                    headers: {

                        "Accept":
                            "application/json",

                        "X-Requested-With":
                            "XMLHttpRequest"

                    },


                    success: function (
                        response
                    ) {


                        if (
                            !response ||
                            response.success !== true
                        ) {

                            showError(
                                response &&
                                    response.message
                                    ? response.message
                                    : "Unable to load project members."
                            );

                            return;
                        }


                        renderMembers(
                            response.members
                        );


                        /*
                         * The backend returns this only for managers.
                         */
                        renderAvailableEmployees(
                            response.availableEmployees || []
                        );

                    },


                    error: function (
                        xhr
                    ) {

                        console.error(
                            "Project members AJAX error:",
                            xhr
                        );


                        showError(
                            getErrorMessage(
                                xhr,
                                "Unable to load project members."
                            )
                        );

                    }

                });

            }


            /* =========================================================
               VALIDATE ADD MEMBER
            ========================================================= */

            function validateAddMember() {

                if (!$employeeSelect.length) {
                    return false;
                }


                $employeeSelect.removeClass(
                    "is-invalid"
                );


                if (!$employeeSelect.val()) {

                    $employeeSelect.addClass(
                        "is-invalid"
                    );


                    $("#projectMemberUserIdError")
                        .text(
                            "Please select an employee."
                        );


                    $employeeSelect.focus();


                    return false;
                }


                return true;

            }


            /* =========================================================
               REMOVE SELECT ERROR WHEN CHANGED
            ========================================================= */

            $employeeSelect.on(
                "change",
                function () {

                    if ($(this).val()) {

                        $(this).removeClass(
                            "is-invalid"
                        );

                        $("#projectMemberUserIdError")
                            .text("");

                    }

                }
            );


            /* =========================================================
               ADD MEMBER
            ========================================================= */

            $addForm.on(
                "submit",
                function (event) {

                    event.preventDefault();


                    if (
                        !validateAddMember()
                    ) {

                        return;

                    }


                    clearMessage();


                    const originalHtml =
                        $addButton.html();


                    $addButton
                        .prop(
                            "disabled",
                            true
                        )
                        .html(`

                    <span
                        class="
                            spinner-border
                            spinner-border-sm
                            me-2
                        "
                        aria-hidden="true">
                    </span>

                    Adding...

                `);


                    $.ajax({

                        url:
                            addUrl,

                        type:
                            "POST",

                        data:
                            $addForm.serialize(),

                        dataType:
                            "json",

                        headers: {

                            "Accept":
                                "application/json",

                            "X-Requested-With":
                                "XMLHttpRequest"

                        },


                        success: function (
                            response
                        ) {


                            if (
                                !response ||
                                response.success !== true
                            ) {

                                showMessage(

                                    response &&
                                        response.message
                                        ? response.message
                                        : "Unable to add employee.",

                                    "danger"

                                );

                                return;
                            }


                            /*
                             * Clear form after successful add.
                             */
                            $addForm[0].reset();


                            $employeeSelect
                                .removeClass(
                                    "is-invalid"
                                );


                            $("#projectMemberUserIdError")
                                .text("");


                            showMessage(

                                response.message ||
                                "Employee added successfully.",

                                "success"

                            );


                            /*
                             * IMPORTANT:
                             *
                             * Don't manually append the employee.
                             *
                             * Get the newest database state.
                             */
                            loadMembers();

                        },


                        error: function (
                            xhr
                        ) {

                            console.error(
                                "Add member AJAX error:",
                                xhr
                            );


                            showMessage(

                                getErrorMessage(
                                    xhr,
                                    "Unable to add employee."
                                ),

                                "danger"

                            );

                        },


                        complete: function () {

                            $addButton
                                .prop(
                                    "disabled",
                                    false
                                )
                                .html(
                                    originalHtml
                                );

                        }

                    });

                }
            );


            /* =========================================================
               REMOVE MEMBER
            ========================================================= */

            $(document).on(
                "click",
                ".project-remove-member-btn",
                function () {


                    const $button =
                        $(this);


                    const userId =
                        $button.attr(
                            "data-user-id"
                        );


                    const userName =
                        $button.attr(
                            "data-user-name"
                        ) ||
                        "this employee";


                    if (!userId) {

                        showMessage(
                            "Invalid employee.",
                            "danger"
                        );

                        return;
                    }


                    if (
                        !window.confirm(
                            `Remove ${userName} from this project?`
                        )
                    ) {

                        return;

                    }


                    clearMessage();


                    const originalHtml =
                        $button.html();


                    $button
                        .prop(
                            "disabled",
                            true
                        )
                        .html(`

                    <span
                        class="
                            spinner-border
                            spinner-border-sm
                            me-1
                        "
                        aria-hidden="true">
                    </span>

                    Removing...

                `);


                    const removeUrl =
                        `${removeBaseUrl}/${encodeURIComponent(
                            userId
                        )}`;


                    $.ajax({

                        url:
                            removeUrl,

                        type:
                            "DELETE",

                        dataType:
                            "json",

                        headers: {

                            "Accept":
                                "application/json",

                            "X-Requested-With":
                                "XMLHttpRequest"

                        },


                        success: function (
                            response
                        ) {


                            if (
                                !response ||
                                response.success !== true
                            ) {

                                showMessage(

                                    response &&
                                        response.message
                                        ? response.message
                                        : "Unable to remove employee.",

                                    "danger"

                                );


                                $button
                                    .prop(
                                        "disabled",
                                        false
                                    )
                                    .html(
                                        originalHtml
                                    );


                                return;
                            }


                            showMessage(

                                response.message ||
                                "Employee removed successfully.",

                                "success"

                            );


                            /*
                             * Reload from DB.
                             *
                             * This updates:
                             * - Current Members
                             * - Available Employees
                             */
                            loadMembers();

                        },


                        error: function (
                            xhr
                        ) {

                            console.error(
                                "Remove member AJAX error:",
                                xhr
                            );


                            showMessage(

                                getErrorMessage(
                                    xhr,
                                    "Unable to remove employee."
                                ),

                                "danger"

                            );


                            $button
                                .prop(
                                    "disabled",
                                    false
                                )
                                .html(
                                    originalHtml
                                );

                        }

                    });

                }
            );


            /* =========================================================
               RETRY
            ========================================================= */

            $(document).on(
                "click",
                "#retryProjectMembers",
                function () {

                    loadMembers();

                }
            );


            /* =========================================================
               INITIAL LOAD
            ========================================================= */

            loadMembers();

        });
    </script>


    <%- include("layout/footer") %>