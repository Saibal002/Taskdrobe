<%- include("layout/header", { title: project.project_name }) %>

    <div class="container mt-5">

        <div class="project-page-shell">

            <!-- ========================= -->
            <!-- Project Overview -->
            <!-- ========================= -->

            <section class="project-overview-card">

                <div class="project-overview-top">

                    <div class="project-overview-heading">

                        <a
                            href="/dashboard"
                            class="project-back-link">

                            <i class="fas fa-arrow-left"></i>

                            <span>Back to Dashboard</span>

                        </a>

                        <div class="project-title-row">

                            <div class="project-title-icon">
                                <i class="fas fa-folder-open"></i>
                            </div>

                            <div>

                                <div class="project-eyebrow">
                                    Project Overview
                                </div>

                                <h1 class="project-page-title">
                                    <%= project.project_name %>
                                </h1>

                            </div>

                        </div>

                        <p class="project-page-description">
                            <%= project.description || "No description has been added for this project yet." %>
                        </p>

                    </div>

                    <div class="project-status-panel">

                        <span class="project-status-label">
                            Current Status
                        </span>

                        <span class="project-status-badge
                            <%= project.status === 'Completed'
                                ? 'project-status-completed'
                                : project.status === 'In Progress'
                                ? 'project-status-progress'
                                : project.status === 'Cancelled'
                                ? 'project-status-cancelled'
                                : 'project-status-default' %>">

                            <span class="project-status-dot"></span>

                            <%= project.status %>

                        </span>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- Project KPI Cards -->
                <!-- ========================= -->

                <div class="project-kpi-grid">

                    <div class="project-kpi-card project-kpi-progress">

                        <div class="project-kpi-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>

                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Progress
                            </span>

                            <strong class="project-kpi-value">
                                <%= Number(project.progress || 0) %>%
                            </strong>

                        </div>

                    </div>


                    <div class="project-kpi-card project-kpi-status">

                        <div class="project-kpi-icon">
                            <i class="fas fa-layer-group"></i>
                        </div>

                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Status
                            </span>

                            <strong class="project-kpi-value project-kpi-value-small">
                                <%= project.status %>
                            </strong>

                        </div>

                    </div>


                    <div class="project-kpi-card project-kpi-deadline">

                        <div class="project-kpi-icon">
                            <i class="fas fa-calendar-days"></i>
                        </div>

                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Deadline
                            </span>

                            <strong class="project-kpi-value project-kpi-value-small">

                                <%= project.deadline
                                    ? new Date(project.deadline).toLocaleDateString()
                                    : "Not Set" %>

                            </strong>

                        </div>

                    </div>


                    <div class="project-kpi-card project-kpi-owner">

                        <div class="project-kpi-icon">
                            <i class="fas fa-user-tie"></i>
                        </div>

                        <div class="project-kpi-content">

                            <span class="project-kpi-label">
                                Created By
                            </span>

                            <strong class="project-kpi-value project-kpi-value-small">
                                <%= project.full_name %>
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- Progress -->
                <!-- ========================= -->

                <div class="project-progress-section">

                    <div class="project-progress-header">

                        <div>

                            <span class="project-progress-label">
                                Project Progress
                            </span>

                            <span class="project-progress-caption">
                                Overall completion
                            </span>

                        </div>

                        <strong>
                            <%= Number(project.progress || 0) %>%
                        </strong>

                    </div>

                    <div
                        class="project-progress-track"
                        role="progressbar"
                        aria-valuenow="<%= Number(project.progress || 0) %>"
                        aria-valuemin="0"
                        aria-valuemax="100">

                        <div
                            class="project-progress-fill"
                            style="width: <%= Math.min(100, Math.max(0, Number(project.progress || 0))) %>%;">
                        </div>

                    </div>

                </div>

            </section>


            <!-- ========================= -->
            <!-- Tasks -->
            <!-- ========================= -->

                <hr>

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3 class="mb-0">
                        Tasks
                    </h3>

                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTaskModal">

                        <i class="fas fa-plus me-2"></i>

                        Add Task

                    </button>

                </div>

                <% if(tasks.length===0){ %>

                    <div class="card shadow-sm">

                        <div class="card-body text-center text-muted py-5">

                            No tasks available.

                        </div>

                    </div>

                    <% } else { %>

                        <div class="row g-3">

                            <% tasks.forEach(task=> { %>

                                <% const isManager=user.role_name==="manager" ; const
                                    isTaskCreator=String(task.created_by)===String(user.user_id); const
                                    isTaskAssignee=task.assigned_to && String(task.assigned_to)===String(user.user_id);
                                    const canEdit=isManager || isTaskCreator; const canDelete=isManager ||
                                    isTaskCreator; const canChangeStatus=isManager || isTaskCreator || isTaskAssignee;
                                    %>


                                    <div class="col-md-6">

                                        <div class="card border-0 shadow-sm h-100">

                                            <div class="card-body">

                                                <!-- ========================= -->
                                                <!-- Task Header -->
                                                <!-- ========================= -->

                                                <div class="d-flex justify-content-between">

                                                    <div>

                                                        <h5 class="fw-bold mb-1">
                                                            <%= task.title %>
                                                        </h5>

                                                        <p class="text-muted mb-3">
                                                            <%= task.description || "No description" %>
                                                        </p>

                                                    </div>


                                                    <!-- Status Toggle -->

                                                    <% if (canChangeStatus) { %>

                                                        <div>

                                                            <form action="/tasks/<%= task.task_id %>/toggle"
                                                                method="POST">

                                                                <button type="submit" class="btn btn-sm
                                    <%= task.status === 'Completed'
                                        ? 'btn-success'
                                        : 'btn-outline-success' %>">

                                                                    <%= task.status==="Completed" ? "✔" : "○" %>

                                                                </button>

                                                            </form>

                                                        </div>

                                                        <% } %>

                                                </div>


                                                <!-- ========================= -->
                                                <!-- Priority + Status -->
                                                <!-- ========================= -->

                                                <div class="mb-3">

                                                    <span class="badge
                        <%= task.priority === 'Critical'
                            ? 'bg-danger'
                            : task.priority === 'High'
                            ? 'bg-warning text-dark'
                            : task.priority === 'Medium'
                            ? 'bg-primary'
                            : 'bg-secondary' %>">

                                                        <%= task.priority %>

                                                    </span>


                                                    <span class="badge bg-dark">

                                                        <%= task.status %>

                                                    </span>

                                                </div>


                                                <!-- ========================= -->
                                                <!-- Due Date -->
                                                <!-- ========================= -->

                                                <small class="text-muted d-block mb-2">

                                                    <i class="fas fa-calendar me-2"></i>

                                                    <%= task.due_date ? new Date(task.due_date) .toLocaleDateString()
                                                        : "No Due Date" %>

                                                </small>


                                                <!-- ========================= -->
                                                <!-- Assignment -->
                                                <!-- ========================= -->

                                                <small class="text-muted d-block mb-3">

                                                    <i class="fas fa-user me-2"></i>

                                                    <% if (task.assigned_user) { %>

                                                        Assigned to:
                                                        <strong>
                                                            <%= task.assigned_user %>
                                                        </strong>

                                                        <% } else { %>

                                                            <span class="text-muted">
                                                                Unassigned
                                                            </span>

                                                            <% } %>

                                                </small>


                                                <!-- ========================= -->
                                                <!-- Actions -->
                                                <!-- ========================= -->

                                                <div class="d-flex justify-content-end gap-2">


                                                    <!-- Manager Assignment -->

                                                    <% if (isManager) { %>

                                                        <button type="button" class="btn btn-primary btn-sm"
                                                            data-bs-toggle="modal" data-bs-target="#assignTaskModal"
                                                            data-task-id="<%= task.task_id %>"
                                                            data-assigned-to="<%= task.assigned_to || '' %>">

                                                            <i class="fas fa-user-plus"></i>

                                                        </button>

                                                        <% } %>


                                                            <!-- Edit -->

                                                            <% if (canEdit) { %>

                                                                <button type="button"
                                                                    class="btn btn-warning btn-sm editTaskBtn"
                                                                    data-id="<%= task.task_id %>"
                                                                    data-title="<%= task.title %>"
                                                                    data-description="<%= task.description || '' %>"
                                                                    data-priority="<%= task.priority %>"
                                                                    data-status="<%= task.status %>" data-due-date="<%= task.due_date
                                ? new Date(task.due_date)
                                    .toISOString()
                                    .split('T')[0]
                                : '' %>" data-bs-toggle="modal" data-bs-target="#editTaskModal">

                                                                    <i class="fas fa-pencil"></i>

                                                                </button>

                                                                <% } %>


                                                                    <!-- Delete -->

                                                                    <% if (canDelete) { %>

                                                                        <form action="/tasks/<%= task.task_id %>/delete"
                                                                            method="POST"
                                                                            onsubmit="return confirm('Delete this task?')">

                                                                            <button type="submit"
                                                                                class="btn btn-danger btn-sm">

                                                                                <i class="fas fa-trash"></i>

                                                                            </button>

                                                                        </form>

                                                                        <% } %>


                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                    <% }) %>

                        </div>


                        <% } %>






            </div>

        </div>

    </div>
    <%- include("layout/addTaskModal") %>

        <%- include("layout/editTaskModal") %>

            <%- include("layout/assignTaskModal") %>

          <script>

    // =========================
    // Edit Task Modal
    // =========================

    document
        .querySelectorAll(".editTaskBtn")
        .forEach(button => {

            button.addEventListener("click", function () {

                document.getElementById("editTitle").value =
                    this.dataset.title;

                document.getElementById("editDescription").value =
                    this.dataset.description;

                document.getElementById("editPriority").value =
                    this.dataset.priority;

                document.getElementById("editStatus").value =
                    this.dataset.status;

                document.getElementById("editDueDate").value =
                    this.dataset.dueDate;

                document.getElementById("editTaskForm").action =
                    `/tasks/${this.dataset.id}/update`;

            });

        });


    // =========================
    // Assign / Reassign Task
    // =========================

    const assignTaskModal =
        document.getElementById("assignTaskModal");

    if (assignTaskModal) {

        assignTaskModal.addEventListener(
            "shown.bs.modal",
            function (event) {

                const button = event.relatedTarget;

                if (!button) {
                    return;
                }

                const taskId =
                    button.getAttribute("data-task-id");

                const assignedTo =
                    button.getAttribute("data-assigned-to") || "";

                const form =
                    assignTaskModal.querySelector(
                        "#assignTaskForm"
                    );

                const select =
                    assignTaskModal.querySelector(
                        "#assignedTo"
                    );

                if (!form || !select) {
                    return;
                }

                // Set the task-specific assignment URL.
                form.action =
                    `/tasks/${taskId}/assign`;

                // Select the current assignee.
                // Empty string means the task is unassigned.
                select.value =
                    String(assignedTo);

                // Explicitly select the matching option.
                const selectedOption =
                    Array.from(select.options).find(
                        option =>
                            String(option.value) ===
                            String(assignedTo)
                    );

                if (selectedOption) {
                    selectedOption.selected = true;
                }

            }
        );

    }

</script>

                <%- include("layout/footer") %>