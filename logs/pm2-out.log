2026-09-26T22:18:47:             CAST((SELECT COUNT(*) FROM messages m 
2026-09-26T22:18:47:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:18:47:              AND m.sender_id = u.user_id 
2026-09-26T22:18:47:              AND m.is_read = FALSE) AS INTEGER) AS unread_count,
2026-09-26T22:18:47:             (SELECT content FROM messages m 
2026-09-26T22:18:47:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:18:47:              ORDER BY created_at DESC LIMIT 1) as last_msg_content,
2026-09-26T22:18:47:             (SELECT sender_id FROM messages m 
2026-09-26T22:18:47:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:18:47:              ORDER BY created_at DESC LIMIT 1) as last_msg_sender_id,
2026-09-26T22:18:47:             (SELECT is_read FROM messages m 
2026-09-26T22:18:47:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:18:47:              ORDER BY created_at DESC LIMIT 1) as last_msg_is_read
2026-09-26T22:18:47:         FROM users u
