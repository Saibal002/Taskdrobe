2026-09-26T22:15:29:             CAST((SELECT COUNT(*) FROM messages m 
2026-09-26T22:15:29:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:15:29:              AND m.sender_id = u.user_id 
2026-09-26T22:15:29:              AND m.is_read = FALSE) AS INTEGER) AS unread_count,
2026-09-26T22:15:29:             (SELECT content FROM messages m 
2026-09-26T22:15:29:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:15:29:              ORDER BY created_at DESC LIMIT 1) as last_msg_content,
2026-09-26T22:15:29:             (SELECT sender_id FROM messages m 
2026-09-26T22:15:29:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:15:29:              ORDER BY created_at DESC LIMIT 1) as last_msg_sender_id,
2026-09-26T22:15:29:             (SELECT is_read FROM messages m 
2026-09-26T22:15:29:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:15:29:              ORDER BY created_at DESC LIMIT 1) as last_msg_is_read
2026-09-26T22:15:29:         FROM users u
