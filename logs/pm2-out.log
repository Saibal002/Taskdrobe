2026-09-26T22:15:29:         LEFT JOIN conversations c ON 
2026-09-26T22:15:29:             (c.user1_id = $1 AND c.user2_id = u.user_id) OR 
2026-09-26T22:15:29:             (c.user2_id = $1 AND c.user1_id = u.user_id)
2026-09-26T22:15:29:         WHERE u.user_id != $1
2026-09-26T22:15:29:         ORDER BY c.last_message_at DESC NULLS LAST, u.full_name ASC;
