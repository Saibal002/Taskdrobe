2026-09-26T22:15:22:             CAST((SELECT COUNT(*) FROM messages m 
2026-09-26T22:15:22:              WHERE m.conversation_id = c.conversation_id 
2026-09-26T22:15:22:              AND m.sender_id = u.user_id 
2026-09-26T22:15:22:              AND m.is_read = FALSE) AS INTEGER) AS unread_count,
2026-09-26T22:15:22:             (SELECT content FROM messages m 
